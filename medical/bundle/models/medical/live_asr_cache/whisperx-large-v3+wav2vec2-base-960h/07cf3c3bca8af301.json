nd": 88.971}, {"i": 233, "text": "decent", "start": 89.031, "end": 89.431}, {"i": 234, "text": "from", "start": 89.471, "end": 89.612}, {"i": 235, "text": "what", "start": 89.652, "end": 89.772}, {"i": 236, "text": "I", "start": 89.812, "end": 89.852}, {"i": 237, "text": "have", "start": 89.892, "end": 90.012}, {"i": 238, "text": "seen.", "start": 90.052, "end": 90.312}, {"i": 239, "text": "That", "start": 91.253, "end": 91.433}, {"i": 240, "text": "is", "start": 91.473, "end": 91.533}, {"i": 241, "text": "something.", "start": 91.594, "end": 92.034}, {"i": 242, "text": "Thanks", "start": 92.935, "end": 93.155}, {"i": 243, "text": "for", "start": 93.195, "end": 93.315}, {"i": 244, "text": "explaining", "start": 93.355, "end": 93.816}, {"i": 245, "text": "it", "start": 93.856, "end": 93.916}, {"i": 246, "text": "all", "start": 93.956, "end": 94.056}, {"i": 247, "text": "so", "start": 94.116, "end": 94.256}, {"i": 248, "text": "clearly.", "start": 94.316, "end": 94.737}, {"i": 249, "text": "You", "start": 95.738, "end": 95.838}, {"i": 250, "text": "are", "start": 95.878, "end": 95.978}, {"i": 251, "text": "welcome,", "start": 95.998, "end": 96.378}, {"i": 252, "text": "Trini.", "start": 96.438, "end": 96.779}, {"i": 253, "text": "Take", "start": 97.199, "end": 97.379}, {"i": 254, "text": "care", "start": 97.419, "end": 97.599}, {"i": 255, "text": "of", "start": 97.639, "end": 97.679}, {"i": 256, "text": "that", "start": 97.739, "end": 97.88}, {"i": 257, "text": "throat.", "start": 97.94, "end": 98.26}], "segments": [{"start": 0.034, "end": 0.755, "text": "Hello, Trini."}, {"start": 0.995, "end": 1.595, "text": "Good to see you."}, {"start": 1.996, "end": 2.476, "text": "Have a seat."}, {"start": 3.777, "end": 4.137, "text": "Thanks."}, {"start": 4.978, "end": 6.339, "text": "My throat has been really sore."}, {"start": 7.1, "end": 7.74, "text": "A sore throat."}, {"start": 8.361, "end": 9.362, "text": "Let us take it in order."}, {"start": 9.782, "end": 11.684, "text": "First, I did a test on your throat."}, {"start": 12.464, "end": 12.985, "text": "A test?"}, {"start": 13.805, "end": 15.026, "text": "What sort of test is that?"}, {"start": 15.747, "end": 16.548, "text": "A strep test."}, {"start": 17.188, "end": 20.711, "text": "It looks for one particular bacterium that can cause a sore throat."}, {"start": 21.632, "end": 22.512, "text": "And what did it say?"}, {"start": 23.233, "end": 23.954, "text": "It was negative."}, {"start": 24.434, "end": 26.696, "text": "That means that bacterium was not found."}, {"start": 27.597, "end": 29.118, "text": "So negative is the good one here?"}, {"start": 29.874, "end": 31.015, "text": "In this case, yes."}, {"start": 31.855, "end": 34.376, "text": "I also looked at your throat and there was no pus."}, {"start": 35.437, "end": 36.137, "text": "No pus."}, {"start": 37.078, "end": 38.839, "text": "That is the yellow stuff you sometimes get?"}, {"start": 39.459, "end": 40.02, "text": "That is right."}, {"start": 40.28, "end": 41.04, "text": "There was none of it."}, {"start": 42.001, "end": 43.581, "text": "So what is making it hurt then?"}, {"start": 44.302, "end": 46.903, "text": "My assessment is that this is a viral infection."}, {"start": 47.764, "end": 48.364, "text": "A virus."}, {"start": 49.205, "end": 50.245, "text": "Not bacteria then."}, {"start": 51.226, "end": 51.726, "text": "Exactly."}, {"start": 52.246, "end": 53.907, "text": "Does that difference make sense to you?"}, {"start": 54.788, "end": 55.388, "text": "I think so."}, {"start": 56.188, "end": 58.189, "text": "So do I need antibiotics for it?"}, {"start": 58.89, "end": 59.09, "text": "No."}, {"start": 59.606, "end": 63.947, "text": "The plan is no antibiotics, because they do not work against a virus."}, {"start": 64.948, "end": 65.368, "text": "All right."}, {"start": 66.008, "end": 67.348, "text": "So what do I do instead?"}, {"start": 68.108, "end": 71.73, "text": "We treat the symptoms, so we ease the discomfort while it passes."}, {"start": 72.65, "end": 74.41, "text": "Just making it feel better, basically."}, {"start": 75.271, "end": 76.891, "text": "Yes, that is a good way to put it."}, {"start": 78.011, "end": 80.712, "text": "The roadworks nearly made me late getting here, by the way."}, {"start": 81.452, "end": 83.393, "text": "They have caught a lot of people out this week."}, {"start": 84.293, "end": 84.853, "text": "They have."}, {"start": 85.674, "end": 87.134, "text": "Is the weekend meant to be any good?"}, {"start": 88.01, "end": 90.312, "text": "The forecast looks decent from what I have seen."}, {"start": 91.253, "end": 92.034, "text": "That is something."}, {"start": 92.935, "end": 94.737, "text": "Thanks for explaining it all so clearly."}, {"start": 95.738, "end": 96.779, "text": "You are welcome, Trini."}, {"start": 97.199, "end": 98.26, "text": "Take care of that throat."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.922}}