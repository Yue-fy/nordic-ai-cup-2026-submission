": 92.946}, {"i": 198, "text": "of", "start": 92.966, "end": 93.026}, {"i": 199, "text": "errands,", "start": 93.126, "end": 93.466}, {"i": 200, "text": "then", "start": 93.627, "end": 93.827}, {"i": 201, "text": "some", "start": 93.867, "end": 94.047}, {"i": 202, "text": "reading", "start": 94.087, "end": 94.388}, {"i": 203, "text": "at", "start": 94.448, "end": 94.508}, {"i": 204, "text": "home.", "start": 94.568, "end": 94.829}, {"i": 205, "text": "Sounds", "start": 95.851, "end": 96.151}, {"i": 206, "text": "calm.", "start": 96.231, "end": 96.612}, {"i": 207, "text": "Take", "start": 97.513, "end": 97.714}, {"i": 208, "text": "care,", "start": 97.754, "end": 97.994}, {"i": 209, "text": "Rasmus.", "start": 98.034, "end": 98.535}, {"i": 210, "text": "Thanks,", "start": 99.477, "end": 99.757}, {"i": 211, "text": "Dr.", "start": 99.817, "end": 100.098}, {"i": 212, "text": "Norgard.", "start": 100.138, "end": 100.699}, {"i": 213, "text": "Goodbye.", "start": 100.819, "end": 101.28}], "segments": [{"start": 0.202, "end": 1.523, "text": "Morning, Dr. Norgaard."}, {"start": 1.683, "end": 2.663, "text": "Good to see you again."}, {"start": 3.364, "end": 4.284, "text": "Morning, Rasmus."}, {"start": 4.645, "end": 5.045, "text": "Come in."}, {"start": 5.585, "end": 6.666, "text": "What brings you today?"}, {"start": 7.446, "end": 9.347, "text": "I found a tick attached to my leg."}, {"start": 9.768, "end": 12.229, "text": "I removed it, and I wanted the bite looked at."}, {"start": 13.029, "end": 13.33, "text": "Right."}, {"start": 13.95, "end": 14.55, "text": "A tick bite."}, {"start": 15.491, "end": 16.952, "text": "Any redness around the site?"}, {"start": 17.732, "end": 18.933, "text": "No redness at all."}, {"start": 19.793, "end": 20.494, "text": "Any swelling?"}, {"start": 21.334, "end": 22.255, "text": "No swelling either."}, {"start": 22.635, "end": 24.576, "text": "The area looks unchanged to me."}, {"start": 25.437, "end": 26.497, "text": "Let me have a look at it."}, {"start": 27.278, "end": 27.818, "text": "Of course."}, {"start": 29.034, "end": 30.235, "text": "The skin is intact."}, {"start": 30.815, "end": 32.796, "text": "There is no erythema migrans."}, {"start": 33.917, "end": 36.818, "text": "So no expanding ring-shaped rash around the bite?"}, {"start": 37.519, "end": 37.959, "text": "Correct."}, {"start": 38.519, "end": 39.96, "text": "No erythema migrans."}, {"start": 40.901, "end": 42.942, "text": "And how do you rate the risk of Borrelia?"}, {"start": 43.802, "end": 44.102, "text": "Low."}, {"start": 44.943, "end": 46.884, "text": "The risk of Borrelia here is low."}, {"start": 47.884, "end": 49.105, "text": "What are you basing that on?"}, {"start": 50.126, "end": 51.046, "text": "Intact skin."}, {"start": 51.687, "end": 52.367, "text": "No redness."}, {"start": 52.847, "end": 53.528, "text": "No swelling."}, {"start": 54.048, "end": 55.469, "text": "And no rash at the site."}, {"start": 56.549, "end": 57.57, "text": "Then what is the plan?"}, {"start": 58.726, "end": 59.447, "text": "Observation."}, {"start": 60.207, "end": 61.408, "text": "No treatment is needed."}, {"start": 62.449, "end": 64.15, "text": "So no antibiotics today?"}, {"start": 65.09, "end": 65.331, "text": "No."}, {"start": 65.991, "end": 68.573, "text": "This is an insect bite without complication."}, {"start": 69.574, "end": 70.174, "text": "Understood."}, {"start": 71.215, "end": 74.057, "text": "The mornings have turned properly autumnal, haven't they?"}, {"start": 74.977, "end": 75.458, "text": "They have."}, {"start": 76.158, "end": 78.199, "text": "The light goes quickly at this time of year."}, {"start": 78.219, "end": 81.462, "text": "I have already dug out the winter jacket."}, {"start": 82.402, "end": 82.903, "text": "Sensible."}, {"start": 83.903, "end": 85.344, "text": "Anything else on your mind today?"}, {"start": 86.245, "end": 87.666, "text": "No, that was the only thing."}, {"start": 88.578, "end": 88.879, "text": "Good."}, {"start": 89.72, "end": 91.463, "text": "Big plans for the rest of the day?"}, {"start": 92.365, "end": 94.829, "text": "Just a couple of errands, then some reading at home."}, {"start": 95.851, "end": 96.612, "text": "Sounds calm."}, {"start": 97.513, "end": 98.535, "text": "Take care, Rasmus."}, {"start": 99.477, "end": 100.699, "text": "Thanks, Dr. Norgard."}, {"start": 100.819, "end": 101.28, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.849}}