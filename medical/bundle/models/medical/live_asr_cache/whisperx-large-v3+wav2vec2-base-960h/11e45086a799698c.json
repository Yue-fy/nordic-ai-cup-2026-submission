, "start": 137.515, "end": 138.015}, {"i": 362, "text": "Understood.", "start": 139.016, "end": 139.416}, {"i": 363, "text": "And", "start": 140.076, "end": 140.156}, {"i": 364, "text": "that", "start": 140.176, "end": 140.296}, {"i": 365, "text": "is", "start": 140.316, "end": 140.396}, {"i": 366, "text": "everything", "start": 140.456, "end": 140.797}, {"i": 367, "text": "for", "start": 140.817, "end": 140.937}, {"i": 368, "text": "today?", "start": 140.957, "end": 141.237}, {"i": 369, "text": "What", "start": 142.017, "end": 142.157}, {"i": 370, "text": "I", "start": 142.197, "end": 142.257}, {"i": 371, "text": "have", "start": 142.297, "end": 142.457}, {"i": 372, "text": "for", "start": 142.497, "end": 142.597}, {"i": 373, "text": "you", "start": 142.617, "end": 142.737}, {"i": 374, "text": "today", "start": 142.777, "end": 143.118}, {"i": 375, "text": "is", "start": 143.258, "end": 143.338}, {"i": 376, "text": "the", "start": 143.398, "end": 143.498}, {"i": 377, "text": "blood", "start": 143.538, "end": 143.798}, {"i": 378, "text": "pressure.", "start": 143.858, "end": 144.218}, {"i": 379, "text": "The", "start": 144.606, "end": 144.706}, {"i": 380, "text": "body", "start": 144.746, "end": 145.026}, {"i": 381, "text": "mass", "start": 145.066, "end": 145.307}, {"i": 382, "text": "index", "start": 145.367, "end": 145.787}, {"i": 383, "text": "and", "start": 146.147, "end": 146.307}, {"i": 384, "text": "the", "start": 146.327, "end": 146.507}, {"i": 385, "text": "advice.", "start": 146.567, "end": 147.008}, {"i": 386, "text": "Right.", "start": 147.868, "end": 148.129}, {"i": 387, "text": "Well,", "start": 148.409, "end": 148.629}, {"i": 388, "text": "that", "start": 148.929, "end": 149.089}, {"i": 389, "text": "is", "start": 149.129, "end": 149.209}, {"i": 390, "text": "manageable", "start": 149.249, "end": 149.71}, {"i": 391, "text": "enough.", "start": 149.77, "end": 150.01}, {"i": 392, "text": "What", "start": 150.871, "end": 151.031}, {"i": 393, "text": "are", "start": 151.051, "end": 151.131}, {"i": 394, "text": "your", "start": 151.151, "end": 151.271}, {"i": 395, "text": "plans", "start": 151.331, "end": 151.711}, {"i": 396, "text": "for", "start": 151.771, "end": 151.851}, {"i": 397, "text": "the", "start": 151.891, "end": 151.951}, {"i": 398, "text": "rest", "start": 151.991, "end": 152.191}, {"i": 399, "text": "of", "start": 152.211, "end": 152.272}, {"i": 400, "text": "the", "start": 152.312, "end": 152.372}, {"i": 401, "text": "day?", "start": 152.412, "end": 152.752}, {"i": 402, "text": "Nothing", "start": 153.532, "end": 153.793}, {"i": 403, "text": "dramatic.", "start": 153.833, "end": 154.313}, {"i": 404, "text": "I", "start": 154.953, "end": 155.013}, {"i": 405, "text": "might", "start": 155.053, "end": 155.234}, {"i": 406, "text": "walk", "start": 155.274, "end": 155.454}, {"i": 407, "text": "home", "start": 155.494, "end": 155.674}, {"i": 408, "text": "the", "start": 155.694, "end": 155.774}, {"i": 409, "text": "long", "start": 155.794, "end": 155.954}, {"i": 410, "text": "way,", "start": 155.994, "end": 156.154}, {"i": 411, "text": "seeing", "start": 156.515, "end": 156.775}, {"i": 412, "text": "as", "start": 156.815, "end": 156.875}, {"i": 413, "text": "we", "start": 156.895, "end": 156.975}, {"i": 414, "text": "have", "start": 156.995, "end": 157.095}, {"i": 415, "text": "been", "start": 157.115, "end": 157.255}, {"i": 416, "text": "talking", "start": 157.275, "end": 157.555}, {"i": 417, "text": "about", "start": 157.575, "end": 157.755}, {"i": 418, "text": "exercise.", "start": 157.815, "end": 158.336}, {"i": 419, "text": "That", "start": 159.136, "end": 159.317}, {"i": 420, "text": "sounds", "start": 159.377, "end": 159.637}, {"i": 421, "text": "like", "start": 159.657, "end": 159.797}, {"i": 422, "text": "a", "start": 159.837, "end": 159.877}, {"i": 423, "text": "good", "start": 159.897, "end": 160.097}, {"i": 424, "text": "start.", "start": 160.157, "end": 160.557}, {"i": 425, "text": "Take", "start": 161.078, "end": 161.298}, {"i": 426, "text": "care,", "start": 161.338, "end": 161.578}, {"i": 427, "text": "Camilla.", "start": 161.618, "end": 162.018}, {"i": 428, "text": "Thank", "start": 162.719, "end": 162.959}, {"i": 429, "text": "you.", "start": 162.999, "end": 163.159}, {"i": 430, "text": "See", "start": 163.419, "end": 163.54}, {"i": 431, "text": "you", "start": 163.56, "end": 163.62}, {"i": 432, "text": "next", "start": 163.66, "end": 163.82}, {"i": 433, "text": "time.", "start": 163.86, "end": 164.06}], "segments": [{"start": 0.118, "end": 1.139, "text": "Good morning, Camilla."}, {"start": 1.619, "end": 2.78, "text": "Come in and sit down."}, {"start": 3.6, "end": 4.04, "text": "Thank you."}, {"start": 4.481, "end": 5.521, "text": "It is nice to be back."}, {"start": 5.881, "end": 9.584, "text": "I always forget how calm it is in here compared with everything going on outside."}, {"start": 10.364, "end": 11.325, "text": "It has its moments."}, {"start": 12.025, "end": 14.286, "text": "This is your preventive health check today."}, {"start": 15.067, "end": 16.007, "text": "Yes, that is right."}, {"start": 16.227, "end": 18.569, "text": "And I have to say, I feel perfectly well."}, {"start": 19.069, "end": 21.811, "text": "No complaints at all, which almost feels like cheating."}, {"start": 22.671, "end": 23.712, "text": "That is worth noting."}, {"start": 24.272, "end": 26.313, "text": "Feeling well is part of the picture."}, {"start": 27.254, "end": 27.474, "text": "Good."}, {"start": 27.934, "end": 31.676, "text": "I did wonder whether coming in when nothing is actually wrong was a waste of your time."}, {"start": 32.556, "end": 33.216, "text": "Not at all."}, {"start": 33.556, "end": 35.697, "text": "That is exactly what these checks are for."}, {"start": 36.598, "end": 37.098, "text": "Fair enough."}, {"start": 37.398, "end": 38.339, "text": "So what did you find?"}, {"start": 39.199, "end": 44.341, "text": "Your blood pressure is 135 over 88."}, {"start": 44.761, "end": 45.962, "text": "135 over 88."}, {"start": 46.522, "end": 49.503, "text": "I will be honest, those figures mean very little to me on their own."}, {"start": 50.524, "end": 52.385, "text": "That is the reading I measured today."}, {"start": 53.265, "end": 53.505, "text": "Right."}, {"start": 53.805, "end": 55.146, "text": "And was there anything else you measured?"}, {"start": 56.266, "end": 58.387, "text": "Your body mass index is 28."}, {"start": 59.528, "end": 61.33, "text": "28, and what does that tell you?"}, {"start": 62.35, "end": 65.072, "text": "It puts you in the mildly overweight range."}, {"start": 66.153, "end": 67.394, "text": "Mildly overweight."}, {"start": 68.514, "end": 69.935, "text": "I suspected as much, honestly."}, {"start": 70.556, "end": 72.337, "text": "Clothes tell you before the scales do."}, {"start": 73.378, "end": 77.08, "text": "That is my assessment, and I would not put it more strongly than that."}, {"start": 78.081, "end": 78.982, "text": "I appreciate that."}, {"start": 79.562, "end": 82.464, "text": "I have had people be far more dramatic about far less."}, {"start": 83.505, "end": 85.106, "text": "There is no need for drama here."}, {"start": 86.206, "end": 87.207, "text": "So what happens next?"}, {"start": 87.567, "end": 88.908, "text": "Is there something I should be doing?"}, {"start": 89.849, "end": 93.251, "text": "The plan is advice on diet and on exercise."}, {"start": 94.272, "end": 95.813, "text": "Diet and exercise."}, {"start": 96.393, "end": 99.696, "text": "The two words everybody expects to hear, and yet here we are."}, {"start": 100.756, "end": 102.197, "text": "They are the plan for today."}, {"start": 102.297, "end": 103.198, "text": "That is fine by me."}, {"start": 103.799, "end": 106.2, "text": "I would far rather have advice than a prescription."}, {"start": 106.821, "end": 107.401, "text": "Understood."}, {"start": 108.022, "end": 109.282, "text": "The seasons are turning already."}, {"start": 109.823, "end": 114.206, "text": "I notice the light is different in the mornings now, and everything smells like the end of summer."}, {"start": 114.846, "end": 116.127, "text": "It does come round quickly."}, {"start": 116.747, "end": 117.107, "text": "It does."}, {"start": 117.907, "end": 121.709, "text": "I always mean to make more of the summer, and then, quite suddenly, it is gone."}, {"start": 122.469, "end": 124.25, "text": "Most of us do exactly the same."}, {"start": 125.33, "end": 126.031, "text": "That is comforting."}, {"start": 126.811, "end": 128.732, "text": "Now, back to my results for a moment."}, {"start": 129.472, "end": 130.012, "text": "Of course."}, {"start": 130.873, "end": 134.674, "text": "The mildly overweight assessment, that was based on the body mass index?"}, {"start": 135.434, "end": 138.015, "text": "Yes, on the body mass index of 28."}, {"start": 139.016, "end": 139.416, "text": "Understood."}, {"start": 140.076, "end": 141.237, "text": "And that is everything for today?"}, {"start": 142.017, "end": 144.218, "text": "What I have for you today is the blood pressure."}, {"start": 144.606, "end": 147.008, "text": "The body mass index and the advice."}, {"start": 147.868, "end": 148.129, "text": "Right."}, {"start": 148.409, "end": 150.01, "text": "Well, that is manageable enough."}, {"start": 150.871, "end": 152.752, "text": "What are your plans for the rest of the day?"}, {"start": 153.532, "end": 154.313, "text": "Nothing dramatic."}, {"start": 154.953, "end": 158.336, "text": "I might walk home the long way, seeing as we have been talking about exercise."}, {"start": 159.136, "end": 160.557, "text": "That sounds like a good start."}, {"start": 161.078, "end": 162.018, "text": "Take care, Camilla."}, {"start": 162.719, "end": 163.159, "text": "Thank you."}, {"start": 163.419, "end": 164.06, "text": "See you next time."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.805}}