 97.791}, {"i": 231, "text": "up", "start": 97.851, "end": 97.931}, {"i": 232, "text": "the", "start": 97.991, "end": 98.091}, {"i": 233, "text": "moment", "start": 98.131, "end": 98.491}, {"i": 234, "text": "term", "start": 98.531, "end": 98.871}, {"i": 235, "text": "ends.", "start": 99.051, "end": 99.331}, {"i": 236, "text": "Then", "start": 100.412, "end": 100.652}, {"i": 237, "text": "I", "start": 100.792, "end": 100.852}, {"i": 238, "text": "will", "start": 100.872, "end": 101.032}, {"i": 239, "text": "let", "start": 101.072, "end": 101.192}, {"i": 240, "text": "you", "start": 101.212, "end": 101.332}, {"i": 241, "text": "get", "start": 101.352, "end": 101.512}, {"i": 242, "text": "on.", "start": 101.612, "end": 101.692}, {"i": 243, "text": "Thank", "start": 102.052, "end": 102.272}, {"i": 244, "text": "you.", "start": 102.312, "end": 102.473}, {"i": 245, "text": "Take", "start": 103.253, "end": 103.473}, {"i": 246, "text": "care,", "start": 103.513, "end": 103.733}, {"i": 247, "text": "Christian.", "start": 103.773, "end": 104.253}, {"i": 248, "text": "Same", "start": 104.813, "end": 105.034}, {"i": 249, "text": "time", "start": 105.074, "end": 105.294}, {"i": 250, "text": "next", "start": 105.354, "end": 105.594}, {"i": 251, "text": "year.", "start": 105.634, "end": 105.854}], "segments": [{"start": 0.062, "end": 1.322, "text": "Morning, Dr Fabricius."}, {"start": 2.143, "end": 3.343, "text": "Christian, come in."}, {"start": 3.763, "end": 4.623, "text": "Good to see you."}, {"start": 5.364, "end": 5.824, "text": "You too."}, {"start": 6.364, "end": 9.505, "text": "I see the magazines in the waiting room have finally been refreshed."}, {"start": 10.865, "end": 14.666, "text": "They had been there so long, I was starting to recognise the covers."}, {"start": 15.426, "end": 17.967, "text": "I read one all the way through, which tells you something."}, {"start": 18.647, "end": 20.868, "text": "It tells me we are running on time for once."}, {"start": 21.788, "end": 24.089, "text": "So, this is your annual follow-up."}, {"start": 25.009, "end": 26.369, "text": "It is, for the asthma."}, {"start": 27.15, "end": 27.95, "text": "Exactly that."}, {"start": 29.078, "end": 32.559, "text": "Let me listen to your chest and your heart, and then we will talk."}, {"start": 33.28, "end": 33.7, "text": "Go ahead."}, {"start": 34.54, "end": 35.801, "text": "Breathe normally for me."}, {"start": 37.982, "end": 38.482, "text": "And again."}, {"start": 38.502, "end": 39.942, "text": "Is it alright?"}, {"start": 40.683, "end": 42.784, "text": "Your chest and heart both sound normal."}, {"start": 43.544, "end": 45.145, "text": "Nothing abnormal to report."}, {"start": 45.925, "end": 46.205, "text": "Good."}, {"start": 46.605, "end": 49.386, "text": "I had half convinced myself something would turn up this year."}, {"start": 50.086, "end": 50.787, "text": "Nothing has."}, {"start": 51.567, "end": 54.508, "text": "This is what a stable annual check looks like."}, {"start": 55.389, "end": 56.969, "text": "So what happens with my treatment?"}, {"start": 57.75, "end": 58.53, "text": "No changes."}, {"start": 59.19, "end": 60.971, "text": "You carry on exactly as you are."}, {"start": 61.911, "end": 62.631, "text": "Nothing at all."}, {"start": 63.091, "end": 65.232, "text": "I suppose I expected some adjustment."}, {"start": 65.992, "end": 67.452, "text": "There is nothing to adjust."}, {"start": 68.233, "end": 72.414, "text": "When the follow-up is clear, leaving things alone is the right call."}, {"start": 73.354, "end": 75.455, "text": "That is reassuring to hear said plainly."}, {"start": 76.335, "end": 77.595, "text": "Then that is the whole of it."}, {"start": 78.476, "end": 79.636, "text": "Asthma follow-up done."}, {"start": 80.316, "end": 81.177, "text": "No changes."}, {"start": 82.297, "end": 83.797, "text": "Shorter than I had booked out for."}, {"start": 84.578, "end": 86.098, "text": "The good ones usually are."}, {"start": 87.066, "end": 89.707, "text": "Everything busier at your end with the school holidays."}, {"start": 90.548, "end": 91.248, "text": "Considerably."}, {"start": 91.508, "end": 94.129, "text": "The roads at eight in the morning are a different world."}, {"start": 94.989, "end": 96.11, "text": "It is the same here."}, {"start": 96.97, "end": 99.331, "text": "The mornings fill up the moment term ends."}, {"start": 100.412, "end": 101.692, "text": "Then I will let you get on."}, {"start": 102.052, "end": 102.473, "text": "Thank you."}, {"start": 103.253, "end": 104.253, "text": "Take care, Christian."}, {"start": 104.813, "end": 105.854, "text": "Same time next year."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.93}}