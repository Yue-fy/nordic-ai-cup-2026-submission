t": "can", "start": 79.996, "end": 80.136}, {"i": 199, "text": "remember.", "start": 80.196, "end": 80.576}, {"i": 200, "text": "Good.", "start": 81.156, "end": 81.396}, {"i": 201, "text": "Anything", "start": 82.217, "end": 82.517}, {"i": 202, "text": "else", "start": 82.557, "end": 82.717}, {"i": 203, "text": "before", "start": 82.777, "end": 83.057}, {"i": 204, "text": "you", "start": 83.097, "end": 83.217}, {"i": 205, "text": "go?", "start": 83.237, "end": 83.457}, {"i": 206, "text": "Only", "start": 84.218, "end": 84.438}, {"i": 207, "text": "that", "start": 84.458, "end": 84.638}, {"i": 208, "text": "whoever", "start": 84.678, "end": 85.038}, {"i": 209, "text": "chose", "start": 85.078, "end": 85.338}, {"i": 210, "text": "the", "start": 85.358, "end": 85.458}, {"i": 211, "text": "picture", "start": 85.498, "end": 85.779}, {"i": 212, "text": "behind", "start": 85.819, "end": 86.119}, {"i": 213, "text": "you", "start": 86.159, "end": 86.259}, {"i": 214, "text": "had", "start": 86.319, "end": 86.439}, {"i": 215, "text": "a", "start": 86.459, "end": 86.499}, {"i": 216, "text": "good", "start": 86.539, "end": 86.699}, {"i": 217, "text": "eye.", "start": 86.839, "end": 86.959}, {"i": 218, "text": "It", "start": 87.519, "end": 87.559}, {"i": 219, "text": "is", "start": 87.599, "end": 87.679}, {"i": 220, "text": "the", "start": 87.719, "end": 87.8}, {"i": 221, "text": "first", "start": 87.82, "end": 88.02}, {"i": 222, "text": "thing", "start": 88.06, "end": 88.2}, {"i": 223, "text": "I", "start": 88.26, "end": 88.32}, {"i": 224, "text": "noticed.", "start": 88.38, "end": 88.72}], "segments": [{"start": 0.054, "end": 0.474, "text": "Come in."}, {"start": 1.074, "end": 2.115, "text": "I am Dr. Cruz."}, {"start": 2.755, "end": 3.835, "text": "We have not met before."}, {"start": 4.515, "end": 5.936, "text": "No, Soren Fabricius."}, {"start": 6.416, "end": 6.956, "text": "Have a seat."}, {"start": 7.716, "end": 8.516, "text": "What brings you in?"}, {"start": 9.096, "end": 9.837, "text": "My sinuses."}, {"start": 10.557, "end": 12.417, "text": "Blocked, aching, the whole business."}, {"start": 13.078, "end": 14.998, "text": "And I have got thrush in my mouth as well."}, {"start": 15.478, "end": 16.338, "text": "Both together."}, {"start": 17.039, "end": 17.359, "text": "Noted."}, {"start": 18.059, "end": 19.219, "text": "I want penicillin for it."}, {"start": 19.759, "end": 20.86, "text": "I know what this is by now."}, {"start": 21.54, "end": 22.98, "text": "Let me listen to you first."}, {"start": 24.741, "end": 26.301, "text": "You do sound congested."}, {"start": 27.001, "end": 28.302, "text": "That is all you are going by?"}, {"start": 28.782, "end": 29.622, "text": "Just how I sound?"}, {"start": 30.354, "end": 32.295, "text": "That and what you have described."}, {"start": 33.096, "end": 35.377, "text": "It points to an acute sinus infection."}, {"start": 36.077, "end": 37.298, "text": "And how certain are you of that?"}, {"start": 37.958, "end": 39.079, "text": "Certain enough to treat it."}, {"start": 39.899, "end": 41.3, "text": "The picture is straightforward."}, {"start": 42.0, "end": 42.481, "text": "Fair enough."}, {"start": 43.141, "end": 43.601, "text": "And the mouth?"}, {"start": 44.242, "end": 46.643, "text": "That is a possible candidiasis."}, {"start": 47.383, "end": 49.124, "text": "Possible, not confirmed."}, {"start": 49.784, "end": 52.806, "text": "Why only possible if you are willing to treat the other one outright?"}, {"start": 53.326, "end": 55.508, "text": "Because that is what the picture supports."}, {"start": 56.348, "end": 58.849, "text": "I will not tell you it is certain when it is not."}, {"start": 59.61, "end": 59.95, "text": "All right."}, {"start": 60.566, "end": 62.447, "text": "I would rather hear that than the other way around."}, {"start": 63.027, "end": 64.828, "text": "For the sinuses, penicillin."}, {"start": 65.488, "end": 69.731, "text": "One million international units, four times daily, for seven days."}, {"start": 70.411, "end": 71.431, "text": "Which is what I asked for."}, {"start": 72.092, "end": 72.432, "text": "It is."}, {"start": 73.372, "end": 77.674, "text": "And fluconazole, 50 milligrams, for seven days, for the mouth."}, {"start": 78.395, "end": 79.155, "text": "Both for a week."}, {"start": 79.635, "end": 80.576, "text": "That I can remember."}, {"start": 81.156, "end": 81.396, "text": "Good."}, {"start": 82.217, "end": 83.457, "text": "Anything else before you go?"}, {"start": 84.218, "end": 86.959, "text": "Only that whoever chose the picture behind you had a good eye."}, {"start": 87.519, "end": 88.72, "text": "It is the first thing I noticed."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.782}}