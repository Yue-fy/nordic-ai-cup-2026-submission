295, "text": "And", "start": 134.629, "end": 134.769}, {"i": 296, "text": "it", "start": 135.01, "end": 135.07}, {"i": 297, "text": "is", "start": 135.15, "end": 135.23}, {"i": 298, "text": "turning", "start": 135.29, "end": 135.61}, {"i": 299, "text": "properly", "start": 135.69, "end": 136.13}, {"i": 300, "text": "into", "start": 136.17, "end": 136.371}, {"i": 301, "text": "autumn", "start": 136.471, "end": 136.711}, {"i": 302, "text": "out", "start": 136.751, "end": 136.891}, {"i": 303, "text": "there.", "start": 136.911, "end": 137.131}, {"i": 304, "text": "It", "start": 138.232, "end": 138.292}, {"i": 305, "text": "is.", "start": 138.512, "end": 138.732}, {"i": 306, "text": "The", "start": 139.413, "end": 139.493}, {"i": 307, "text": "mornings", "start": 139.533, "end": 139.953}, {"i": 308, "text": "are", "start": 140.033, "end": 140.113}, {"i": 309, "text": "much", "start": 140.173, "end": 140.393}, {"i": 310, "text": "darker", "start": 140.553, "end": 140.994}, {"i": 311, "text": "now.", "start": 141.034, "end": 141.294}, {"i": 312, "text": "They", "start": 142.335, "end": 142.475}, {"i": 313, "text": "are.", "start": 142.615, "end": 142.775}, {"i": 314, "text": "Right.", "start": 143.936, "end": 144.176}, {"i": 315, "text": "Is", "start": 144.636, "end": 144.736}, {"i": 316, "text": "there", "start": 144.776, "end": 145.017}, {"i": 317, "text": "anything", "start": 145.117, "end": 145.477}, {"i": 318, "text": "else", "start": 145.597, "end": 145.817}, {"i": 319, "text": "worrying", "start": 145.917, "end": 146.338}, {"i": 320, "text": "you", "start": 146.398, "end": 146.518}, {"i": 321, "text": "today?", "start": 146.578, "end": 146.858}, {"i": 322, "text": "No,", "start": 148.082, "end": 148.323}, {"i": 323, "text": "I", "start": 148.343, "end": 148.363}, {"i": 324, "text": "think", "start": 148.924, "end": 149.124}, {"i": 325, "text": "that", "start": 149.164, "end": 149.325}, {"i": 326, "text": "is", "start": 149.385, "end": 149.465}, {"i": 327, "text": "everything.", "start": 149.525, "end": 149.946}, {"i": 328, "text": "Then", "start": 151.188, "end": 151.369}, {"i": 329, "text": "we", "start": 151.429, "end": 151.529}, {"i": 330, "text": "are", "start": 151.589, "end": 151.669}, {"i": 331, "text": "done.", "start": 151.709, "end": 151.95}, {"i": 332, "text": "Take", "start": 152.731, "end": 152.912}, {"i": 333, "text": "care,", "start": 152.952, "end": 153.192}, {"i": 334, "text": "Jonas.", "start": 153.252, "end": 153.613}, {"i": 335, "text": "Thank", "start": 154.815, "end": 154.996}, {"i": 336, "text": "you,", "start": 155.036, "end": 155.136}, {"i": 337, "text": "Dr.", "start": 155.176, "end": 155.457}, {"i": 338, "text": "Overgod.", "start": 155.557, "end": 156.038}, {"i": 339, "text": "Goodbye.", "start": 156.619, "end": 157.06}], "segments": [{"start": 0.054, "end": 0.774, "text": "Come in, Jonas."}, {"start": 1.035, "end": 1.675, "text": "Good to see you."}, {"start": 2.936, "end": 3.296, "text": "Thanks."}, {"start": 4.236, "end": 6.638, "text": "I am a bit on edge about this one."}, {"start": 7.698, "end": 10.44, "text": "Tell me what is going on and we will take it from there."}, {"start": 11.62, "end": 13.501, "text": "It burns when I pass water."}, {"start": 14.242, "end": 16.063, "text": "It has been really uncomfortable."}, {"start": 17.324, "end": 19.385, "text": "A burning sensation when you urinate."}, {"start": 19.885, "end": 20.826, "text": "Thank you for telling me."}, {"start": 22.066, "end": 22.927, "text": "Is that serious?"}, {"start": 23.907, "end": 26.108, "text": "I keep wondering whether it is something bad."}, {"start": 27.249, "end": 28.69, "text": "Let us find out properly."}, {"start": 29.234, "end": 30.915, "text": "I would like to test a urine sample."}, {"start": 32.215, "end": 33.976, "text": "Okay, whatever you need."}, {"start": 35.356, "end": 36.177, "text": "Here is the result."}, {"start": 36.697, "end": 39.158, "text": "The dipstick is positive for white blood cells."}, {"start": 40.519, "end": 41.679, "text": "White blood cells?"}, {"start": 42.359, "end": 43.98, "text": "That sounds like an infection."}, {"start": 45.2, "end": 48.942, "text": "It is also positive for nitrite, which points in the same direction."}, {"start": 50.162, "end": 51.823, "text": "And what do the two together mean?"}, {"start": 53.024, "end": 55.064, "text": "They mean a urinary tract infection."}, {"start": 57.025, "end": 58.846, "text": "A urinary tract infection?"}, {"start": 59.762, "end": 61.983, "text": "Is that the whole explanation for the burning?"}, {"start": 63.204, "end": 66.466, "text": "Yes, that is my assessment, and it fits what you describe."}, {"start": 67.886, "end": 71.488, "text": "I had convinced myself it was something worse than an infection."}, {"start": 72.749, "end": 73.389, "text": "I understand."}, {"start": 73.93, "end": 76.131, "text": "The findings point to an infection in the bladder."}, {"start": 77.552, "end": 77.992, "text": "All right."}, {"start": 78.572, "end": 80.173, "text": "So what do we do about it?"}, {"start": 81.534, "end": 84.495, "text": "I will prescribe an antibiotic called pivmacillinum."}, {"start": 85.716, "end": 86.797, "text": "Pivmacillinum?"}, {"start": 87.657, "end": 88.958, "text": "Is that enough on its own?"}, {"start": 90.334, "end": 92.436, "text": "That is the treatment I am prescribing today."}, {"start": 92.856, "end": 93.997, "text": "Are you comfortable with it?"}, {"start": 95.158, "end": 95.478, "text": "Yes."}, {"start": 96.179, "end": 98.201, "text": "I just want the burning to stop."}, {"start": 99.562, "end": 100.062, "text": "Understood."}, {"start": 100.743, "end": 103.665, "text": "Did you have to sit long out there with those tired magazines?"}, {"start": 105.067, "end": 105.767, "text": "A few minutes."}, {"start": 106.628, "end": 109.07, "text": "I think some of them are older than my car."}, {"start": 110.211, "end": 111.752, "text": "We keep meaning to replace them."}, {"start": 113.094, "end": 113.674, "text": "You should."}, {"start": 114.615, "end": 116.356, "text": "Anyway, back to the infection."}, {"start": 117.698, "end": 118.098, "text": "Of course."}, {"start": 118.698, "end": 120.64, "text": "Do you have any questions about the treatment?"}, {"start": 120.68, "end": 124.162, "text": "Just to be sure, the prescription is the plan for now?"}, {"start": 125.163, "end": 125.463, "text": "Yes."}, {"start": 125.983, "end": 128.485, "text": "Pivmis Alenum is the plan we have agreed on today."}, {"start": 129.506, "end": 129.926, "text": "Good."}, {"start": 129.946, "end": 132.268, "text": "That settles my mind a little."}, {"start": 133.308, "end": 133.909, "text": "I am glad."}, {"start": 134.629, "end": 137.131, "text": "And it is turning properly into autumn out there."}, {"start": 138.232, "end": 138.732, "text": "It is."}, {"start": 139.413, "end": 141.294, "text": "The mornings are much darker now."}, {"start": 142.335, "end": 142.775, "text": "They are."}, {"start": 143.936, "end": 144.176, "text": "Right."}, {"start": 144.636, "end": 146.858, "text": "Is there anything else worrying you today?"}, {"start": 148.082, "end": 149.946, "text": "No, I think that is everything."}, {"start": 151.188, "end": 151.95, "text": "Then we are done."}, {"start": 152.731, "end": 153.613, "text": "Take care, Jonas."}, {"start": 154.815, "end": 156.038, "text": "Thank you, Dr. Overgod."}, {"start": 156.619, "end": 157.06, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.545}}