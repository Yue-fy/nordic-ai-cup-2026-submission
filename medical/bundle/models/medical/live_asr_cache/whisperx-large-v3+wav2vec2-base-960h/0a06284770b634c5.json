tart": 92.957, "end": 93.597}, {"i": 232, "text": "It", "start": 94.357, "end": 94.417}, {"i": 233, "text": "did,", "start": 94.457, "end": 94.777}, {"i": 234, "text": "a", "start": 94.797, "end": 94.817}, {"i": 235, "text": "little.", "start": 95.037, "end": 95.277}, {"i": 236, "text": "Thank", "start": 96.278, "end": 96.478}, {"i": 237, "text": "you", "start": 96.498, "end": 96.598}, {"i": 238, "text": "for", "start": 96.618, "end": 96.738}, {"i": 239, "text": "explaining", "start": 96.778, "end": 97.218}, {"i": 240, "text": "everything", "start": 97.258, "end": 97.618}, {"i": 241, "text": "so", "start": 97.698, "end": 97.879}, {"i": 242, "text": "patiently.", "start": 97.939, "end": 98.539}, {"i": 243, "text": "You", "start": 99.259, "end": 99.399}, {"i": 244, "text": "are", "start": 99.479, "end": 99.579}, {"i": 245, "text": "welcome,", "start": 99.659, "end": 100.079}, {"i": 246, "text": "Morton.", "start": 100.099, "end": 100.48}, {"i": 247, "text": "Take", "start": 100.88, "end": 101.08}, {"i": 248, "text": "care.", "start": 101.12, "end": 101.4}], "segments": [{"start": 0.066, "end": 0.586, "text": "Good morning."}, {"start": 1.407, "end": 2.428, "text": "My name is Morton Reese."}, {"start": 3.869, "end": 4.869, "text": "I have an appointment."}, {"start": 5.37, "end": 6.29, "text": "Good morning, Morton."}, {"start": 6.851, "end": 7.731, "text": "I'm Dr. Bang."}, {"start": 8.092, "end": 8.852, "text": "Please have a seat."}, {"start": 9.412, "end": 9.813, "text": "Thank you."}, {"start": 10.773, "end": 12.475, "text": "I was not sure I had found the right room."}, {"start": 13.095, "end": 13.595, "text": "You have."}, {"start": 14.196, "end": 16.577, "text": "This is your follow-up for allergic rhinitis."}, {"start": 17.238, "end": 17.558, "text": "Yes."}, {"start": 18.559, "end": 21.441, "text": "I have been worrying about whether it is really under control."}, {"start": 22.261, "end": 23.622, "text": "Let us go through it together."}, {"start": 24.243, "end": 25.483, "text": "How has the medication been?"}, {"start": 26.004, "end": 26.704, "text": "It has helped."}, {"start": 27.405, "end": 29.066, "text": "I do not have any symptoms right now."}, {"start": 29.922, "end": 31.483, "text": "No symptoms at all at the moment?"}, {"start": 32.204, "end": 32.484, "text": "None."}, {"start": 33.104, "end": 34.946, "text": "And that is partly what makes me uneasy."}, {"start": 35.646, "end": 37.467, "text": "Say a little more about that if you can."}, {"start": 38.188, "end": 40.089, "text": "It feels too easy."}, {"start": 40.93, "end": 42.791, "text": "I keep thinking something is being missed."}, {"start": 43.531, "end": 44.252, "text": "I understand."}, {"start": 44.892, "end": 47.034, "text": "The examination I have done is normal."}, {"start": 47.774, "end": 48.795, "text": "Normal in all of it?"}, {"start": 49.536, "end": 49.896, "text": "Yes."}, {"start": 50.396, "end": 52.838, "text": "Nothing abnormal was found on examination."}, {"start": 54.239, "end": 54.659, "text": "All right."}, {"start": 55.52, "end": 57.561, "text": "So the medicine is genuinely working?"}, {"start": 58.122, "end": 58.422, "text": "Yes."}, {"start": 59.006, "end": 61.308, "text": "The antihistamine is having a good effect."}, {"start": 61.968, "end": 64.55, "text": "So I feel well because of the antihistamine."}, {"start": 65.351, "end": 66.452, "text": "That is my assessment."}, {"start": 67.132, "end": 68.413, "text": "Do I stop taking it now?"}, {"start": 69.093, "end": 71.135, "text": "The plan is to continue it as needed."}, {"start": 71.896, "end": 72.436, "text": "As needed."}, {"start": 72.956, "end": 74.878, "text": "So only when the symptoms come back?"}, {"start": 75.738, "end": 76.059, "text": "Yes."}, {"start": 76.399, "end": 77.56, "text": "You take it when you need it."}, {"start": 78.42, "end": 78.701, "text": "Right."}, {"start": 79.401, "end": 80.442, "text": "That is clearer now."}, {"start": 81.162, "end": 81.503, "text": "Good."}, {"start": 82.363, "end": 84.665, "text": "I noticed you looking at the plants when you came in."}, {"start": 85.406, "end": 85.806, "text": "I was."}, {"start": 86.654, "end": 89.095, "text": "They look a great deal healthier than mine at home."}, {"start": 89.795, "end": 93.597, "text": "The room was rearranged recently, too, in case it looked unfamiliar."}, {"start": 94.357, "end": 95.277, "text": "It did, a little."}, {"start": 96.278, "end": 98.539, "text": "Thank you for explaining everything so patiently."}, {"start": 99.259, "end": 100.48, "text": "You are welcome, Morton."}, {"start": 100.88, "end": 101.4, "text": "Take care."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.944}}