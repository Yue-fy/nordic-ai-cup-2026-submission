18, "end": 93.22}, {"i": 232, "text": "will", "start": 93.26, "end": 93.4}, {"i": 233, "text": "keep", "start": 93.441, "end": 93.601}, {"i": 234, "text": "it", "start": 93.641, "end": 93.701}, {"i": 235, "text": "in", "start": 93.741, "end": 93.801}, {"i": 236, "text": "mind.", "start": 93.841, "end": 94.161}, {"i": 237, "text": "Take", "start": 94.943, "end": 95.163}, {"i": 238, "text": "care,", "start": 95.203, "end": 95.403}, {"i": 239, "text": "Anne.", "start": 95.503, "end": 95.684}, {"i": 240, "text": "Thank", "start": 96.344, "end": 96.545}, {"i": 241, "text": "you.", "start": 96.565, "end": 96.725}, {"i": 242, "text": "Goodbye.", "start": 97.085, "end": 97.446}], "segments": [{"start": 0.086, "end": 0.546, "text": "Good morning."}, {"start": 1.047, "end": 2.207, "text": "My name is Anne Thorson."}, {"start": 2.888, "end": 3.608, "text": "Good morning, Anne."}, {"start": 4.169, "end": 5.11, "text": "I am Dr. Norgord."}, {"start": 5.83, "end": 6.871, "text": "We have not met before."}, {"start": 7.631, "end": 8.332, "text": "Please have a seat."}, {"start": 9.052, "end": 9.433, "text": "Thank you."}, {"start": 10.453, "end": 12.074, "text": "You have a lot of birds at that window."}, {"start": 12.895, "end": 13.856, "text": "The feeder is new."}, {"start": 14.556, "end": 16.477, "text": "It has been busy out there all week."}, {"start": 17.398, "end": 19.319, "text": "Ours only ever attracts sparrows."}, {"start": 20.16, "end": 21.421, "text": "Better than the neighbor's cat."}, {"start": 22.241, "end": 23.742, "text": "Now, what brings you in?"}, {"start": 24.783, "end": 26.504, "text": "I have a growth in the middle of my chest."}, {"start": 27.345, "end": 28.586, "text": "It looks a bit like a wart."}, {"start": 29.49, "end": 31.392, "text": "Is there anything else in the same area?"}, {"start": 32.132, "end": 33.934, "text": "Yes, three more close by."}, {"start": 34.734, "end": 36.236, "text": "They look different from the first one."}, {"start": 36.936, "end": 38.417, "text": "I would like to look at your chest."}, {"start": 39.178, "end": 39.578, "text": "Of course."}, {"start": 40.379, "end": 45.443, "text": "I can see three small lesions, all in the same area on the chest wall."}, {"start": 46.204, "end": 47.665, "text": "So three, as I thought."}, {"start": 48.346, "end": 50.708, "text": "Three, in one area on the thorax."}, {"start": 51.528, "end": 52.069, "text": "What are they?"}, {"start": 52.789, "end": 55.552, "text": "My suspicion is molluscum contagiosum."}, {"start": 56.252, "end": 58.354, "text": "It is a common viral skin condition."}, {"start": 59.026, "end": 60.868, "text": "A suspicion rather than a certainty?"}, {"start": 61.508, "end": 61.888, "text": "Correct."}, {"start": 62.449, "end": 63.71, "text": "That is my assessment today."}, {"start": 64.451, "end": 65.291, "text": "What happens next?"}, {"start": 66.132, "end": 67.593, "text": "I will treat them with freezing."}, {"start": 68.354, "end": 69.315, "text": "What does that involve?"}, {"start": 70.035, "end": 71.416, "text": "The lesions are frozen off."}, {"start": 72.177, "end": 73.658, "text": "That is the treatment I am planning."}, {"start": 74.359, "end": 74.699, "text": "Alright."}, {"start": 75.159, "end": 75.98, "text": "That is clear enough."}, {"start": 76.861, "end": 77.621, "text": "Any other questions?"}, {"start": 78.502, "end": 78.662, "text": "No."}, {"start": 79.763, "end": 81.144, "text": "One thing before I forget though."}, {"start": 81.925, "end": 84.307, "text": "I finished that novel everyone has been talking about."}, {"start": 85.008, "end": 86.389, "text": "The one set out on the coast."}, {"start": 87.169, "end": 87.77, "text": "Worth reading?"}, {"start": 88.554, "end": 90.797, "text": "The ending made the slow start worthwhile."}, {"start": 91.598, "end": 92.439, "text": "I would recommend it."}, {"start": 93.18, "end": 94.161, "text": "I will keep it in mind."}, {"start": 94.943, "end": 95.684, "text": "Take care, Anne."}, {"start": 96.344, "end": 96.725, "text": "Thank you."}, {"start": 97.085, "end": 97.446, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.886}}