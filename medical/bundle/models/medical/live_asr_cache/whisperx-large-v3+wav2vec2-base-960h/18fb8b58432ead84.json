, "end": 123.624}, {"i": 296, "text": "anything", "start": 123.684, "end": 123.984}, {"i": 297, "text": "change", "start": 124.044, "end": 124.305}, {"i": 298, "text": "with", "start": 124.325, "end": 124.445}, {"i": 299, "text": "my", "start": 124.485, "end": 124.585}, {"i": 300, "text": "asthma", "start": 124.685, "end": 124.945}, {"i": 301, "text": "medicine?", "start": 124.965, "end": 125.366}, {"i": 302, "text": "No", "start": 125.986, "end": 126.126}, {"i": 303, "text": "medication", "start": 126.166, "end": 126.687}, {"i": 304, "text": "changes", "start": 126.747, "end": 127.107}, {"i": 305, "text": "today.", "start": 127.167, "end": 127.527}, {"i": 306, "text": "I", "start": 128.468, "end": 128.548}, {"i": 307, "text": "do", "start": 128.608, "end": 128.749}, {"i": 308, "text": "recommend", "start": 128.809, "end": 129.209}, {"i": 309, "text": "that", "start": 129.249, "end": 129.349}, {"i": 310, "text": "you", "start": 129.389, "end": 129.509}, {"i": 311, "text": "take", "start": 129.529, "end": 129.709}, {"i": 312, "text": "the", "start": 129.729, "end": 129.849}, {"i": 313, "text": "Sporiva", "start": 129.87, "end": 130.37}, {"i": 314, "text": "regularly.", "start": 130.45, "end": 131.031}, {"i": 315, "text": "Understood.", "start": 131.671, "end": 132.131}, {"i": 316, "text": "I", "start": 132.832, "end": 132.872}, {"i": 317, "text": "will", "start": 132.912, "end": 133.032}, {"i": 318, "text": "look", "start": 133.052, "end": 133.192}, {"i": 319, "text": "at", "start": 133.212, "end": 133.272}, {"i": 320, "text": "the", "start": 133.313, "end": 133.373}, {"i": 321, "text": "cost", "start": 133.393, "end": 133.653}, {"i": 322, "text": "again.", "start": 133.693, "end": 133.933}, {"i": 323, "text": "Good.", "start": 134.434, "end": 134.734}, {"i": 324, "text": "Are", "start": 135.735, "end": 135.815}, {"i": 325, "text": "you", "start": 135.835, "end": 135.915}, {"i": 326, "text": "going", "start": 135.955, "end": 136.135}, {"i": 327, "text": "to", "start": 136.155, "end": 136.235}, {"i": 328, "text": "the", "start": 136.255, "end": 136.335}, {"i": 329, "text": "market", "start": 136.375, "end": 136.675}, {"i": 330, "text": "in", "start": 136.716, "end": 136.796}, {"i": 331, "text": "town", "start": 136.836, "end": 137.036}, {"i": 332, "text": "this", "start": 137.076, "end": 137.196}, {"i": 333, "text": "weekend?", "start": 137.236, "end": 137.616}, {"i": 334, "text": "I", "start": 138.317, "end": 138.377}, {"i": 335, "text": "might,", "start": 138.417, "end": 138.677}, {"i": 336, "text": "if", "start": 138.857, "end": 138.937}, {"i": 337, "text": "the", "start": 138.977, "end": 139.058}, {"i": 338, "text": "weather", "start": 139.098, "end": 139.318}, {"i": 339, "text": "holds.", "start": 139.338, "end": 139.638}, {"i": 340, "text": "Thank", "start": 140.399, "end": 140.579}, {"i": 341, "text": "you,", "start": 140.599, "end": 140.719}, {"i": 342, "text": "doctor.", "start": 140.739, "end": 141.099}, {"i": 343, "text": "Goodbye.", "start": 141.42, "end": 141.78}], "segments": [{"start": 0.086, "end": 0.606, "text": "Good morning."}, {"start": 1.087, "end": 1.827, "text": "I am Nannadal."}, {"start": 2.527, "end": 3.928, "text": "I do not think we have met before."}, {"start": 4.829, "end": 5.489, "text": "We have not."}, {"start": 6.269, "end": 7.55, "text": "I am Dr. Mogensen."}, {"start": 7.99, "end": 8.331, "text": "Welcome."}, {"start": 9.131, "end": 10.072, "text": "Did you cycle here?"}, {"start": 10.932, "end": 11.272, "text": "I did."}, {"start": 12.233, "end": 14.694, "text": "I hope leaving the bike by the side wall is acceptable."}, {"start": 15.615, "end": 16.775, "text": "That is the right spot."}, {"start": 17.256, "end": 19.337, "text": "The racks by the door are always full."}, {"start": 20.197, "end": 21.598, "text": "Now, how is your asthma?"}, {"start": 22.478, "end": 23.579, "text": "Stable, I would say."}, {"start": 24.139, "end": 24.94, "text": "Nothing dramatic."}, {"start": 25.9, "end": 26.181, "text": "Good."}, {"start": 26.941, "end": 28.742, "text": "Which medicines are you taking at the moment?"}, {"start": 29.778, "end": 32.881, "text": "Inover, Spuriva, Montelukast, and Dimista."}, {"start": 33.741, "end": 34.122, "text": "Thank you."}, {"start": 34.802, "end": 36.483, "text": "And does your need for them change?"}, {"start": 37.524, "end": 39.066, "text": "Yes, mostly with the weather."}, {"start": 39.766, "end": 41.127, "text": "I rarely need the Aromir."}, {"start": 42.228, "end": 44.31, "text": "Are you taking all of them as prescribed?"}, {"start": 45.231, "end": 46.091, "text": "Not the Spuriva."}, {"start": 46.992, "end": 48.393, "text": "It is the cost, honestly."}, {"start": 48.413, "end": 50.815, "text": "I have not been taking it regularly."}, {"start": 51.896, "end": 53.397, "text": "Thank you for saying so directly."}, {"start": 54.098, "end": 56.019, "text": "Is there anything else you wanted to raise?"}, {"start": 57.06, "end": 59.242, "text": "Yes, I think I have a fungus on my tongue."}, {"start": 60.094, "end": 62.875, "text": "I tried Brenton and Micostatin, and neither worked."}, {"start": 63.956, "end": 64.276, "text": "Noted."}, {"start": 65.016, "end": 67.437, "text": "And I understand you are allergic to wasps."}, {"start": 68.498, "end": 69.578, "text": "Yes, wasps."}, {"start": 70.318, "end": 73.26, "text": "And I should say that I smoke, and I am not motivated to stop."}, {"start": 74.14, "end": 75.541, "text": "Thank you for being straight with me."}, {"start": 76.101, "end": 77.982, "text": "Let me take you through today's lung measurements."}, {"start": 79.042, "end": 79.402, "text": "Please."}, {"start": 79.823, "end": 80.903, "text": "What do they actually show?"}, {"start": 81.964, "end": 83.384, "text": "Your FEV1 is 82%."}, {"start": 83.404, "end": 84.345, "text": "The ratio to FVC, 68%."}, {"start": 88.278, "end": 95.364, "text": "peak flow 423.6 liters per minute, and FVC 2.66 liters."}, {"start": 96.425, "end": 97.566, "text": "That is a lot of numbers."}, {"start": 98.146, "end": 99.247, "text": "What do you conclude from them?"}, {"start": 100.248, "end": 101.569, "text": "That your asthma is stable."}, {"start": 102.35, "end": 104.832, "text": "I would add that you are lacking a little exercise."}, {"start": 105.993, "end": 106.934, "text": "And what about my tongue?"}, {"start": 107.174, "end": 110.877, "text": "I suspect oral candidiasis, which is a fungal infection in the mouth."}, {"start": 111.798, "end": 113.52, "text": "So I will take a swab from the tongue."}, {"start": 114.04, "end": 116.182, "text": "Why a swab rather than simply treating it again?"}, {"start": 116.818, "end": 121.382, "text": "Because two treatments have already failed, so I want to know what is actually there."}, {"start": 122.103, "end": 122.663, "text": "That is fair."}, {"start": 123.464, "end": 125.366, "text": "Does anything change with my asthma medicine?"}, {"start": 125.986, "end": 127.527, "text": "No medication changes today."}, {"start": 128.468, "end": 131.031, "text": "I do recommend that you take the Sporiva regularly."}, {"start": 131.671, "end": 132.131, "text": "Understood."}, {"start": 132.832, "end": 133.933, "text": "I will look at the cost again."}, {"start": 134.434, "end": 134.734, "text": "Good."}, {"start": 135.735, "end": 137.616, "text": "Are you going to the market in town this weekend?"}, {"start": 138.317, "end": 139.638, "text": "I might, if the weather holds."}, {"start": 140.399, "end": 141.099, "text": "Thank you, doctor."}, {"start": 141.42, "end": 141.78, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.478}}