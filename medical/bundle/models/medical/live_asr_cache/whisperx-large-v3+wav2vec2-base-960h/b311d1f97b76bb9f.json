, {"i": 523, "text": "electrocardiogram.", "start": 202.474, "end": 203.894}, {"i": 524, "text": "Is", "start": 204.555, "end": 204.635}, {"i": 525, "text": "that", "start": 204.695, "end": 204.915}, {"i": 526, "text": "uncomfortable?", "start": 205.135, "end": 205.735}, {"i": 527, "text": "I", "start": 206.495, "end": 206.535}, {"i": 528, "text": "have", "start": 206.575, "end": 206.675}, {"i": 529, "text": "never", "start": 206.715, "end": 206.895}, {"i": 530, "text": "had", "start": 206.935, "end": 207.095}, {"i": 531, "text": "one.", "start": 207.235, "end": 207.355}, {"i": 532, "text": "Small", "start": 207.455, "end": 207.715}, {"i": 533, "text": "stickers", "start": 207.755, "end": 208.095}, {"i": 534, "text": "on", "start": 208.155, "end": 208.215}, {"i": 535, "text": "the", "start": 208.235, "end": 208.315}, {"i": 536, "text": "skin", "start": 208.355, "end": 208.695}, {"i": 537, "text": "and", "start": 208.956, "end": 209.056}, {"i": 538, "text": "a", "start": 209.096, "end": 209.136}, {"i": 539, "text": "short", "start": 209.176, "end": 209.416}, {"i": 540, "text": "recording.", "start": 209.456, "end": 210.016}, {"i": 541, "text": "That", "start": 210.656, "end": 210.816}, {"i": 542, "text": "is", "start": 210.856, "end": 210.956}, {"i": 543, "text": "all", "start": 211.056, "end": 211.176}, {"i": 544, "text": "there", "start": 211.216, "end": 211.396}, {"i": 545, "text": "is", "start": 211.476, "end": 211.576}, {"i": 546, "text": "to", "start": 211.636, "end": 211.816}, {"i": 547, "text": "it.", "start": 211.936, "end": 211.996}, {"i": 548, "text": "Are", "start": 212.876, "end": 212.976}, {"i": 549, "text": "you", "start": 213.016, "end": 213.156}, {"i": 550, "text": "following", "start": 213.217, "end": 213.617}, {"i": 551, "text": "me", "start": 213.637, "end": 213.777}, {"i": 552, "text": "so", "start": 213.837, "end": 213.997}, {"i": 553, "text": "far?", "start": 214.037, "end": 214.317}, {"i": 554, "text": "I", "start": 215.137, "end": 215.197}, {"i": 555, "text": "am.", "start": 215.337, "end": 215.477}, {"i": 556, "text": "Blood", "start": 216.177, "end": 216.437}, {"i": 557, "text": "samples", "start": 216.477, "end": 216.937}, {"i": 558, "text": "and", "start": 217.517, "end": 217.638}, {"i": 559, "text": "a", "start": 217.678, "end": 217.698}, {"i": 560, "text": "tracing", "start": 217.778, "end": 218.198}, {"i": 561, "text": "of", "start": 218.218, "end": 218.298}, {"i": 562, "text": "my", "start": 218.338, "end": 218.478}, {"i": 563, "text": "heart.", "start": 218.538, "end": 218.798}, {"i": 564, "text": "That", "start": 219.438, "end": 219.598}, {"i": 565, "text": "is", "start": 219.638, "end": 219.718}, {"i": 566, "text": "the", "start": 219.758, "end": 219.818}, {"i": 567, "text": "plan.", "start": 219.858, "end": 220.198}, {"i": 568, "text": "We", "start": 220.938, "end": 221.058}, {"i": 569, "text": "will", "start": 221.078, "end": 221.218}, {"i": 570, "text": "go", "start": 221.258, "end": 221.398}, {"i": 571, "text": "through", "start": 221.458, "end": 221.678}, {"i": 572, "text": "what", "start": 221.718, "end": 221.858}, {"i": 573, "text": "they", "start": 221.878, "end": 222.039}, {"i": 574, "text": "show", "start": 222.079, "end": 222.339}, {"i": 575, "text": "once", "start": 222.519, "end": 222.639}, {"i": 576, "text": "we", "start": 222.699, "end": 222.819}, {"i": 577, "text": "have", "start": 222.859, "end": 223.059}, {"i": 578, "text": "them.", "start": 223.099, "end": 223.279}, {"i": 579, "text": "Thank", "start": 224.079, "end": 224.299}, {"i": 580, "text": "you.", "start": 224.339, "end": 224.519}, {"i": 581, "text": "I", "start": 225.299, "end": 225.359}, {"i": 582, "text": "feel", "start": 225.399, "end": 225.599}, {"i": 583, "text": "better", "start": 225.639, "end": 225.879}, {"i": 584, "text": "having", "start": 225.939, "end": 226.179}, {"i": 585, "text": "a", "start": 226.219, "end": 226.259}, {"i": 586, "text": "plan", "start": 226.32, "end": 226.64}, {"i": 587, "text": "than", "start": 226.68, "end": 226.86}, {"i": 588, "text": "sitting", "start": 227.0, "end": 227.24}, {"i": 589, "text": "at", "start": 227.26, "end": 227.34}, {"i": 590, "text": "home", "start": 227.38, "end": 227.62}, {"i": 591, "text": "wondering", "start": 227.7, "end": 228.08}, {"i": 592, "text": "about", "start": 228.14, "end": 228.38}, {"i": 593, "text": "it.", "start": 228.42, "end": 228.48}], "segments": [{"start": 0.054, "end": 0.614, "text": "Good morning."}, {"start": 1.135, "end": 2.236, "text": "I am Dr. Iverson."}, {"start": 2.776, "end": 3.817, "text": "We have not met before."}, {"start": 4.377, "end": 5.418, "text": "Could you tell me your name?"}, {"start": 6.158, "end": 7.279, "text": "Camilla Fabricius."}, {"start": 8.46, "end": 9.661, "text": "Thank you for seeing me."}, {"start": 10.362, "end": 11.903, "text": "You are very welcome, Camilla."}, {"start": 12.503, "end": 13.584, "text": "Let us take this in order."}, {"start": 14.384, "end": 16.206, "text": "Tell me what has brought you here today."}, {"start": 17.086, "end": 19.508, "text": "Well, it is my family, really."}, {"start": 20.349, "end": 25.633, "text": "My grandfather on my father's side died of a heart attack, and he was only 52."}, {"start": 26.273, "end": 27.234, "text": "Thank you for telling me."}, {"start": 27.986, "end": 30.787, "text": "So there is cardiovascular disease in your family?"}, {"start": 31.487, "end": 31.808, "text": "Yes."}, {"start": 32.648, "end": 37.11, "text": "And ever since I worked that out, I have not been able to stop thinking about it."}, {"start": 38.09, "end": 40.031, "text": "Is that the sort of thing that gets passed down?"}, {"start": 40.851, "end": 45.813, "text": "A family history of heart and circulatory disease is one of the things we take into account."}, {"start": 46.414, "end": 49.215, "text": "That is exactly why it is worth looking at properly."}, {"start": 50.575, "end": 50.896, "text": "Right."}, {"start": 51.696, "end": 53.437, "text": "I was rather afraid you would say that."}, {"start": 54.277, "end": 56.598, "text": "Let me explain what I mean before you worry."}, {"start": 57.482, "end": 61.244, "text": "Taking it into account is not the same as saying you have anything."}, {"start": 62.284, "end": 62.644, "text": "Okay."}, {"start": 63.525, "end": 65.025, "text": "Okay, that does help a little."}, {"start": 65.746, "end": 66.026, "text": "Good."}, {"start": 66.826, "end": 68.887, "text": "Now, tell me about your own health."}, {"start": 69.807, "end": 71.488, "text": "I am healthy, as far as I know."}, {"start": 72.168, "end": 73.269, "text": "No illnesses at all."}, {"start": 74.029, "end": 76.05, "text": "I eat well and I look after myself."}, {"start": 76.911, "end": 77.691, "text": "And exercise?"}, {"start": 78.591, "end": 79.632, "text": "I train regularly."}, {"start": 80.292, "end": 84.554, "text": "That part I am actually consistent about, which I suppose is something."}, {"start": 85.446, "end": 87.167, "text": "It is, and it matters."}, {"start": 88.148, "end": 92.412, "text": "Let us go through the rest step by step, so you know what I am doing and why."}, {"start": 93.132, "end": 93.713, "text": "Please do."}, {"start": 93.733, "end": 97.376, "text": "I would much rather know what is happening than sit here guessing."}, {"start": 98.156, "end": 99.518, "text": "First, I look at you."}, {"start": 100.238, "end": 101.399, "text": "You look healthy, Camilla."}, {"start": 101.939, "end": 105.022, "text": "There is nothing about your general appearance that concerns me."}, {"start": 105.142, "end": 108.285, "text": "Is that really something you can tell just by looking at someone?"}, {"start": 109.265, "end": 111.908, "text": "It is part of the picture, not the whole of it."}, {"start": 112.648, "end": 114.69, "text": "That is why I measure and test as well."}, {"start": 115.678, "end": 116.078, "text": "All right."}, {"start": 116.799, "end": 117.68, "text": "So what comes next?"}, {"start": 118.52, "end": 119.301, "text": "Your blood pressure."}, {"start": 120.001, "end": 123.184, "text": "I have measured it at 138 over 83."}, {"start": 124.285, "end": 124.965, "text": "Is that bad?"}, {"start": 126.246, "end": 128.828, "text": "It sounds high when you say it out loud like that."}, {"start": 129.709, "end": 135.513, "text": "I am recording it as today's measurement, and it will be looked at together with the tests I want to arrange."}, {"start": 136.554, "end": 139.636, "text": "So you are not telling me it is fine exactly."}, {"start": 139.656, "end": 141.938, "text": "I am telling you what I measured,"}, {"start": 142.43, "end": 145.771, "text": "and that I do not draw conclusions from one reading on its own."}, {"start": 146.692, "end": 147.252, "text": "That is fair."}, {"start": 147.932, "end": 151.274, "text": "I would rather have that than be brushed off with a pat on the shoulder."}, {"start": 152.234, "end": 153.494, "text": "I will not brush you off."}, {"start": 154.435, "end": 159.917, "text": "What we are doing today is a preventive health check because of the family disposition you described."}, {"start": 160.777, "end": 161.478, "text": "Preventive."}, {"start": 162.258, "end": 166.04, "text": "So this is a check rather than a hunt for something already wrong with me."}, {"start": 166.96, "end": 167.6, "text": "Precisely."}, {"start": 168.22, "end": 169.821, "text": "You have understood it exactly."}, {"start": 170.601, "end": 172.022, "text": "Does that distinction make sense?"}, {"start": 172.966, "end": 173.426, "text": "It does."}, {"start": 175.067, "end": 176.648, "text": "Sorry, I am a little scattered."}, {"start": 177.288, "end": 181.051, "text": "I spent 20 minutes in a queue at the post office and arrived flustered."}, {"start": 181.991, "end": 183.872, "text": "That queue defeats everyone."}, {"start": 184.533, "end": 186.053, "text": "You are here in good time."}, {"start": 186.854, "end": 187.314, "text": "Thank you."}, {"start": 188.275, "end": 189.455, "text": "Back to the tests, then."}, {"start": 190.196, "end": 191.636, "text": "What exactly are you going to do?"}, {"start": 192.577, "end": 193.137, "text": "Two things."}, {"start": 193.798, "end": 201.342, "text": "I will take blood samples, and I will record an electrocardiogram, which is a tracing of the heart's electrical activity."}, {"start": 202.354, "end": 203.894, "text": "An electrocardiogram."}, {"start": 204.555, "end": 205.735, "text": "Is that uncomfortable?"}, {"start": 206.495, "end": 207.355, "text": "I have never had one."}, {"start": 207.455, "end": 210.016, "text": "Small stickers on the skin and a short recording."}, {"start": 210.656, "end": 211.996, "text": "That is all there is to it."}, {"start": 212.876, "end": 214.317, "text": "Are you following me so far?"}, {"start": 215.137, "end": 215.477, "text": "I am."}, {"start": 216.177, "end": 218.798, "text": "Blood samples and a tracing of my heart."}, {"start": 219.438, "end": 220.198, "text": "That is the plan."}, {"start": 220.938, "end": 223.279, "text": "We will go through what they show once we have them."}, {"start": 224.079, "end": 224.519, "text": "Thank you."}, {"start": 225.299, "end": 228.48, "text": "I feel better having a plan than sitting at home wondering about it."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 3.716}}