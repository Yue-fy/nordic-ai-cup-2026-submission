end": 104.316}, {"i": 299, "text": "lot", "start": 104.336, "end": 104.456}, {"i": 300, "text": "of", "start": 104.476, "end": 104.516}, {"i": 301, "text": "them", "start": 104.556, "end": 104.676}, {"i": 302, "text": "in", "start": 104.696, "end": 104.756}, {"i": 303, "text": "the", "start": 104.796, "end": 104.856}, {"i": 304, "text": "garden", "start": 104.896, "end": 105.216}, {"i": 305, "text": "at", "start": 105.236, "end": 105.296}, {"i": 306, "text": "this", "start": 105.316, "end": 105.456}, {"i": 307, "text": "time", "start": 105.516, "end": 105.716}, {"i": 308, "text": "of", "start": 105.736, "end": 105.796}, {"i": 309, "text": "year.", "start": 105.836, "end": 106.036}, {"i": 310, "text": "It", "start": 106.697, "end": 106.757}, {"i": 311, "text": "is", "start": 106.817, "end": 106.917}, {"i": 312, "text": "a", "start": 106.957, "end": 106.997}, {"i": 313, "text": "nice", "start": 107.097, "end": 107.377}, {"i": 314, "text": "thing", "start": 107.477, "end": 107.737}, {"i": 315, "text": "to", "start": 107.797, "end": 107.917}, {"i": 316, "text": "look", "start": 107.977, "end": 108.197}, {"i": 317, "text": "at.", "start": 108.317, "end": 108.437}, {"i": 318, "text": "It", "start": 109.077, "end": 109.157}, {"i": 319, "text": "is.", "start": 109.237, "end": 109.358}, {"i": 320, "text": "Then", "start": 110.478, "end": 110.758}, {"i": 321, "text": "we", "start": 110.918, "end": 111.058}, {"i": 322, "text": "are", "start": 111.118, "end": 111.218}, {"i": 323, "text": "finished", "start": 111.298, "end": 111.658}, {"i": 324, "text": "for", "start": 111.698, "end": 111.878}, {"i": 325, "text": "today,", "start": 111.918, "end": 112.219}, {"i": 326, "text": "Nana.", "start": 112.259, "end": 112.599}, {"i": 327, "text": "Take", "start": 113.139, "end": 113.339}, {"i": 328, "text": "care.", "start": 113.399, "end": 113.699}, {"i": 329, "text": "Thank", "start": 114.359, "end": 114.539}, {"i": 330, "text": "you,", "start": 114.559, "end": 114.659}, {"i": 331, "text": "Doctor.", "start": 114.68, "end": 115.1}, {"i": 332, "text": "Goodbye.", "start": 115.3, "end": 115.7}], "segments": [{"start": 0.086, "end": 0.546, "text": "Good morning."}, {"start": 0.906, "end": 1.627, "text": "I am Nana Skoll."}, {"start": 1.967, "end": 2.887, "text": "Good morning, Nana."}, {"start": 3.347, "end": 4.328, "text": "I am Dr. Bang."}, {"start": 4.708, "end": 5.548, "text": "Please take a seat."}, {"start": 5.988, "end": 6.429, "text": "Thank you."}, {"start": 7.049, "end": 9.01, "text": "I hope I'm not taking up too much of your time."}, {"start": 9.49, "end": 10.13, "text": "Not at all."}, {"start": 10.35, "end": 11.611, "text": "This is your appointment."}, {"start": 12.111, "end": 13.431, "text": "What would you like to start with?"}, {"start": 13.872, "end": 15.912, "text": "Well, I have had my flu vaccination."}, {"start": 16.353, "end": 16.713, "text": "Good."}, {"start": 17.013, "end": 18.093, "text": "Thank you for telling me."}, {"start": 18.513, "end": 19.654, "text": "That is worth knowing."}, {"start": 20.134, "end": 22.335, "text": "I did wonder whether it mattered for the diabetes."}, {"start": 22.875, "end": 25.016, "text": "It is part of the routine care, yes."}, {"start": 25.696, "end": 28.578, "text": "Now, there are a couple of things I would like to check today."}, {"start": 28.978, "end": 29.378, "text": "Of course."}, {"start": 29.898, "end": 30.598, "text": "Is something wrong?"}, {"start": 31.219, "end": 32.299, "text": "Nothing that I know of."}, {"start": 32.68, "end": 34.14, "text": "These are the usual checks."}, {"start": 34.841, "end": 36.522, "text": "Let us start with your blood pressure."}, {"start": 36.962, "end": 37.362, "text": "All right."}, {"start": 37.942, "end": 38.443, "text": "Thank you."}, {"start": 38.863, "end": 40.384, "text": "Your blood pressure is normal."}, {"start": 40.924, "end": 41.324, "text": "Oh, good."}, {"start": 41.644, "end": 42.405, "text": "That is a relief."}, {"start": 42.965, "end": 44.786, "text": "Now, may I take a look at your feet?"}, {"start": 45.206, "end": 45.487, "text": "Yes."}, {"start": 45.807, "end": 46.947, "text": "Should I take off my socks?"}, {"start": 47.368, "end": 47.988, "text": "Please do."}, {"start": 48.188, "end": 49.289, "text": "It only takes a moment."}, {"start": 49.829, "end": 50.369, "text": "There you are."}, {"start": 50.81, "end": 51.31, "text": "Thank you."}, {"start": 51.61, "end": 52.751, "text": "Your feet are normal."}, {"start": 53.171, "end": 54.692, "text": "The examination is fine."}, {"start": 55.172, "end": 56.313, "text": "Nothing wrong there either?"}, {"start": 56.793, "end": 57.213, "text": "Nothing."}, {"start": 57.513, "end": 58.794, "text": "Both checks are normal."}, {"start": 59.222, "end": 60.063, "text": "That is good to hear."}, {"start": 60.563, "end": 61.804, "text": "I do worry about my feet."}, {"start": 62.324, "end": 63.525, "text": "That is understandable."}, {"start": 63.985, "end": 65.967, "text": "And it is exactly why we look at them."}, {"start": 66.307, "end": 67.428, "text": "Today they are fine."}, {"start": 67.888, "end": 68.328, "text": "Thank you."}, {"start": 68.848, "end": 71.11, "text": "Overall, your diabetes looks stable."}, {"start": 71.53, "end": 73.612, "text": "There is nothing here that needs changing."}, {"start": 74.072, "end": 74.512, "text": "Stable?"}, {"start": 74.913, "end": 75.953, "text": "So I'm doing all right?"}, {"start": 76.414, "end": 76.914, "text": "You are."}, {"start": 77.234, "end": 78.715, "text": "That is my assessment today."}, {"start": 79.596, "end": 79.856, "text": "Good."}, {"start": 80.436, "end": 84.519, "text": "The plan is continued monitoring, with your annual check as usual."}, {"start": 84.879, "end": 86.22, "text": "Does that sound all right to you?"}, {"start": 86.56, "end": 86.861, "text": "Yes."}, {"start": 87.161, "end": 88.842, "text": "I like knowing when things get looked at."}, {"start": 89.27, "end": 90.631, "text": "Then that is what we will do."}, {"start": 91.231, "end": 92.751, "text": "Any questions about the plan?"}, {"start": 93.272, "end": 94.852, "text": "No, I think I understand it."}, {"start": 95.432, "end": 95.792, "text": "Good."}, {"start": 96.573, "end": 98.273, "text": "It is a bright morning out there."}, {"start": 98.874, "end": 101.815, "text": "The birds were all over the car park when I arrived."}, {"start": 102.515, "end": 103.435, "text": "I noticed them too."}, {"start": 103.976, "end": 106.036, "text": "We get a lot of them in the garden at this time of year."}, {"start": 106.697, "end": 108.437, "text": "It is a nice thing to look at."}, {"start": 109.077, "end": 109.358, "text": "It is."}, {"start": 110.478, "end": 112.599, "text": "Then we are finished for today, Nana."}, {"start": 113.139, "end": 113.699, "text": "Take care."}, {"start": 114.359, "end": 115.1, "text": "Thank you, Doctor."}, {"start": 115.3, "end": 115.7, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.268}}