nd": 99.535}, {"i": 300, "text": "for", "start": 99.595, "end": 99.775}, {"i": 301, "text": "a", "start": 99.815, "end": 99.855}, {"i": 302, "text": "week.", "start": 99.915, "end": 100.196}, {"i": 303, "text": "Take", "start": 101.458, "end": 101.638}, {"i": 304, "text": "care.", "start": 101.678, "end": 101.898}, {"i": 305, "text": "Pernille.", "start": 102.479, "end": 102.86}], "segments": [{"start": 0.13, "end": 1.31, "text": "Pernille, come in."}, {"start": 1.971, "end": 3.131, "text": "Sorry about the wait out there."}, {"start": 3.731, "end": 4.711, "text": "It was not too bad."}, {"start": 4.951, "end": 5.932, "text": "Maybe 20 minutes?"}, {"start": 6.812, "end": 8.092, "text": "I did not really mind, though."}, {"start": 8.232, "end": 9.473, "text": "I was fretting the whole time."}, {"start": 9.953, "end": 11.493, "text": "Then let us get straight to it."}, {"start": 12.193, "end": 13.074, "text": "What is troubling you?"}, {"start": 13.554, "end": 14.594, "text": "It is my big toe."}, {"start": 15.314, "end": 19.455, "text": "I pricked it on a thorn about two weeks ago, and now I think it has become infected."}, {"start": 19.975, "end": 20.916, "text": "Two weeks ago?"}, {"start": 20.936, "end": 22.136, "text": "On a thorn?"}, {"start": 23.116, "end": 23.556, "text": "Thank you."}, {"start": 23.916, "end": 24.617, "text": "That is helpful."}, {"start": 25.177, "end": 27.477, "text": "Is it bad that it took me two weeks to come in?"}, {"start": 28.078, "end": 29.238, "text": "Should I have been here sooner?"}, {"start": 29.726, "end": 32.108, "text": "You are here now, and that is what matters."}, {"start": 32.989, "end": 35.03, "text": "There is no foreign body left in the toe."}, {"start": 35.671, "end": 38.093, "text": "So no piece of the thorn is still stuck inside?"}, {"start": 38.693, "end": 40.054, "text": "That is what I kept imagining."}, {"start": 40.515, "end": 40.735, "text": "No."}, {"start": 41.375, "end": 42.636, "text": "Nothing has been left behind."}, {"start": 43.517, "end": 43.937, "text": "All right."}, {"start": 44.658, "end": 46.019, "text": "Then what is it exactly?"}, {"start": 46.62, "end": 49.142, "text": "It is an infection following the penetrating injury."}, {"start": 49.642, "end": 53.025, "text": "The thorn broke the skin, and the infection came after that."}, {"start": 53.545, "end": 54.306, "text": "An infection?"}, {"start": 54.946, "end": 56.968, "text": "That sounds serious when you put it that way."}, {"start": 57.668, "end": 59.33, "text": "I keep going back to it in my head."}, {"start": 59.91, "end": 60.871, "text": "I hear the worry."}, {"start": 61.791, "end": 65.893, "text": "Let me tell you what we are doing about it, and then you say if anything is unclear."}, {"start": 66.334, "end": 67.354, "text": "Yes, please do."}, {"start": 67.915, "end": 69.536, "text": "We are treating it with penicillin."}, {"start": 69.996, "end": 70.736, "text": "Penicillin."}, {"start": 71.196, "end": 72.557, "text": "And that is enough on its own?"}, {"start": 73.258, "end": 75.199, "text": "I keep thinking it must need more than that."}, {"start": 75.739, "end": 77.16, "text": "That is the treatment for this."}, {"start": 77.88, "end": 80.482, "text": "I have also given you a tetanus vaccination today."}, {"start": 80.942, "end": 81.442, "text": "Tetanus."}, {"start": 81.682, "end": 82.643, "text": "Because of the thorn."}, {"start": 83.003, "end": 83.283, "text": "Right."}, {"start": 83.884, "end": 85.104, "text": "I had not even thought of that."}, {"start": 85.665, "end": 86.925, "text": "So that is covered as well?"}, {"start": 87.426, "end": 87.746, "text": "It is."}, {"start": 88.658, "end": 92.103, "text": "Is that clear, or is there anything you would like to go over again?"}, {"start": 92.624, "end": 93.966, "text": "No, I think I have it now."}, {"start": 94.267, "end": 94.747, "text": "Thank you."}, {"start": 95.589, "end": 97.872, "text": "I might leave the gardening alone for a little while."}, {"start": 98.253, "end": 100.196, "text": "Perhaps stick to the reading for a week."}, {"start": 101.458, "end": 101.898, "text": "Take care."}, {"start": 102.479, "end": 102.86, "text": "Pernille."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.12}}