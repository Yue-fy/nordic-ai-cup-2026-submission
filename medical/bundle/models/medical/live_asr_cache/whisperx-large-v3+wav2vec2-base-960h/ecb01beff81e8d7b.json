9}, {"i": 232, "text": "and", "start": 82.789, "end": 82.889}, {"i": 233, "text": "plenty", "start": 82.949, "end": 83.249}, {"i": 234, "text": "of", "start": 83.269, "end": 83.329}, {"i": 235, "text": "fluids.", "start": 83.369, "end": 83.789}, {"i": 236, "text": "No", "start": 84.309, "end": 84.449}, {"i": 237, "text": "antibiotics", "start": 84.529, "end": 85.229}, {"i": 238, "text": "are", "start": 85.269, "end": 85.369}, {"i": 239, "text": "needed", "start": 85.409, "end": 85.689}, {"i": 240, "text": "because", "start": 85.809, "end": 86.09}, {"i": 241, "text": "they", "start": 86.13, "end": 86.25}, {"i": 242, "text": "do", "start": 86.29, "end": 86.37}, {"i": 243, "text": "not", "start": 86.43, "end": 86.59}, {"i": 244, "text": "work", "start": 86.63, "end": 86.83}, {"i": 245, "text": "against", "start": 86.89, "end": 87.17}, {"i": 246, "text": "a", "start": 87.21, "end": 87.25}, {"i": 247, "text": "virus.", "start": 87.27, "end": 87.69}, {"i": 248, "text": "so", "start": 88.454, "end": 88.614}, {"i": 249, "text": "I", "start": 88.694, "end": 88.754}, {"i": 250, "text": "manage", "start": 88.814, "end": 89.095}, {"i": 251, "text": "it", "start": 89.135, "end": 89.175}, {"i": 252, "text": "myself", "start": 89.215, "end": 89.655}, {"i": 253, "text": "at", "start": 89.735, "end": 89.795}, {"i": 254, "text": "home.", "start": 89.855, "end": 90.095}, {"i": 255, "text": "Exactly.", "start": 90.956, "end": 91.536}, {"i": 256, "text": "Self-care", "start": 91.997, "end": 92.537}, {"i": 257, "text": "is", "start": 92.677, "end": 92.757}, {"i": 258, "text": "the", "start": 92.818, "end": 92.898}, {"i": 259, "text": "treatment", "start": 92.938, "end": 93.298}, {"i": 260, "text": "here.", "start": 93.338, "end": 93.538}, {"i": 261, "text": "Take", "start": 93.998, "end": 94.199}, {"i": 262, "text": "care,", "start": 94.239, "end": 94.539}, {"i": 263, "text": "and", "start": 94.779, "end": 94.879}, {"i": 264, "text": "I", "start": 94.919, "end": 94.979}, {"i": 265, "text": "hope", "start": 95.019, "end": 95.199}, {"i": 266, "text": "it", "start": 95.239, "end": 95.319}, {"i": 267, "text": "settles", "start": 95.339, "end": 95.64}, {"i": 268, "text": "soon.", "start": 95.68, "end": 95.92}], "segments": [{"start": 0.054, "end": 1.435, "text": "Good morning, Jonas Cruz."}, {"start": 1.975, "end": 3.436, "text": "Good morning, Dr. Winther."}, {"start": 3.857, "end": 5.658, "text": "We have not met before, so welcome."}, {"start": 6.018, "end": 6.719, "text": "Please sit down."}, {"start": 7.239, "end": 7.639, "text": "Thank you."}, {"start": 8.48, "end": 10.801, "text": "The check-in screen at reception took me two goes."}, {"start": 12.262, "end": 13.623, "text": "You are in good company there."}, {"start": 14.024, "end": 16.385, "text": "It is not quite as intuitive as it believes it is."}, {"start": 16.966, "end": 17.766, "text": "I got there in the end."}, {"start": 18.427, "end": 18.767, "text": "Good."}, {"start": 19.127, "end": 20.668, "text": "Let me tell you how I will run this."}, {"start": 21.228, "end": 22.429, "text": "First, what brings you here."}, {"start": 22.769, "end": 23.85, "text": "Then I will examine you."}, {"start": 24.251, "end": 25.892, "text": "Then my assessment and the plan."}, {"start": 26.452, "end": 27.152, "text": "That works for me."}, {"start": 27.813, "end": 29.174, "text": "So, what has been going on?"}, {"start": 29.842, "end": 32.043, "text": "A sore throat, and I have been tired."}, {"start": 32.403, "end": 33.103, "text": "A few days now."}, {"start": 33.844, "end": 35.965, "text": "A few days of sore throat and tiredness."}, {"start": 36.465, "end": 38.105, "text": "Is there anything you would connect it to?"}, {"start": 38.746, "end": 39.606, "text": "Not really, no."}, {"start": 40.226, "end": 42.607, "text": "Do you know of any exposure to COVID-19?"}, {"start": 43.088, "end": 44.548, "text": "Anyone around you who has had it?"}, {"start": 45.128, "end": 46.409, "text": "No, none that I know of."}, {"start": 47.149, "end": 47.569, "text": "Thank you."}, {"start": 47.95, "end": 50.271, "text": "I will look at your throat now and check your temperature."}, {"start": 51.031, "end": 51.431, "text": "Go ahead."}, {"start": 52.331, "end": 55.673, "text": "Your throat is slightly red, just mild redness at the back."}, {"start": 56.353, "end": 56.593, "text": "Right."}, {"start": 57.393, "end": 58.454, "text": "And you have no fever."}, {"start": 58.902, "end": 63.283, "text": "The word we use is efebrile, which simply means your temperature is not raised."}, {"start": 63.963, "end": 64.464, "text": "Understood."}, {"start": 65.144, "end": 69.805, "text": "So my assessment is that this is most likely a viral upper respiratory infection."}, {"start": 70.245, "end": 71.726, "text": "Likely, rather than certain."}, {"start": 72.386, "end": 74.146, "text": "Viral, so not bacterial."}, {"start": 74.886, "end": 78.327, "text": "That is the distinction, yes, and it matters for what comes next."}, {"start": 78.868, "end": 79.968, "text": "Is that clear so far?"}, {"start": 80.608, "end": 80.948, "text": "It is."}, {"start": 81.628, "end": 83.789, "text": "The plan is rest and plenty of fluids."}, {"start": 84.309, "end": 87.69, "text": "No antibiotics are needed because they do not work against a virus."}, {"start": 88.454, "end": 90.095, "text": "so I manage it myself at home."}, {"start": 90.956, "end": 91.536, "text": "Exactly."}, {"start": 91.997, "end": 93.538, "text": "Self-care is the treatment here."}, {"start": 93.998, "end": 95.92, "text": "Take care, and I hope it settles soon."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.946}}