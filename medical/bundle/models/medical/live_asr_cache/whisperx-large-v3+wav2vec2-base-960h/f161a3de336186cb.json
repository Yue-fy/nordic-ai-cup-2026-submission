 72.197, "end": 72.337}, {"i": 198, "text": "So", "start": 72.997, "end": 73.218}, {"i": 199, "text": "nothing", "start": 73.318, "end": 73.598}, {"i": 200, "text": "changes.", "start": 73.678, "end": 74.098}, {"i": 201, "text": "I", "start": 74.658, "end": 74.738}, {"i": 202, "text": "keep", "start": 74.778, "end": 74.978}, {"i": 203, "text": "going", "start": 75.018, "end": 75.298}, {"i": 204, "text": "as", "start": 75.358, "end": 75.458}, {"i": 205, "text": "I", "start": 75.518, "end": 75.578}, {"i": 206, "text": "am", "start": 75.738, "end": 75.838}, {"i": 207, "text": "and", "start": 76.018, "end": 76.118}, {"i": 208, "text": "come", "start": 76.178, "end": 76.318}, {"i": 209, "text": "back", "start": 76.358, "end": 76.538}, {"i": 210, "text": "for", "start": 76.578, "end": 76.678}, {"i": 211, "text": "the", "start": 76.698, "end": 76.778}, {"i": 212, "text": "next", "start": 76.818, "end": 77.018}, {"i": 213, "text": "check.", "start": 77.078, "end": 77.338}, {"i": 214, "text": "Correct.", "start": 77.939, "end": 78.319}, {"i": 215, "text": "What", "start": 78.839, "end": 78.939}, {"i": 216, "text": "are", "start": 78.959, "end": 79.039}, {"i": 217, "text": "you", "start": 79.059, "end": 79.139}, {"i": 218, "text": "doing", "start": 79.159, "end": 79.339}, {"i": 219, "text": "with", "start": 79.359, "end": 79.459}, {"i": 220, "text": "the", "start": 79.499, "end": 79.559}, {"i": 221, "text": "rest", "start": 79.599, "end": 79.759}, {"i": 222, "text": "of", "start": 79.799, "end": 79.839}, {"i": 223, "text": "your", "start": 79.879, "end": 79.979}, {"i": 224, "text": "day?", "start": 80.019, "end": 80.219}, {"i": 225, "text": "Back", "start": 80.859, "end": 81.039}, {"i": 226, "text": "to", "start": 81.079, "end": 81.159}, {"i": 227, "text": "work,", "start": 81.199, "end": 81.439}, {"i": 228, "text": "then", "start": 81.819, "end": 82.039}, {"i": 229, "text": "something", "start": 82.099, "end": 82.42}, {"i": 230, "text": "quiet", "start": 82.5, "end": 82.84}, {"i": 231, "text": "this", "start": 82.88, "end": 83.0}, {"i": 232, "text": "evening.", "start": 83.08, "end": 83.34}, {"i": 233, "text": "Thank", "start": 83.84, "end": 84.0}, {"i": 234, "text": "you,", "start": 84.02, "end": 84.12}, {"i": 235, "text": "doctor.", "start": 84.14, "end": 84.44}], "segments": [{"start": 0.034, "end": 0.514, "text": "Good morning."}, {"start": 0.894, "end": 1.935, "text": "I'm Dr. Overgaard."}, {"start": 2.155, "end": 2.815, "text": "Please sit down."}, {"start": 3.595, "end": 3.935, "text": "Thank you."}, {"start": 4.435, "end": 5.055, "text": "Christian Lund."}, {"start": 5.396, "end": 5.976, "text": "Good to meet you."}, {"start": 6.476, "end": 7.016, "text": "Likewise."}, {"start": 7.336, "end": 8.356, "text": "Did you wait long out there?"}, {"start": 8.897, "end": 9.397, "text": "A few minutes."}, {"start": 9.917, "end": 12.478, "text": "Long enough to read half an article about kitchen renovations."}, {"start": 13.078, "end": 15.518, "text": "The magazines out there are famously out of date."}, {"start": 16.299, "end": 16.799, "text": "I noticed."}, {"start": 17.219, "end": 18.619, "text": "Some of them are older than my car."}, {"start": 19.199, "end": 20.66, "text": "We keep meaning to replace them."}, {"start": 21.32, "end": 23.441, "text": "So, this is your diabetes review."}, {"start": 24.021, "end": 24.281, "text": "Yes."}, {"start": 24.821, "end": 27.082, "text": "I have been a little nervous about it, to be honest."}, {"start": 27.682, "end": 28.182, "text": "Understood."}, {"start": 28.77, "end": 30.391, "text": "How have you been feeling in yourself?"}, {"start": 31.011, "end": 33.132, "text": "Well, actually, I feel fine."}, {"start": 33.673, "end": 35.754, "text": "That is partly why the nerves seem silly."}, {"start": 36.374, "end": 37.255, "text": "They are not silly."}, {"start": 37.715, "end": 39.576, "text": "Feeling well is useful information."}, {"start": 40.177, "end": 40.417, "text": "Good."}, {"start": 40.897, "end": 41.978, "text": "So what did you find today?"}, {"start": 42.578, "end": 45.54, "text": "Your blood pressure is normal and your foot status is normal."}, {"start": 46.1, "end": 46.82, "text": "Both normal."}, {"start": 47.381, "end": 48.721, "text": "And you are sure about the feet?"}, {"start": 49.362, "end": 49.702, "text": "I am."}, {"start": 50.142, "end": 51.563, "text": "There is nothing abnormal there."}, {"start": 52.824, "end": 53.064, "text": "Right."}, {"start": 53.544, "end": 55.285, "text": "That was the thing I worried about most."}, {"start": 55.986, "end": 56.666, "text": "Understandable."}, {"start": 57.254, "end": 60.755, "text": "Overall, your diabetes is stable with no signs of complications."}, {"start": 61.475, "end": 62.655, "text": "No complications at all?"}, {"start": 63.275, "end": 63.515, "text": "None."}, {"start": 63.955, "end": 65.196, "text": "That is my assessment today."}, {"start": 65.796, "end": 67.696, "text": "It is a relief to hear it said plainly."}, {"start": 68.256, "end": 72.337, "text": "The plan is to continue your checkups and carry on with your lifestyle as you are."}, {"start": 72.997, "end": 74.098, "text": "So nothing changes."}, {"start": 74.658, "end": 77.338, "text": "I keep going as I am and come back for the next check."}, {"start": 77.939, "end": 78.319, "text": "Correct."}, {"start": 78.839, "end": 80.219, "text": "What are you doing with the rest of your day?"}, {"start": 80.859, "end": 83.34, "text": "Back to work, then something quiet this evening."}, {"start": 83.84, "end": 84.44, "text": "Thank you, doctor."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.764}}