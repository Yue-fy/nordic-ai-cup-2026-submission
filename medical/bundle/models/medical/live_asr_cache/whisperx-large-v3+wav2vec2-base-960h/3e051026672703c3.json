tart": 113.192, "end": 113.332}, {"i": 299, "text": "today.", "start": 113.412, "end": 113.792}, {"i": 300, "text": "And", "start": 113.812, "end": 114.653}, {"i": 301, "text": "if", "start": 114.693, "end": 114.753}, {"i": 302, "text": "it", "start": 114.793, "end": 114.853}, {"i": 303, "text": "is", "start": 114.893, "end": 114.973}, {"i": 304, "text": "exactly", "start": 115.033, "end": 115.394}, {"i": 305, "text": "the", "start": 115.434, "end": 115.514}, {"i": 306, "text": "same", "start": 115.554, "end": 115.754}, {"i": 307, "text": "then?", "start": 115.814, "end": 115.954}, {"i": 308, "text": "If", "start": 116.998, "end": 117.078}, {"i": 309, "text": "it", "start": 117.138, "end": 117.198}, {"i": 310, "text": "is", "start": 117.238, "end": 117.318}, {"i": 311, "text": "unchanged", "start": 117.458, "end": 118.019}, {"i": 312, "text": "at", "start": 118.079, "end": 118.159}, {"i": 313, "text": "that", "start": 118.199, "end": 118.379}, {"i": 314, "text": "point,", "start": 118.459, "end": 118.78}, {"i": 315, "text": "I", "start": 119.26, "end": 119.3}, {"i": 316, "text": "will", "start": 119.32, "end": 119.48}, {"i": 317, "text": "refer", "start": 119.52, "end": 119.86}, {"i": 318, "text": "you", "start": 119.921, "end": 120.041}, {"i": 319, "text": "for", "start": 120.101, "end": 120.221}, {"i": 320, "text": "an", "start": 120.281, "end": 120.341}, {"i": 321, "text": "ultrasound", "start": 120.441, "end": 121.021}, {"i": 322, "text": "scan", "start": 121.061, "end": 121.462}, {"i": 323, "text": "so", "start": 121.522, "end": 121.682}, {"i": 324, "text": "we", "start": 121.702, "end": 121.802}, {"i": 325, "text": "can", "start": 121.842, "end": 122.002}, {"i": 326, "text": "see", "start": 122.062, "end": 122.262}, {"i": 327, "text": "what", "start": 122.322, "end": 122.483}, {"i": 328, "text": "it", "start": 122.523, "end": 122.563}, {"i": 329, "text": "is", "start": 122.643, "end": 122.723}, {"i": 330, "text": "made", "start": 122.783, "end": 123.003}, {"i": 331, "text": "of.", "start": 123.083, "end": 123.183}, {"i": 332, "text": "That", "start": 123.924, "end": 124.064}, {"i": 333, "text": "is", "start": 124.104, "end": 124.184}, {"i": 334, "text": "clear.", "start": 124.244, "end": 124.524}, {"i": 335, "text": "A", "start": 125.105, "end": 125.145}, {"i": 336, "text": "check", "start": 125.185, "end": 125.365}, {"i": 337, "text": "in", "start": 125.385, "end": 125.485}, {"i": 338, "text": "six", "start": 125.525, "end": 125.725}, {"i": 339, "text": "weeks", "start": 125.765, "end": 126.006}, {"i": 340, "text": "and", "start": 126.446, "end": 126.546}, {"i": 341, "text": "a", "start": 126.566, "end": 126.606}, {"i": 342, "text": "scan", "start": 126.646, "end": 126.946}, {"i": 343, "text": "if", "start": 126.986, "end": 127.046}, {"i": 344, "text": "nothing", "start": 127.106, "end": 127.347}, {"i": 345, "text": "has", "start": 127.367, "end": 127.487}, {"i": 346, "text": "moved.", "start": 127.527, "end": 127.847}, {"i": 347, "text": "Exactly", "start": 128.908, "end": 129.368}, {"i": 348, "text": "that.", "start": 129.408, "end": 129.649}, {"i": 349, "text": "Is", "start": 130.229, "end": 130.289}, {"i": 350, "text": "there", "start": 130.329, "end": 130.469}, {"i": 351, "text": "anything", "start": 130.569, "end": 130.93}, {"i": 352, "text": "you", "start": 130.99, "end": 131.07}, {"i": 353, "text": "would", "start": 131.11, "end": 131.25}, {"i": 354, "text": "like", "start": 131.29, "end": 131.49}, {"i": 355, "text": "me", "start": 131.53, "end": 131.65}, {"i": 356, "text": "to", "start": 131.69, "end": 131.79}, {"i": 357, "text": "repeat?", "start": 131.85, "end": 132.231}, {"i": 358, "text": "No,", "start": 133.051, "end": 133.232}, {"i": 359, "text": "I", "start": 133.412, "end": 133.472}, {"i": 360, "text": "have", "start": 133.512, "end": 133.692}, {"i": 361, "text": "it.", "start": 133.732, "end": 133.832}, {"i": 362, "text": "Thank", "start": 134.352, "end": 134.553}, {"i": 363, "text": "you.", "start": 134.593, "end": 134.753}, {"i": 364, "text": "Then", "start": 135.954, "end": 136.114}, {"i": 365, "text": "you", "start": 136.174, "end": 136.274}, {"i": 366, "text": "are", "start": 136.334, "end": 136.454}, {"i": 367, "text": "free.", "start": 136.534, "end": 136.835}, {"i": 368, "text": "Do", "start": 137.395, "end": 137.475}, {"i": 369, "text": "you", "start": 137.515, "end": 137.595}, {"i": 370, "text": "have", "start": 137.635, "end": 137.735}, {"i": 371, "text": "plans", "start": 137.795, "end": 138.096}, {"i": 372, "text": "for", "start": 138.136, "end": 138.236}, {"i": 373, "text": "the", "start": 138.276, "end": 138.356}, {"i": 374, "text": "rest", "start": 138.396, "end": 138.596}, {"i": 375, "text": "of", "start": 138.636, "end": 138.696}, {"i": 376, "text": "the", "start": 138.716, "end": 138.796}, {"i": 377, "text": "day?", "start": 138.836, "end": 139.076}, {"i": 378, "text": "Only", "start": 140.197, "end": 140.438}, {"i": 379, "text": "unpacking", "start": 140.518, "end": 140.958}, {"i": 380, "text": "the", "start": 140.978, "end": 141.058}, {"i": 381, "text": "shopping.", "start": 141.098, "end": 141.478}, {"i": 382, "text": "Goodbye", "start": 142.199, "end": 142.619}, {"i": 383, "text": "and", "start": 142.86, "end": 142.94}, {"i": 384, "text": "thank", "start": 142.98, "end": 143.18}, {"i": 385, "text": "you.", "start": 143.22, "end": 143.34}], "segments": [{"start": 0.066, "end": 0.566, "text": "Good morning."}, {"start": 1.046, "end": 1.947, "text": "I am Dr. Hjort."}, {"start": 2.567, "end": 5.708, "text": "We have not met before, so could you confirm your name for me?"}, {"start": 7.008, "end": 7.848, "text": "Lona Everson."}, {"start": 8.308, "end": 8.748, "text": "Good morning."}, {"start": 9.589, "end": 10.349, "text": "Thank you, Lona."}, {"start": 10.749, "end": 11.889, "text": "Please, have a seat."}, {"start": 12.589, "end": 13.95, "text": "Did you get here without trouble?"}, {"start": 15.03, "end": 15.27, "text": "Yes."}, {"start": 15.61, "end": 18.391, "text": "I stopped at the supermarket first, which was a mistake."}, {"start": 19.051, "end": 19.671, "text": "It was packed."}, {"start": 20.832, "end": 22.312, "text": "It usually is at this hour."}, {"start": 23.052, "end": 25.213, "text": "I have learned to go late in the evening instead."}, {"start": 26.393, "end": 27.254, "text": "I will remember that."}, {"start": 28.334, "end": 28.554, "text": "Good."}, {"start": 29.554, "end": 33.897, "text": "Now, you are booked in today for removal of a skin change under your breast."}, {"start": 34.398, "end": 34.918, "text": "Is that right?"}, {"start": 36.099, "end": 36.679, "text": "That is right."}, {"start": 37.28, "end": 38.641, "text": "That is the main reason I am here."}, {"start": 39.841, "end": 40.982, "text": "Then we will get that done."}, {"start": 41.923, "end": 44.425, "text": "Is there anything else you want me to look at while you are here?"}, {"start": 45.626, "end": 46.486, "text": "There is, actually."}, {"start": 47.347, "end": 49.228, "text": "I can feel a lump on my left forearm."}, {"start": 50.469, "end": 51.59, "text": "Thank you for mentioning it."}, {"start": 52.19, "end": 55.533, "text": "Let us take the removal first, and then I will feel the forearm."}, {"start": 56.753, "end": 57.374, "text": "That suits me."}, {"start": 58.622, "end": 60.923, "text": "I am working under sterile conditions for this."}, {"start": 61.664, "end": 63.725, "text": "Let me know if anything feels uncomfortable."}, {"start": 65.006, "end": 65.846, "text": "So far, so good."}, {"start": 67.047, "end": 67.327, "text": "There."}, {"start": 67.687, "end": 68.888, "text": "The skin change is off."}, {"start": 69.628, "end": 72.39, "text": "That was a skin wart, and it has now been removed."}, {"start": 73.571, "end": 75.032, "text": "That was quicker than I expected."}, {"start": 76.332, "end": 77.173, "text": "They usually are."}, {"start": 77.833, "end": 80.275, "text": "Now let me feel that lump on your left forearm."}, {"start": 81.595, "end": 83.396, "text": "It is just here, under my thumb."}, {"start": 84.637, "end": 85.778, "text": "I can feel it clearly."}, {"start": 86.534, "end": 94.039, "text": "It could be a fatty lump, what we call a lipoma, or it could be a collection of blood under the skin, a hematoma."}, {"start": 95.32, "end": 96.721, "text": "Which of the two do you think it is?"}, {"start": 98.062, "end": 99.643, "text": "I cannot separate them today."}, {"start": 100.303, "end": 106.287, "text": "What I can say is that this looks like a possible benign change, meaning not a dangerous one."}, {"start": 107.668, "end": 108.629, "text": "So what happens with it?"}, {"start": 108.749, "end": 109.77, "text": "We wait and see."}, {"start": 110.31, "end": 113.792, "text": "I would like to check it again in six weeks and compare it with today."}, {"start": 113.812, "end": 115.954, "text": "And if it is exactly the same then?"}, {"start": 116.998, "end": 123.183, "text": "If it is unchanged at that point, I will refer you for an ultrasound scan so we can see what it is made of."}, {"start": 123.924, "end": 124.524, "text": "That is clear."}, {"start": 125.105, "end": 127.847, "text": "A check in six weeks and a scan if nothing has moved."}, {"start": 128.908, "end": 129.649, "text": "Exactly that."}, {"start": 130.229, "end": 132.231, "text": "Is there anything you would like me to repeat?"}, {"start": 133.051, "end": 133.832, "text": "No, I have it."}, {"start": 134.352, "end": 134.753, "text": "Thank you."}, {"start": 135.954, "end": 136.835, "text": "Then you are free."}, {"start": 137.395, "end": 139.076, "text": "Do you have plans for the rest of the day?"}, {"start": 140.197, "end": 141.478, "text": "Only unpacking the shopping."}, {"start": 142.199, "end": 143.34, "text": "Goodbye and thank you."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.566}}