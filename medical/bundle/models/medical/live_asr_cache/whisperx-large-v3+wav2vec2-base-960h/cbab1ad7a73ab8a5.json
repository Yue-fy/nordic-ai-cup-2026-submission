 "text": "it", "start": 123.212, "end": 123.272}, {"i": 298, "text": "is.", "start": 123.392, "end": 123.552}, {"i": 299, "text": "Any", "start": 124.433, "end": 124.573}, {"i": 300, "text": "questions", "start": 124.633, "end": 125.053}, {"i": 301, "text": "about", "start": 125.093, "end": 125.293}, {"i": 302, "text": "taking", "start": 125.333, "end": 125.653}, {"i": 303, "text": "it?", "start": 125.693, "end": 125.753}, {"i": 304, "text": "No,", "start": 126.613, "end": 126.833}, {"i": 305, "text": "that", "start": 127.134, "end": 127.294}, {"i": 306, "text": "is", "start": 127.354, "end": 127.454}, {"i": 307, "text": "clear", "start": 127.514, "end": 127.754}, {"i": 308, "text": "enough", "start": 127.794, "end": 128.014}, {"i": 309, "text": "for", "start": 128.054, "end": 128.174}, {"i": 310, "text": "me.", "start": 128.214, "end": 128.474}, {"i": 311, "text": "Then", "start": 129.394, "end": 129.594}, {"i": 312, "text": "we", "start": 129.834, "end": 129.955}, {"i": 313, "text": "are", "start": 129.995, "end": 130.095}, {"i": 314, "text": "finished", "start": 130.135, "end": 130.455}, {"i": 315, "text": "here.", "start": 130.475, "end": 130.695}, {"i": 316, "text": "Anything", "start": 131.635, "end": 131.995}, {"i": 317, "text": "nice", "start": 132.095, "end": 132.375}, {"i": 318, "text": "planned", "start": 132.455, "end": 132.715}, {"i": 319, "text": "for", "start": 132.755, "end": 132.836}, {"i": 320, "text": "the", "start": 132.856, "end": 132.936}, {"i": 321, "text": "rest", "start": 132.976, "end": 133.156}, {"i": 322, "text": "of", "start": 133.176, "end": 133.236}, {"i": 323, "text": "the", "start": 133.276, "end": 133.356}, {"i": 324, "text": "day?", "start": 133.376, "end": 133.576}, {"i": 325, "text": "If", "start": 134.636, "end": 134.716}, {"i": 326, "text": "it", "start": 134.776, "end": 134.836}, {"i": 327, "text": "stays", "start": 134.876, "end": 135.196}, {"i": 328, "text": "dry,", "start": 135.256, "end": 135.636}, {"i": 329, "text": "I", "start": 135.656, "end": 135.677}, {"i": 330, "text": "will", "start": 136.277, "end": 136.417}, {"i": 331, "text": "take", "start": 136.457, "end": 136.617}, {"i": 332, "text": "the", "start": 136.637, "end": 136.737}, {"i": 333, "text": "bicycle", "start": 136.777, "end": 137.297}, {"i": 334, "text": "out", "start": 137.357, "end": 137.497}, {"i": 335, "text": "for", "start": 137.537, "end": 137.677}, {"i": 336, "text": "a", "start": 137.717, "end": 137.737}, {"i": 337, "text": "bit.", "start": 137.777, "end": 137.997}, {"i": 338, "text": "That", "start": 138.858, "end": 139.038}, {"i": 339, "text": "sounds", "start": 139.118, "end": 139.378}, {"i": 340, "text": "like", "start": 139.418, "end": 139.578}, {"i": 341, "text": "a", "start": 139.598, "end": 139.638}, {"i": 342, "text": "good", "start": 139.678, "end": 139.838}, {"i": 343, "text": "way", "start": 139.878, "end": 140.018}, {"i": 344, "text": "to", "start": 140.058, "end": 140.138}, {"i": 345, "text": "spend", "start": 140.178, "end": 140.398}, {"i": 346, "text": "the", "start": 140.438, "end": 140.518}, {"i": 347, "text": "afternoon.", "start": 140.598, "end": 141.098}, {"i": 348, "text": "Take", "start": 142.019, "end": 142.219}, {"i": 349, "text": "care,", "start": 142.279, "end": 142.499}, {"i": 350, "text": "Peter.", "start": 142.579, "end": 142.859}, {"i": 351, "text": "Thank", "start": 143.719, "end": 143.939}, {"i": 352, "text": "you,", "start": 143.959, "end": 144.099}, {"i": 353, "text": "Doctor.", "start": 144.119, "end": 144.48}, {"i": 354, "text": "Goodbye.", "start": 145.24, "end": 145.7}], "segments": [{"start": 0.034, "end": 0.534, "text": "Good morning."}, {"start": 0.934, "end": 1.854, "text": "I am Dr. Reese."}, {"start": 2.455, "end": 4.255, "text": "We have not met before, so welcome."}, {"start": 5.155, "end": 6.456, "text": "Could you confirm your name for me?"}, {"start": 7.176, "end": 7.556, "text": "Morning."}, {"start": 8.136, "end": 10.357, "text": "Yes, I am Peter Cruz."}, {"start": 11.177, "end": 12.157, "text": "Nice to meet you, Peter."}, {"start": 12.677, "end": 14.638, "text": "Please sit down and make yourself comfortable."}, {"start": 15.598, "end": 16.058, "text": "Thank you."}, {"start": 16.759, "end": 18.499, "text": "You have a lot of plants in here."}, {"start": 19.139, "end": 22.36, "text": "That big green one by the window looks very happy."}, {"start": 23.16, "end": 26.741, "text": "It has survived three winters in this room, which I take as a compliment."}, {"start": 27.742, "end": 29.182, "text": "Now, what brings you in today?"}, {"start": 29.97, "end": 30.95, "text": "It is my mouth."}, {"start": 31.791, "end": 35.452, "text": "I keep getting that white stuff in there, and it keeps coming back."}, {"start": 36.272, "end": 36.692, "text": "Thank you."}, {"start": 37.292, "end": 39.453, "text": "That sounds like a fungal infection in the mouth."}, {"start": 40.153, "end": 41.853, "text": "Has anything been tried for it before?"}, {"start": 42.874, "end": 43.214, "text": "Yes."}, {"start": 44.034, "end": 50.136, "text": "Tablets called fluconazole once, and a gel, Brenton, I think it was called."}, {"start": 51.056, "end": 52.476, "text": "And did either of those help?"}, {"start": 53.557, "end": 56.217, "text": "No, neither of them made any difference."}, {"start": 57.138, "end": 58.378, "text": "That is important to know."}, {"start": 59.39, "end": 60.831, "text": "May I have a look inside your mouth?"}, {"start": 61.751, "end": 62.992, "text": "Yes, go ahead."}, {"start": 63.912, "end": 65.032, "text": "Open wide for me, please."}, {"start": 66.453, "end": 67.634, "text": "Thank you, that is enough."}, {"start": 68.534, "end": 69.975, "text": "Does it look like anything?"}, {"start": 70.815, "end": 71.335, "text": "It does."}, {"start": 71.976, "end": 75.417, "text": "There is redness inside your mouth and there are coatings."}, {"start": 76.217, "end": 76.778, "text": "Coatings?"}, {"start": 77.638, "end": 78.999, "text": "What does that mean exactly?"}, {"start": 80.059, "end": 82.44, "text": "A whitish layer sitting on the lining of your mouth."}, {"start": 83.16, "end": 86.602, "text": "In plain words, it is the fungus growing where it should not."}, {"start": 87.602, "end": 89.623, "text": "So it is the same trouble as before?"}, {"start": 90.543, "end": 90.843, "text": "Yes."}, {"start": 91.543, "end": 97.205, "text": "Since it has kept coming back after the earlier treatments, I would call this a persistent fungal infection of the mouth."}, {"start": 98.105, "end": 101.586, "text": "Persistent means it has not really gone away, right?"}, {"start": 102.466, "end": 103.787, "text": "That is exactly it."}, {"start": 104.527, "end": 106.387, "text": "It has stayed rather than cleared."}, {"start": 107.107, "end": 108.528, "text": "Does that make sense so far?"}, {"start": 109.488, "end": 110.688, "text": "Yes, I follow you."}, {"start": 110.708, "end": 111.009, "text": "Good."}, {"start": 111.689, "end": 115.57, "text": "I will prescribe fluconazole, 50 mg, once a day for 7 days."}, {"start": 117.07, "end": 118.731, "text": "One tablet a day for a week."}, {"start": 119.951, "end": 121.392, "text": "That I can remember."}, {"start": 122.372, "end": 123.552, "text": "That is all it is."}, {"start": 124.433, "end": 125.753, "text": "Any questions about taking it?"}, {"start": 126.613, "end": 128.474, "text": "No, that is clear enough for me."}, {"start": 129.394, "end": 130.695, "text": "Then we are finished here."}, {"start": 131.635, "end": 133.576, "text": "Anything nice planned for the rest of the day?"}, {"start": 134.636, "end": 137.997, "text": "If it stays dry, I will take the bicycle out for a bit."}, {"start": 138.858, "end": 141.098, "text": "That sounds like a good way to spend the afternoon."}, {"start": 142.019, "end": 142.859, "text": "Take care, Peter."}, {"start": 143.719, "end": 144.48, "text": "Thank you, Doctor."}, {"start": 145.24, "end": 145.7, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.707}}