nd": 119.291}, {"i": 297, "text": "Nothing", "start": 120.052, "end": 120.352}, {"i": 298, "text": "at", "start": 120.412, "end": 120.452}, {"i": 299, "text": "all.", "start": 120.552, "end": 120.712}, {"i": 300, "text": "There", "start": 121.192, "end": 121.352}, {"i": 301, "text": "are", "start": 121.432, "end": 121.552}, {"i": 302, "text": "no", "start": 121.652, "end": 121.833}, {"i": 303, "text": "changes", "start": 121.913, "end": 122.293}, {"i": 304, "text": "to", "start": 122.373, "end": 122.433}, {"i": 305, "text": "make", "start": 122.493, "end": 122.673}, {"i": 306, "text": "today.", "start": 122.733, "end": 123.053}, {"i": 307, "text": "And", "start": 123.994, "end": 124.074}, {"i": 308, "text": "looking", "start": 124.114, "end": 124.414}, {"i": 309, "text": "ahead?", "start": 124.474, "end": 124.774}, {"i": 310, "text": "We", "start": 125.575, "end": 125.715}, {"i": 311, "text": "continue", "start": 125.755, "end": 126.235}, {"i": 312, "text": "with", "start": 126.255, "end": 126.395}, {"i": 313, "text": "follow-up", "start": 126.455, "end": 126.935}, {"i": 314, "text": "as", "start": 127.095, "end": 127.235}, {"i": 315, "text": "planned.", "start": 127.296, "end": 127.676}, {"i": 316, "text": "Does", "start": 128.296, "end": 128.456}, {"i": 317, "text": "that", "start": 128.496, "end": 128.616}, {"i": 318, "text": "all", "start": 128.656, "end": 128.756}, {"i": 319, "text": "make", "start": 128.796, "end": 128.936}, {"i": 320, "text": "sense", "start": 128.976, "end": 129.217}, {"i": 321, "text": "to", "start": 129.237, "end": 129.297}, {"i": 322, "text": "you?", "start": 129.337, "end": 129.497}, {"i": 323, "text": "It", "start": 130.497, "end": 130.557}, {"i": 324, "text": "does,", "start": 130.597, "end": 130.917}, {"i": 325, "text": "thank", "start": 131.078, "end": 131.338}, {"i": 326, "text": "you.", "start": 131.378, "end": 131.578}, {"i": 327, "text": "Was", "start": 132.498, "end": 132.618}, {"i": 328, "text": "that", "start": 132.658, "end": 132.778}, {"i": 329, "text": "the", "start": 132.819, "end": 132.919}, {"i": 330, "text": "first", "start": 132.939, "end": 133.199}, {"i": 331, "text": "frost", "start": 133.279, "end": 133.619}, {"i": 332, "text": "on", "start": 133.679, "end": 133.739}, {"i": 333, "text": "the", "start": 133.779, "end": 133.839}, {"i": 334, "text": "grass", "start": 133.879, "end": 134.159}, {"i": 335, "text": "this", "start": 134.219, "end": 134.359}, {"i": 336, "text": "morning,", "start": 134.419, "end": 134.74}, {"i": 337, "text": "do", "start": 134.78, "end": 134.86}, {"i": 338, "text": "you", "start": 134.9, "end": 135.0}, {"i": 339, "text": "think?", "start": 135.02, "end": 135.26}, {"i": 340, "text": "I", "start": 136.2, "end": 136.28}, {"i": 341, "text": "think", "start": 136.36, "end": 136.581}, {"i": 342, "text": "it", "start": 136.661, "end": 136.721}, {"i": 343, "text": "was.", "start": 136.801, "end": 137.201}, {"i": 344, "text": "My", "start": 137.701, "end": 137.861}, {"i": 345, "text": "windscreen", "start": 137.941, "end": 138.642}, {"i": 346, "text": "certainly", "start": 138.702, "end": 139.142}, {"i": 347, "text": "agreed", "start": 139.222, "end": 139.522}, {"i": 348, "text": "with", "start": 139.562, "end": 139.702}, {"i": 349, "text": "you.", "start": 139.742, "end": 139.942}, {"i": 350, "text": "I", "start": 140.943, "end": 141.023}, {"i": 351, "text": "scraped", "start": 141.083, "end": 141.403}, {"i": 352, "text": "mine", "start": 141.463, "end": 141.683}, {"i": 353, "text": "for", "start": 141.703, "end": 141.803}, {"i": 354, "text": "the", "start": 141.843, "end": 141.923}, {"i": 355, "text": "first", "start": 141.943, "end": 142.184}, {"i": 356, "text": "time", "start": 142.224, "end": 142.464}, {"i": 357, "text": "this", "start": 142.524, "end": 142.684}, {"i": 358, "text": "year.", "start": 142.744, "end": 142.964}, {"i": 359, "text": "Autumn", "start": 143.724, "end": 144.005}, {"i": 360, "text": "has", "start": 144.085, "end": 144.245}, {"i": 361, "text": "committed", "start": 144.305, "end": 144.665}, {"i": 362, "text": "itself.", "start": 144.725, "end": 145.105}, {"i": 363, "text": "It", "start": 146.026, "end": 146.106}, {"i": 364, "text": "has.", "start": 146.166, "end": 146.506}, {"i": 365, "text": "Take", "start": 147.294, "end": 147.474}, {"i": 366, "text": "care,", "start": 147.514, "end": 147.714}, {"i": 367, "text": "Mrs.", "start": 147.755, "end": 148.015}, {"i": 368, "text": "Cruz.", "start": 148.055, "end": 148.435}, {"i": 369, "text": "I", "start": 148.776, "end": 148.816}, {"i": 370, "text": "will", "start": 148.836, "end": 149.016}, {"i": 371, "text": "see", "start": 149.036, "end": 149.196}, {"i": 372, "text": "you", "start": 149.236, "end": 149.356}, {"i": 373, "text": "at", "start": 149.456, "end": 149.516}, {"i": 374, "text": "your", "start": 149.556, "end": 149.677}, {"i": 375, "text": "next", "start": 149.737, "end": 149.977}, {"i": 376, "text": "follow-up.", "start": 150.037, "end": 150.517}, {"i": 377, "text": "Thank", "start": 151.438, "end": 151.619}, {"i": 378, "text": "you,", "start": 151.659, "end": 151.759}, {"i": 379, "text": "Doctor.", "start": 151.779, "end": 152.159}, {"i": 380, "text": "Goodbye.", "start": 152.56, "end": 152.96}], "segments": [{"start": 0.098, "end": 0.578, "text": "Good morning."}, {"start": 1.039, "end": 1.859, "text": "I have an appointment."}, {"start": 2.34, "end": 3.22, "text": "Birta Kruse."}, {"start": 3.821, "end": 5.102, "text": "Good morning, Mrs. Kruse."}, {"start": 5.622, "end": 6.903, "text": "I am Dr. Mogensen."}, {"start": 7.183, "end": 8.264, "text": "We have not met before."}, {"start": 8.744, "end": 9.445, "text": "Please come through."}, {"start": 10.245, "end": 10.665, "text": "Thank you."}, {"start": 11.446, "end": 14.088, "text": "I did manage the self-check-in screen at reception."}, {"start": 14.648, "end": 15.289, "text": "Eventually."}, {"start": 16.189, "end": 18.771, "text": "It defeats a good number of people on the first attempt."}, {"start": 19.752, "end": 23.094, "text": "It kept asking me to confirm something I had already confirmed."}, {"start": 23.795, "end": 24.815, "text": "I got there in the end."}, {"start": 25.716, "end": 27.517, "text": "You are far from alone in that."}, {"start": 28.278, "end": 28.518, "text": "Now..."}, {"start": 28.894, "end": 30.354, "text": "Tell me what brings you in today."}, {"start": 31.395, "end": 35.256, "text": "I am here for the influenza vaccination as part of my diabetes care."}, {"start": 36.196, "end": 36.836, "text": "That is right."}, {"start": 37.436, "end": 41.357, "text": "Let me set out how we will do it, and then you can ask me anything you like."}, {"start": 42.358, "end": 42.858, "text": "Please do."}, {"start": 43.938, "end": 50.32, "text": "I will explain why it is offered, give the vaccination, and then we will look at how you are doing overall."}, {"start": 51.22, "end": 53.02, "text": "That structure suits me very well."}, {"start": 54.021, "end": 58.382, "text": "The influenza vaccination is offered routinely to people with diabetes,"}, {"start": 58.814, "end": 60.495, "text": "as part of their ongoing care."}, {"start": 61.456, "end": 62.937, "text": "That matches my understanding."}, {"start": 63.538, "end": 65.96, "text": "It is one of the standard preventive measures for us."}, {"start": 66.901, "end": 67.822, "text": "Exactly so."}, {"start": 68.482, "end": 70.023, "text": "Any questions before I give it?"}, {"start": 71.044, "end": 72.125, "text": "None that I can think of."}, {"start": 72.646, "end": 73.346, "text": "Shall we go ahead?"}, {"start": 74.287, "end": 75.088, "text": "Let us do that."}, {"start": 75.768, "end": 77.79, "text": "Small scratch and then it is finished."}, {"start": 79.291, "end": 80.152, "text": "Is that it already?"}, {"start": 81.173, "end": 81.733, "text": "That is it."}, {"start": 82.394, "end": 86.017, "text": "Now we wait a short while and then I will check how you are."}, {"start": 87.037, "end": 87.518, "text": "Sensible."}, {"start": 88.086, "end": 89.607, "text": "That is the observation period."}, {"start": 90.447, "end": 90.808, "text": "It is."}, {"start": 91.368, "end": 92.208, "text": "How are you feeling?"}, {"start": 93.169, "end": 94.55, "text": "Perfectly fine, thank you."}, {"start": 95.23, "end": 96.451, "text": "Nothing out of the ordinary."}, {"start": 97.351, "end": 99.532, "text": "And I can see no reaction at all."}, {"start": 100.053, "end": 101.233, "text": "That is what we want."}, {"start": 102.254, "end": 102.534, "text": "Good."}, {"start": 103.255, "end": 104.475, "text": "Nothing on my side either."}, {"start": 105.456, "end": 109.058, "text": "Then my assessment is that there are no acute problems today."}, {"start": 110.038, "end": 112.82, "text": "And my diabetes itself, how would you describe it?"}, {"start": 112.98, "end": 114.981, "text": "Your diabetes status is stable."}, {"start": 115.982, "end": 116.362, "text": "Stable."}, {"start": 117.17, "end": 119.291, "text": "So I take it there is nothing that needs adjusting?"}, {"start": 120.052, "end": 120.712, "text": "Nothing at all."}, {"start": 121.192, "end": 123.053, "text": "There are no changes to make today."}, {"start": 123.994, "end": 124.774, "text": "And looking ahead?"}, {"start": 125.575, "end": 127.676, "text": "We continue with follow-up as planned."}, {"start": 128.296, "end": 129.497, "text": "Does that all make sense to you?"}, {"start": 130.497, "end": 131.578, "text": "It does, thank you."}, {"start": 132.498, "end": 135.26, "text": "Was that the first frost on the grass this morning, do you think?"}, {"start": 136.2, "end": 137.201, "text": "I think it was."}, {"start": 137.701, "end": 139.942, "text": "My windscreen certainly agreed with you."}, {"start": 140.943, "end": 142.964, "text": "I scraped mine for the first time this year."}, {"start": 143.724, "end": 145.105, "text": "Autumn has committed itself."}, {"start": 146.026, "end": 146.506, "text": "It has."}, {"start": 147.294, "end": 148.435, "text": "Take care, Mrs. Cruz."}, {"start": 148.776, "end": 150.517, "text": "I will see you at your next follow-up."}, {"start": 151.438, "end": 152.159, "text": "Thank you, Doctor."}, {"start": 152.56, "end": 152.96, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.643}}