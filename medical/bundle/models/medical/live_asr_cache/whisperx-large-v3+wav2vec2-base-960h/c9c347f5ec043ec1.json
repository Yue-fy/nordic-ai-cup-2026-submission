1}, {"i": 165, "text": "The", "start": 72.232, "end": 72.352}, {"i": 166, "text": "exercises", "start": 72.432, "end": 73.132}, {"i": 167, "text": "are", "start": 73.253, "end": 73.333}, {"i": 168, "text": "the", "start": 73.373, "end": 73.473}, {"i": 169, "text": "part", "start": 73.513, "end": 73.753}, {"i": 170, "text": "that", "start": 73.793, "end": 73.933}, {"i": 171, "text": "keeps", "start": 73.993, "end": 74.313}, {"i": 172, "text": "the", "start": 74.373, "end": 74.473}, {"i": 173, "text": "back", "start": 74.493, "end": 74.794}, {"i": 174, "text": "moving.", "start": 74.934, "end": 75.374}, {"i": 175, "text": "Is", "start": 76.075, "end": 76.155}, {"i": 176, "text": "that", "start": 76.175, "end": 76.375}, {"i": 177, "text": "clear?", "start": 76.435, "end": 76.735}, {"i": 178, "text": "Yes,", "start": 77.516, "end": 77.796}, {"i": 179, "text": "that", "start": 77.976, "end": 78.096}, {"i": 180, "text": "is", "start": 78.156, "end": 78.216}, {"i": 181, "text": "clear.", "start": 78.276, "end": 78.517}, {"i": 182, "text": "Good.", "start": 79.357, "end": 79.657}, {"i": 183, "text": "Take", "start": 80.198, "end": 80.418}, {"i": 184, "text": "care,", "start": 80.458, "end": 80.698}, {"i": 185, "text": "Mikel.", "start": 80.758, "end": 81.199}, {"i": 186, "text": "Thank", "start": 81.759, "end": 81.959}, {"i": 187, "text": "you.", "start": 81.979, "end": 82.139}, {"i": 188, "text": "Goodbye.", "start": 82.48, "end": 82.84}], "segments": [{"start": 0.066, "end": 0.626, "text": "Good morning."}, {"start": 1.466, "end": 2.627, "text": "I am Dr. Anderson."}, {"start": 3.287, "end": 4.907, "text": "I do not think we have met before."}, {"start": 5.607, "end": 6.428, "text": "No, we have not."}, {"start": 7.268, "end": 8.148, "text": "I am Mikel Ries."}, {"start": 8.788, "end": 9.729, "text": "Welcome, Mikel."}, {"start": 10.489, "end": 12.069, "text": "Did you notice the waiting area?"}, {"start": 12.689, "end": 14.53, "text": "It was repainted a few weeks ago."}, {"start": 15.15, "end": 15.49, "text": "I did."}, {"start": 16.09, "end": 17.711, "text": "It looks a lot brighter than I expected."}, {"start": 18.251, "end": 18.751, "text": "It does."}, {"start": 19.651, "end": 19.911, "text": "Right."}, {"start": 20.371, "end": 21.912, "text": "Tell me what brings you in today."}, {"start": 22.752, "end": 24.052, "text": "Pain in my lower back."}, {"start": 24.433, "end": 25.473, "text": "It feels muscular."}, {"start": 26.053, "end": 27.573, "text": "Does the pain travel anywhere?"}, {"start": 28.014, "end": 29.734, "text": "Down into a leg, for example?"}, {"start": 30.374, "end": 32.035, "text": "No, it stays in the lower back."}, {"start": 32.655, "end": 33.216, "text": "Thank you."}, {"start": 33.916, "end": 36.898, "text": "I would like to examine your back and see how it moves."}, {"start": 37.618, "end": 38.018, "text": "Of course."}, {"start": 38.839, "end": 42.0, "text": "I can feel tight, tender bands in the muscles."}, {"start": 42.701, "end": 44.642, "text": "We call those muscle knots."}, {"start": 45.402, "end": 46.723, "text": "That would explain the tightness."}, {"start": 47.584, "end": 51.185, "text": "Your movement is also reduced when you bend and turn."}, {"start": 51.866, "end": 53.127, "text": "Yes, it feels stiff."}, {"start": 54.007, "end": 59.23, "text": "Putting it together, this is nonspecific muscle and joint pain in the back."}, {"start": 59.702, "end": 60.803, "text": "Without radiation."}, {"start": 61.603, "end": 61.884, "text": "Right."}, {"start": 62.084, "end": 62.744, "text": "That makes sense."}, {"start": 63.645, "end": 67.628, "text": "For treatment, I recommend pain relief and an exercise program."}, {"start": 68.409, "end": 70.11, "text": "Painkillers and exercises."}, {"start": 70.851, "end": 71.471, "text": "Exactly."}, {"start": 72.232, "end": 75.374, "text": "The exercises are the part that keeps the back moving."}, {"start": 76.075, "end": 76.735, "text": "Is that clear?"}, {"start": 77.516, "end": 78.517, "text": "Yes, that is clear."}, {"start": 79.357, "end": 79.657, "text": "Good."}, {"start": 80.198, "end": 81.199, "text": "Take care, Mikel."}, {"start": 81.759, "end": 82.139, "text": "Thank you."}, {"start": 82.48, "end": 82.84, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.633}}