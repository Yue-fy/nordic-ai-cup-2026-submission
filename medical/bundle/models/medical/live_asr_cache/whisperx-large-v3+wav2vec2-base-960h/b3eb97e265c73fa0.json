"i": 298, "text": "week", "start": 115.551, "end": 115.771}, {"i": 299, "text": "away,", "start": 115.811, "end": 116.071}, {"i": 300, "text": "so", "start": 116.171, "end": 116.311}, {"i": 301, "text": "my", "start": 116.331, "end": 116.451}, {"i": 302, "text": "feet", "start": 116.511, "end": 116.751}, {"i": 303, "text": "have", "start": 116.791, "end": 116.911}, {"i": 304, "text": "had", "start": 116.951, "end": 117.111}, {"i": 305, "text": "rather", "start": 117.271, "end": 117.632}, {"i": 306, "text": "a", "start": 117.672, "end": 117.712}, {"i": 307, "text": "lot", "start": 117.752, "end": 117.912}, {"i": 308, "text": "of", "start": 117.952, "end": 118.012}, {"i": 309, "text": "walking", "start": 118.112, "end": 118.492}, {"i": 310, "text": "recently.", "start": 118.532, "end": 118.992}, {"i": 311, "text": "How", "start": 119.853, "end": 119.973}, {"i": 312, "text": "was", "start": 119.993, "end": 120.113}, {"i": 313, "text": "the", "start": 120.133, "end": 120.213}, {"i": 314, "text": "holiday?", "start": 120.253, "end": 120.673}, {"i": 315, "text": "Lovely,", "start": 121.614, "end": 121.954}, {"i": 316, "text": "thank", "start": 121.994, "end": 122.194}, {"i": 317, "text": "you.", "start": 122.214, "end": 122.374}, {"i": 318, "text": "Quiet", "start": 122.854, "end": 123.174}, {"i": 319, "text": "mostly,", "start": 123.234, "end": 123.615}, {"i": 320, "text": "which", "start": 124.095, "end": 124.235}, {"i": 321, "text": "was", "start": 124.275, "end": 124.395}, {"i": 322, "text": "exactly", "start": 124.475, "end": 124.935}, {"i": 323, "text": "what", "start": 124.975, "end": 125.115}, {"i": 324, "text": "I", "start": 125.155, "end": 125.195}, {"i": 325, "text": "wanted", "start": 125.256, "end": 125.576}, {"i": 326, "text": "after", "start": 125.716, "end": 125.936}, {"i": 327, "text": "a", "start": 125.976, "end": 126.016}, {"i": 328, "text": "busy", "start": 126.076, "end": 126.336}, {"i": 329, "text": "stretch", "start": 126.396, "end": 126.656}, {"i": 330, "text": "at", "start": 126.676, "end": 126.756}, {"i": 331, "text": "work.", "start": 126.796, "end": 127.036}, {"i": 332, "text": "Good.", "start": 128.057, "end": 128.377}, {"i": 333, "text": "The", "start": 129.238, "end": 129.338}, {"i": 334, "text": "cream", "start": 129.358, "end": 129.558}, {"i": 335, "text": "will", "start": 129.578, "end": 129.698}, {"i": 336, "text": "be", "start": 129.718, "end": 129.798}, {"i": 337, "text": "waiting", "start": 129.818, "end": 130.078}, {"i": 338, "text": "for", "start": 130.138, "end": 130.278}, {"i": 339, "text": "you", "start": 130.318, "end": 130.398}, {"i": 340, "text": "at", "start": 130.438, "end": 130.498}, {"i": 341, "text": "the", "start": 130.518, "end": 130.598}, {"i": 342, "text": "pharmacy.", "start": 130.618, "end": 131.118}, {"i": 343, "text": "Thank", "start": 131.959, "end": 132.159}, {"i": 344, "text": "you.", "start": 132.179, "end": 132.339}, {"i": 345, "text": "I", "start": 132.739, "end": 132.799}, {"i": 346, "text": "will", "start": 132.819, "end": 132.959}, {"i": 347, "text": "collect", "start": 132.979, "end": 133.24}, {"i": 348, "text": "it", "start": 133.28, "end": 133.34}, {"i": 349, "text": "on", "start": 133.36, "end": 133.42}, {"i": 350, "text": "the", "start": 133.46, "end": 133.54}, {"i": 351, "text": "way", "start": 133.58, "end": 133.68}, {"i": 352, "text": "home.", "start": 133.74, "end": 133.9}], "segments": [{"start": 0.086, "end": 0.786, "text": "Good afternoon."}, {"start": 1.286, "end": 2.227, "text": "I am Dr. Brune."}, {"start": 2.787, "end": 3.607, "text": "Please have a seat."}, {"start": 4.467, "end": 4.907, "text": "Thank you."}, {"start": 5.528, "end": 6.368, "text": "I am Ida Bang."}, {"start": 6.848, "end": 7.548, "text": "Nice to meet you."}, {"start": 8.288, "end": 11.249, "text": "I had heard the clinic was easy to find, and it really was."}, {"start": 12.029, "end": 12.75, "text": "Glad to hear it."}, {"start": 13.43, "end": 14.45, "text": "Did you cycle here?"}, {"start": 15.29, "end": 22.692, "text": "I did, yes, though I circled the building twice looking for somewhere sensible to leave the bike, and then found the rack behind the hedge."}, {"start": 23.612, "end": 24.553, "text": "It is well hidden."}, {"start": 25.413, "end": 27.654, "text": "It is there for patients and staff alike."}, {"start": 28.514, "end": 28.974, "text": "Good to know."}, {"start": 29.746, "end": 33.689, "text": "I will go straight there next time instead of wandering about like a lost tourist."}, {"start": 34.529, "end": 34.99, "text": "Noted."}, {"start": 36.07, "end": 37.191, "text": "What brings you in today?"}, {"start": 38.172, "end": 38.892, "text": "It is my feet."}, {"start": 39.693, "end": 46.978, "text": "The skin on them has become very dry, and it has bothered me enough that I decided to have it looked at properly rather than guessing."}, {"start": 47.939, "end": 49.199, "text": "Dryness on the feet."}, {"start": 50.0, "end": 50.62, "text": "Anywhere else?"}, {"start": 51.621, "end": 52.782, "text": "No, just the feet."}, {"start": 53.582, "end": 54.963, "text": "That really is the whole of it."}, {"start": 55.784, "end": 56.584, "text": "May I look at them?"}, {"start": 57.485, "end": 57.905, "text": "Of course."}, {"start": 58.286, "end": 58.706, "text": "Go ahead."}, {"start": 59.87, "end": 62.732, "text": "The skin is dry, with some light flaking."}, {"start": 63.413, "end": 64.453, "text": "There are no sores."}, {"start": 65.494, "end": 66.054, "text": "No sores."}, {"start": 66.855, "end": 68.937, "text": "That was the part I was most worried about."}, {"start": 69.557, "end": 71.498, "text": "So it is good to hear you say it out loud."}, {"start": 72.419, "end": 74.22, "text": "The condition is called xerosis."}, {"start": 74.881, "end": 76.722, "text": "It simply means dry skin."}, {"start": 77.623, "end": 78.263, "text": "Xerosis."}, {"start": 79.084, "end": 82.466, "text": "It sounds far more dramatic than dry skin, does it not?"}, {"start": 83.347, "end": 85.108, "text": "I will try to remember the word anyway."}, {"start": 86.229, "end": 87.27, "text": "It usually does."}, {"start": 88.614, "end": 91.156, "text": "I will prescribe a moisturizing cream for you."}, {"start": 92.176, "end": 93.197, "text": "That is straightforward."}, {"start": 93.897, "end": 95.759, "text": "And should I be doing anything else at home?"}, {"start": 96.719, "end": 97.019, "text": "Yes."}, {"start": 97.78, "end": 99.941, "text": "I will give you some advice on skin care."}, {"start": 100.462, "end": 103.423, "text": "And the main point is regular use of the cream."}, {"start": 104.444, "end": 105.345, "text": "That I can manage."}, {"start": 106.105, "end": 110.388, "text": "I am quite good at routines once somebody tells me what the routine actually is."}, {"start": 111.348, "end": 111.669, "text": "Good."}, {"start": 112.269, "end": 113.25, "text": "That is the plan then."}, {"start": 113.39, "end": 113.79, "text": "Perfect."}, {"start": 114.41, "end": 118.992, "text": "I have just come back from a week away, so my feet have had rather a lot of walking recently."}, {"start": 119.853, "end": 120.673, "text": "How was the holiday?"}, {"start": 121.614, "end": 122.374, "text": "Lovely, thank you."}, {"start": 122.854, "end": 127.036, "text": "Quiet mostly, which was exactly what I wanted after a busy stretch at work."}, {"start": 128.057, "end": 128.377, "text": "Good."}, {"start": 129.238, "end": 131.118, "text": "The cream will be waiting for you at the pharmacy."}, {"start": 131.959, "end": 132.339, "text": "Thank you."}, {"start": 132.739, "end": 133.9, "text": "I will collect it on the way home."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.354}}