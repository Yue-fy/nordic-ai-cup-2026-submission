, "end": 88.949}, {"i": 233, "text": "take", "start": 88.989, "end": 89.189}, {"i": 234, "text": "no", "start": 89.269, "end": 89.43}, {"i": 235, "text": "credit", "start": 89.51, "end": 89.85}, {"i": 236, "text": "at", "start": 89.91, "end": 89.95}, {"i": 237, "text": "all.", "start": 90.15, "end": 90.31}, {"i": 238, "text": "Someone", "start": 92.092, "end": 92.393}, {"i": 239, "text": "must", "start": 92.433, "end": 92.573}, {"i": 240, "text": "be", "start": 92.613, "end": 92.693}, {"i": 241, "text": "watering", "start": 92.733, "end": 93.073}, {"i": 242, "text": "them.", "start": 93.113, "end": 93.313}, {"i": 243, "text": "Thank", "start": 94.314, "end": 94.555}, {"i": 244, "text": "you.", "start": 94.575, "end": 94.755}, {"i": 245, "text": "This", "start": 95.155, "end": 95.295}, {"i": 246, "text": "was", "start": 95.315, "end": 95.436}, {"i": 247, "text": "a", "start": 95.476, "end": 95.516}, {"i": 248, "text": "relief.", "start": 95.556, "end": 95.896}, {"i": 249, "text": "Take", "start": 97.017, "end": 97.237}, {"i": 250, "text": "care,", "start": 97.277, "end": 97.518}, {"i": 251, "text": "Freya.", "start": 97.598, "end": 97.998}, {"i": 252, "text": "I", "start": 98.359, "end": 98.399}, {"i": 253, "text": "will", "start": 98.419, "end": 98.599}, {"i": 254, "text": "see", "start": 98.659, "end": 98.819}, {"i": 255, "text": "you", "start": 98.839, "end": 98.939}, {"i": 256, "text": "at", "start": 98.979, "end": 99.059}, {"i": 257, "text": "the", "start": 99.079, "end": 99.159}, {"i": 258, "text": "next", "start": 99.219, "end": 99.46}, {"i": 259, "text": "check.", "start": 99.5, "end": 99.8}], "segments": [{"start": 0.226, "end": 0.966, "text": "Hi, Dr. Iverson."}, {"start": 1.827, "end": 2.947, "text": "I hope I am not late."}, {"start": 3.828, "end": 4.928, "text": "Not at all, Freya."}, {"start": 5.128, "end": 5.568, "text": "Come in."}, {"start": 6.168, "end": 7.729, "text": "Have you seen what we have done in here?"}, {"start": 8.649, "end": 9.33, "text": "I did notice."}, {"start": 10.21, "end": 11.811, "text": "It has been repainted, has it not?"}, {"start": 12.731, "end": 13.632, "text": "It looks much brighter."}, {"start": 14.572, "end": 15.132, "text": "It has."}, {"start": 15.772, "end": 19.754, "text": "We moved the desk as well, and now I keep reaching for things that are not there."}, {"start": 21.555, "end": 23.375, "text": "I would do exactly the same, I think."}, {"start": 24.296, "end": 28.357, "text": "Now then, today is the foot check for your type 2 diabetes."}, {"start": 29.138, "end": 29.358, "text": "Yes."}, {"start": 30.262, "end": 33.525, "text": "I have no complaints at all, but that is partly what worries me."}, {"start": 34.566, "end": 35.787, "text": "Tell me what you mean by that."}, {"start": 36.807, "end": 41.892, "text": "Well, if nothing hurts, could something still be going wrong without me noticing it?"}, {"start": 43.093, "end": 46.656, "text": "That is a fair question, and it is exactly why we look at the feet."}, {"start": 47.416, "end": 48.377, "text": "Let me check them now."}, {"start": 49.298, "end": 49.798, "text": "Please do."}, {"start": 50.959, "end": 53.902, "text": "Your feet look normal, and your sensation is intact."}, {"start": 55.043, "end": 57.425, "text": "Intact means the feeling in them is working as it should?"}, {"start": 58.445, "end": 58.866, "text": "It does."}, {"start": 59.382, "end": 61.204, "text": "There are no signs of nerve damage."}, {"start": 63.686, "end": 64.867, "text": "And the diabetes itself?"}, {"start": 65.588, "end": 66.228, "text": "Is that all right?"}, {"start": 67.249, "end": 68.691, "text": "Your diabetes is stable."}, {"start": 69.712, "end": 72.174, "text": "So there is really nothing to be worried about at the moment."}, {"start": 73.395, "end": 74.356, "text": "Nothing at the moment."}, {"start": 74.817, "end": 78.12, "text": "We simply continue with the routine foot check once a year."}, {"start": 79.261, "end": 79.741, "text": "Once a year."}, {"start": 80.582, "end": 81.843, "text": "I will book it as usual then."}, {"start": 82.924, "end": 84.726, "text": "The plants by the window look well, by the way."}, {"start": 85.906, "end": 88.449, "text": "They have been thriving since the room was brightened up."}, {"start": 88.869, "end": 90.31, "text": "I take no credit at all."}, {"start": 92.092, "end": 93.313, "text": "Someone must be watering them."}, {"start": 94.314, "end": 94.755, "text": "Thank you."}, {"start": 95.155, "end": 95.896, "text": "This was a relief."}, {"start": 97.017, "end": 97.998, "text": "Take care, Freya."}, {"start": 98.359, "end": 99.8, "text": "I will see you at the next check."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.966}}