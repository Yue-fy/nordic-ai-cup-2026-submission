ext": "out.", "start": 108.971, "end": 109.111}, {"i": 299, "text": "That", "start": 109.751, "end": 109.891}, {"i": 300, "text": "was", "start": 109.951, "end": 110.092}, {"i": 301, "text": "quicker", "start": 110.252, "end": 110.512}, {"i": 302, "text": "than", "start": 110.552, "end": 110.652}, {"i": 303, "text": "I", "start": 110.712, "end": 110.772}, {"i": 304, "text": "expected.", "start": 110.832, "end": 111.333}, {"i": 305, "text": "It", "start": 112.133, "end": 112.213}, {"i": 306, "text": "usually", "start": 112.333, "end": 112.694}, {"i": 307, "text": "is.", "start": 112.754, "end": 112.854}, {"i": 308, "text": "The", "start": 113.874, "end": 113.974}, {"i": 309, "text": "healing", "start": 114.034, "end": 114.394}, {"i": 310, "text": "after", "start": 114.494, "end": 114.694}, {"i": 311, "text": "your", "start": 114.734, "end": 114.874}, {"i": 312, "text": "arthroscopy", "start": 114.994, "end": 115.735}, {"i": 313, "text": "has", "start": 115.955, "end": 116.115}, {"i": 314, "text": "been", "start": 116.155, "end": 116.315}, {"i": 315, "text": "uncomplicated,", "start": 116.495, "end": 117.355}, {"i": 316, "text": "which", "start": 118.035, "end": 118.175}, {"i": 317, "text": "is", "start": 118.235, "end": 118.295}, {"i": 318, "text": "the", "start": 118.335, "end": 118.415}, {"i": 319, "text": "conclusion", "start": 118.475, "end": 118.996}, {"i": 320, "text": "I", "start": 119.056, "end": 119.096}, {"i": 321, "text": "am", "start": 119.156, "end": 119.216}, {"i": 322, "text": "recording.", "start": 119.256, "end": 119.756}, {"i": 323, "text": "So", "start": 120.496, "end": 120.716}, {"i": 324, "text": "the", "start": 120.776, "end": 120.876}, {"i": 325, "text": "assessment", "start": 120.936, "end": 121.516}, {"i": 326, "text": "is", "start": 121.596, "end": 121.676}, {"i": 327, "text": "simply", "start": 121.736, "end": 122.176}, {"i": 328, "text": "uncomplicated", "start": 122.417, "end": 123.197}, {"i": 329, "text": "healing", "start": 123.237, "end": 123.597}, {"i": 330, "text": "after", "start": 123.897, "end": 124.117}, {"i": 331, "text": "the", "start": 124.157, "end": 124.237}, {"i": 332, "text": "arthroscopy?", "start": 124.317, "end": 124.957}, {"i": 333, "text": "Exactly", "start": 125.737, "end": 126.278}, {"i": 334, "text": "that.", "start": 126.338, "end": 126.518}, {"i": 335, "text": "Nothing", "start": 127.198, "end": 127.538}, {"i": 336, "text": "more", "start": 127.598, "end": 127.778}, {"i": 337, "text": "complicated", "start": 127.858, "end": 128.418}, {"i": 338, "text": "than", "start": 128.458, "end": 128.598}, {"i": 339, "text": "that.", "start": 128.658, "end": 128.838}, {"i": 340, "text": "Does", "start": 129.499, "end": 129.619}, {"i": 341, "text": "that", "start": 129.639, "end": 129.779}, {"i": 342, "text": "mean", "start": 129.839, "end": 130.059}, {"i": 343, "text": "no", "start": 130.179, "end": 130.339}, {"i": 344, "text": "further", "start": 130.439, "end": 130.739}, {"i": 345, "text": "treatment", "start": 130.779, "end": 131.179}, {"i": 346, "text": "is", "start": 131.259, "end": 131.319}, {"i": 347, "text": "needed", "start": 131.399, "end": 131.699}, {"i": 348, "text": "from", "start": 131.739, "end": 131.879}, {"i": 349, "text": "here?", "start": 131.919, "end": 132.119}, {"i": 350, "text": "No", "start": 132.8, "end": 132.98}, {"i": 351, "text": "further", "start": 133.02, "end": 133.32}, {"i": 352, "text": "treatment.", "start": 133.36, "end": 133.82}, {"i": 353, "text": "We", "start": 134.12, "end": 134.22}, {"i": 354, "text": "are", "start": 134.28, "end": 134.36}, {"i": 355, "text": "finished", "start": 134.46, "end": 134.86}, {"i": 356, "text": "with", "start": 135.04, "end": 135.18}, {"i": 357, "text": "this", "start": 135.22, "end": 135.38}, {"i": 358, "text": "one.", "start": 135.5, "end": 135.62}, {"i": 359, "text": "Good.", "start": 136.261, "end": 136.581}, {"i": 360, "text": "That", "start": 136.961, "end": 137.101}, {"i": 361, "text": "is", "start": 137.161, "end": 137.221}, {"i": 362, "text": "the", "start": 137.261, "end": 137.361}, {"i": 363, "text": "answer", "start": 137.441, "end": 137.721}, {"i": 364, "text": "I", "start": 137.801, "end": 137.841}, {"i": 365, "text": "was", "start": 137.881, "end": 138.001}, {"i": 366, "text": "hoping", "start": 138.061, "end": 138.361}, {"i": 367, "text": "for", "start": 138.421, "end": 138.681}, {"i": 368, "text": "when", "start": 138.841, "end": 138.981}, {"i": 369, "text": "I", "start": 139.041, "end": 139.101}, {"i": 370, "text": "walked", "start": 139.141, "end": 139.421}, {"i": 371, "text": "in.", "start": 139.482, "end": 139.602}, {"i": 372, "text": "I", "start": 140.282, "end": 140.342}, {"i": 373, "text": "imagine", "start": 140.402, "end": 140.782}, {"i": 374, "text": "so.", "start": 140.822, "end": 141.042}, {"i": 375, "text": "Are", "start": 141.758, "end": 141.838}, {"i": 376, "text": "you", "start": 141.858, "end": 141.978}, {"i": 377, "text": "doing", "start": 142.018, "end": 142.259}, {"i": 378, "text": "anything", "start": 142.319, "end": 142.659}, {"i": 379, "text": "for", "start": 142.719, "end": 142.859}, {"i": 380, "text": "the", "start": 142.879, "end": 142.979}, {"i": 381, "text": "public", "start": 143.02, "end": 143.32}, {"i": 382, "text": "holiday", "start": 143.36, "end": 143.72}, {"i": 383, "text": "coming", "start": 143.76, "end": 144.001}, {"i": 384, "text": "up?", "start": 144.081, "end": 144.161}, {"i": 385, "text": "Nothing", "start": 144.762, "end": 145.062}, {"i": 386, "text": "ambitious.", "start": 145.142, "end": 145.603}, {"i": 387, "text": "A", "start": 145.983, "end": 146.003}, {"i": 388, "text": "long", "start": 146.043, "end": 146.223}, {"i": 389, "text": "weekend", "start": 146.263, "end": 146.664}, {"i": 390, "text": "at", "start": 146.724, "end": 146.784}, {"i": 391, "text": "home", "start": 146.824, "end": 147.084}, {"i": 392, "text": "is", "start": 147.144, "end": 147.244}, {"i": 393, "text": "plenty", "start": 147.385, "end": 147.785}, {"i": 394, "text": "for", "start": 147.805, "end": 147.925}, {"i": 395, "text": "me.", "start": 147.965, "end": 148.125}, {"i": 396, "text": "Will", "start": 148.726, "end": 148.906}, {"i": 397, "text": "the", "start": 148.926, "end": 149.006}, {"i": 398, "text": "clinic", "start": 149.026, "end": 149.347}, {"i": 399, "text": "be", "start": 149.387, "end": 149.487}, {"i": 400, "text": "open", "start": 149.567, "end": 149.787}, {"i": 401, "text": "at", "start": 149.827, "end": 149.887}, {"i": 402, "text": "all?", "start": 149.988, "end": 150.108}, {"i": 403, "text": "We", "start": 150.768, "end": 150.909}, {"i": 404, "text": "are", "start": 150.969, "end": 151.049}, {"i": 405, "text": "closed,", "start": 151.109, "end": 151.489}, {"i": 406, "text": "so", "start": 152.03, "end": 152.19}, {"i": 407, "text": "I", "start": 152.35, "end": 152.41}, {"i": 408, "text": "will", "start": 152.45, "end": 152.631}, {"i": 409, "text": "be", "start": 152.651, "end": 152.751}, {"i": 410, "text": "enjoying", "start": 152.791, "end": 153.191}, {"i": 411, "text": "it", "start": 153.231, "end": 153.311}, {"i": 412, "text": "like", "start": 153.372, "end": 153.552}, {"i": 413, "text": "everyone", "start": 153.652, "end": 154.012}, {"i": 414, "text": "else.", "start": 154.072, "end": 154.253}, {"i": 415, "text": "Well", "start": 154.973, "end": 155.194}, {"i": 416, "text": "deserved.", "start": 155.234, "end": 155.674}, {"i": 417, "text": "Thank", "start": 156.035, "end": 156.255}, {"i": 418, "text": "you", "start": 156.275, "end": 156.395}, {"i": 419, "text": "for", "start": 156.415, "end": 156.515}, {"i": 420, "text": "seeing", "start": 156.555, "end": 156.795}, {"i": 421, "text": "me,", "start": 156.815, "end": 156.936}, {"i": 422, "text": "Dr.", "start": 156.956, "end": 157.216}, {"i": 423, "text": "Bang.", "start": 157.256, "end": 157.476}, {"i": 424, "text": "My", "start": 157.997, "end": 158.177}, {"i": 425, "text": "pleasure,", "start": 158.257, "end": 158.598}, {"i": 426, "text": "Rasmus.", "start": 158.618, "end": 159.058}, {"i": 427, "text": "Take", "start": 159.599, "end": 159.779}, {"i": 428, "text": "care", "start": 159.839, "end": 160.059}, {"i": 429, "text": "of", "start": 160.099, "end": 160.179}, {"i": 430, "text": "yourself.", "start": 160.219, "end": 160.62}], "segments": [{"start": 0.054, "end": 0.514, "text": "Good morning."}, {"start": 0.734, "end": 2.275, "text": "My name is Rasmus Overgaard."}, {"start": 2.675, "end": 4.835, "text": "I have an appointment to have my sutures removed."}, {"start": 5.796, "end": 6.576, "text": "Good morning, Rasmus."}, {"start": 7.156, "end": 7.976, "text": "I am Dr. Bang."}, {"start": 8.737, "end": 10.617, "text": "We have not met before, so welcome."}, {"start": 11.217, "end": 11.878, "text": "Please have a seat."}, {"start": 12.598, "end": 13.018, "text": "Thank you."}, {"start": 13.398, "end": 14.658, "text": "I hope I came in the right way."}, {"start": 15.019, "end": 17.819, "text": "The main entrance was locked, so I went round to the side door."}, {"start": 18.6, "end": 19.6, "text": "You are not the first."}, {"start": 20.36, "end": 24.161, "text": "That side door confuses almost everyone before opening hours."}, {"start": 25.042, "end": 26.442, "text": "Good to know it was not just me."}, {"start": 26.89, "end": 30.191, "text": "I stood there reading the sign twice before I gave up on the front."}, {"start": 31.592, "end": 33.633, "text": "The sign could be larger, I agree."}, {"start": 34.513, "end": 36.654, "text": "Now, tell me what we are dealing with today."}, {"start": 37.554, "end": 40.756, "text": "I had an arthroscopy and I'm here for the suture removal."}, {"start": 41.396, "end": 45.338, "text": "So this is the routine post-operative step rather than a new problem."}, {"start": 46.298, "end": 46.578, "text": "Right."}, {"start": 47.458, "end": 50.18, "text": "And how has the period since the procedure been for you?"}, {"start": 51.0, "end": 52.32, "text": "Uncomplicated, thankfully."}, {"start": 52.681, "end": 55.922, "text": "Nothing out of the ordinary at any point since the arthroscopy."}, {"start": 56.794, "end": 58.575, "text": "That is exactly what I like to hear."}, {"start": 59.416, "end": 60.977, "text": "So no setbacks along the way?"}, {"start": 61.917, "end": 62.458, "text": "None at all."}, {"start": 62.738, "end": 64.539, "text": "The whole course has been uneventful."}, {"start": 65.399, "end": 65.64, "text": "Good."}, {"start": 66.48, "end": 69.822, "text": "Let me take a proper look at the wound before I remove anything."}, {"start": 70.783, "end": 71.183, "text": "Of course."}, {"start": 71.383, "end": 72.103, "text": "Please go ahead."}, {"start": 73.244, "end": 77.827, "text": "I am looking at the skin around the sutures and along the wound edges."}, {"start": 78.788, "end": 81.349, "text": "You are checking for signs of infection, I assume?"}, {"start": 82.23, "end": 82.53, "text": "I am."}, {"start": 83.43, "end": 87.533, "text": "That is the main thing I want to rule out before the sutures come out."}, {"start": 88.574, "end": 89.495, "text": "And how does it look?"}, {"start": 90.336, "end": 91.917, "text": "There are no signs of infection."}, {"start": 92.718, "end": 94.539, "text": "Nothing there to suggest a problem."}, {"start": 95.44, "end": 96.621, "text": "That is reassuring."}, {"start": 96.981, "end": 101.705, "text": "I had been watching it myself, but it is better to hear it from someone who knows what to look for."}, {"start": 101.785, "end": 102.265, "text": "Quite right."}, {"start": 102.706, "end": 104.087, "text": "I will take the sutures out now."}, {"start": 104.827, "end": 105.388, "text": "Please do."}, {"start": 107.069, "end": 107.57, "text": "There we are."}, {"start": 108.35, "end": 109.111, "text": "All of them are out."}, {"start": 109.751, "end": 111.333, "text": "That was quicker than I expected."}, {"start": 112.133, "end": 112.854, "text": "It usually is."}, {"start": 113.874, "end": 119.756, "text": "The healing after your arthroscopy has been uncomplicated, which is the conclusion I am recording."}, {"start": 120.496, "end": 124.957, "text": "So the assessment is simply uncomplicated healing after the arthroscopy?"}, {"start": 125.737, "end": 126.518, "text": "Exactly that."}, {"start": 127.198, "end": 128.838, "text": "Nothing more complicated than that."}, {"start": 129.499, "end": 132.119, "text": "Does that mean no further treatment is needed from here?"}, {"start": 132.8, "end": 133.82, "text": "No further treatment."}, {"start": 134.12, "end": 135.62, "text": "We are finished with this one."}, {"start": 136.261, "end": 136.581, "text": "Good."}, {"start": 136.961, "end": 139.602, "text": "That is the answer I was hoping for when I walked in."}, {"start": 140.282, "end": 141.042, "text": "I imagine so."}, {"start": 141.758, "end": 144.161, "text": "Are you doing anything for the public holiday coming up?"}, {"start": 144.762, "end": 145.603, "text": "Nothing ambitious."}, {"start": 145.983, "end": 148.125, "text": "A long weekend at home is plenty for me."}, {"start": 148.726, "end": 150.108, "text": "Will the clinic be open at all?"}, {"start": 150.768, "end": 154.253, "text": "We are closed, so I will be enjoying it like everyone else."}, {"start": 154.973, "end": 155.674, "text": "Well deserved."}, {"start": 156.035, "end": 157.476, "text": "Thank you for seeing me, Dr. Bang."}, {"start": 157.997, "end": 159.058, "text": "My pleasure, Rasmus."}, {"start": 159.599, "end": 160.62, "text": "Take care of yourself."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.999}}