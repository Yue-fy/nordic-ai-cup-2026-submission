ext": "and", "start": 120.604, "end": 120.744}, {"i": 297, "text": "you", "start": 120.804, "end": 120.944}, {"i": 298, "text": "continue", "start": 120.984, "end": 121.445}, {"i": 299, "text": "your", "start": 121.485, "end": 121.645}, {"i": 300, "text": "current", "start": 121.705, "end": 122.005}, {"i": 301, "text": "medication.", "start": 122.045, "end": 122.665}, {"i": 302, "text": "Same", "start": 123.986, "end": 124.186}, {"i": 303, "text": "medication,", "start": 124.226, "end": 124.847}, {"i": 304, "text": "same", "start": 125.207, "end": 125.427}, {"i": 305, "text": "routine.", "start": 125.447, "end": 125.848}, {"i": 306, "text": "Nothing", "start": 126.448, "end": 126.788}, {"i": 307, "text": "new", "start": 126.828, "end": 126.988}, {"i": 308, "text": "to", "start": 127.008, "end": 127.088}, {"i": 309, "text": "remember,", "start": 127.128, "end": 127.569}, {"i": 310, "text": "which", "start": 128.089, "end": 128.249}, {"i": 311, "text": "suits", "start": 128.289, "end": 128.549}, {"i": 312, "text": "me", "start": 128.589, "end": 128.709}, {"i": 313, "text": "perfectly.", "start": 128.789, "end": 129.31}, {"i": 314, "text": "Nothing", "start": 130.571, "end": 130.851}, {"i": 315, "text": "new.", "start": 130.911, "end": 131.111}, {"i": 316, "text": "Is", "start": 131.691, "end": 131.771}, {"i": 317, "text": "that", "start": 131.811, "end": 131.972}, {"i": 318, "text": "clear", "start": 132.012, "end": 132.212}, {"i": 319, "text": "enough?", "start": 132.252, "end": 132.492}, {"i": 320, "text": "Perfectly", "start": 133.773, "end": 134.213}, {"i": 321, "text": "clear.", "start": 134.273, "end": 134.533}, {"i": 322, "text": "It", "start": 135.294, "end": 135.354}, {"i": 323, "text": "is", "start": 135.414, "end": 135.494}, {"i": 324, "text": "the", "start": 135.534, "end": 135.634}, {"i": 325, "text": "simplest", "start": 135.714, "end": 136.114}, {"i": 326, "text": "plan", "start": 136.174, "end": 136.455}, {"i": 327, "text": "I", "start": 136.595, "end": 136.635}, {"i": 328, "text": "have", "start": 136.675, "end": 136.775}, {"i": 329, "text": "been", "start": 136.815, "end": 136.955}, {"i": 330, "text": "given", "start": 136.975, "end": 137.235}, {"i": 331, "text": "in", "start": 137.355, "end": 137.435}, {"i": 332, "text": "a", "start": 137.475, "end": 137.515}, {"i": 333, "text": "long", "start": 137.615, "end": 137.896}, {"i": 334, "text": "while.", "start": 137.956, "end": 138.236}, {"i": 335, "text": "Sometimes", "start": 139.357, "end": 139.917}, {"i": 336, "text": "it", "start": 139.997, "end": 140.057}, {"i": 337, "text": "is.", "start": 140.157, "end": 140.297}, {"i": 338, "text": "Any", "start": 141.418, "end": 141.558}, {"i": 339, "text": "questions", "start": 141.618, "end": 142.038}, {"i": 340, "text": "before", "start": 142.078, "end": 142.339}, {"i": 341, "text": "we", "start": 142.379, "end": 142.499}, {"i": 342, "text": "finish?", "start": 142.519, "end": 142.819}, {"i": 343, "text": "Not", "start": 144.12, "end": 144.28}, {"i": 344, "text": "really.", "start": 144.34, "end": 144.62}, {"i": 345, "text": "You", "start": 145.18, "end": 145.3}, {"i": 346, "text": "have", "start": 145.32, "end": 145.441}, {"i": 347, "text": "covered", "start": 145.481, "end": 145.761}, {"i": 348, "text": "everything", "start": 145.861, "end": 146.201}, {"i": 349, "text": "I", "start": 146.261, "end": 146.321}, {"i": 350, "text": "came", "start": 146.361, "end": 146.541}, {"i": 351, "text": "in", "start": 146.581, "end": 146.641}, {"i": 352, "text": "wondering", "start": 146.701, "end": 147.062}, {"i": 353, "text": "about.", "start": 147.122, "end": 147.382}, {"i": 354, "text": "Good.", "start": 148.566, "end": 148.846}, {"i": 355, "text": "It", "start": 150.007, "end": 150.087}, {"i": 356, "text": "is", "start": 150.147, "end": 150.227}, {"i": 357, "text": "strange", "start": 150.287, "end": 150.627}, {"i": 358, "text": "though.", "start": 150.667, "end": 150.907}, {"i": 359, "text": "It", "start": 151.808, "end": 151.868}, {"i": 360, "text": "is", "start": 151.908, "end": 151.988}, {"i": 361, "text": "getting", "start": 152.028, "end": 152.288}, {"i": 362, "text": "dark", "start": 152.348, "end": 152.628}, {"i": 363, "text": "so", "start": 152.669, "end": 152.829}, {"i": 364, "text": "early", "start": 152.989, "end": 153.209}, {"i": 365, "text": "now", "start": 153.269, "end": 153.429}, {"i": 366, "text": "compared", "start": 153.529, "end": 153.849}, {"i": 367, "text": "with", "start": 153.889, "end": 153.989}, {"i": 368, "text": "a", "start": 154.029, "end": 154.069}, {"i": 369, "text": "month", "start": 154.109, "end": 154.31}, {"i": 370, "text": "ago.", "start": 154.35, "end": 154.57}, {"i": 371, "text": "It", "start": 155.85, "end": 155.93}, {"i": 372, "text": "creeps", "start": 155.971, "end": 156.231}, {"i": 373, "text": "up", "start": 156.331, "end": 156.411}, {"i": 374, "text": "on", "start": 156.511, "end": 156.571}, {"i": 375, "text": "you", "start": 156.611, "end": 156.751}, {"i": 376, "text": "every", "start": 156.871, "end": 157.131}, {"i": 377, "text": "year.", "start": 157.171, "end": 157.411}, {"i": 378, "text": "It", "start": 158.612, "end": 158.672}, {"i": 379, "text": "does.", "start": 158.712, "end": 158.972}, {"i": 380, "text": "By", "start": 159.853, "end": 159.953}, {"i": 381, "text": "the", "start": 159.993, "end": 160.073}, {"i": 382, "text": "time", "start": 160.113, "end": 160.293}, {"i": 383, "text": "I", "start": 160.353, "end": 160.413}, {"i": 384, "text": "get", "start": 160.453, "end": 160.613}, {"i": 385, "text": "home,", "start": 160.673, "end": 160.914}, {"i": 386, "text": "it", "start": 161.034, "end": 161.094}, {"i": 387, "text": "is", "start": 161.154, "end": 161.214}, {"i": 388, "text": "already", "start": 161.274, "end": 161.614}, {"i": 389, "text": "dim,", "start": 161.674, "end": 161.914}, {"i": 390, "text": "so", "start": 162.495, "end": 162.615}, {"i": 391, "text": "the", "start": 162.655, "end": 162.735}, {"i": 392, "text": "lamps", "start": 162.775, "end": 163.055}, {"i": 393, "text": "go", "start": 163.095, "end": 163.235}, {"i": 394, "text": "on", "start": 163.315, "end": 163.415}, {"i": 395, "text": "far", "start": 163.495, "end": 163.735}, {"i": 396, "text": "earlier.", "start": 163.835, "end": 164.196}, {"i": 397, "text": "That", "start": 165.436, "end": 165.616}, {"i": 398, "text": "is", "start": 165.696, "end": 165.797}, {"i": 399, "text": "the", "start": 165.877, "end": 165.977}, {"i": 400, "text": "season", "start": 166.037, "end": 166.357}, {"i": 401, "text": "for", "start": 166.417, "end": 166.577}, {"i": 402, "text": "you.", "start": 166.617, "end": 166.757}, {"i": 403, "text": "Take", "start": 167.878, "end": 168.078}, {"i": 404, "text": "care,", "start": 168.098, "end": 168.298}, {"i": 405, "text": "Mehta.", "start": 168.338, "end": 168.638}, {"i": 406, "text": "Thank", "start": 169.679, "end": 169.859}, {"i": 407, "text": "you", "start": 169.879, "end": 169.979}, {"i": 408, "text": "very", "start": 170.019, "end": 170.199}, {"i": 409, "text": "much.", "start": 170.239, "end": 170.459}, {"i": 410, "text": "Goodbye.", "start": 171.16, "end": 171.52}], "segments": [{"start": 0.094, "end": 0.695, "text": "Morning, Met."}, {"start": 1.195, "end": 2.236, "text": "Come in, have a seat."}, {"start": 2.996, "end": 4.418, "text": "Good morning, Dr. Fabricius."}, {"start": 4.918, "end": 5.358, "text": "Thank you."}, {"start": 6.059, "end": 7.54, "text": "It is nice to be somewhere calm."}, {"start": 8.08, "end": 9.982, "text": "The supermarket this morning was chaos."}, {"start": 10.943, "end": 11.723, "text": "Busy already?"}, {"start": 12.604, "end": 13.585, "text": "Completely packed."}, {"start": 14.386, "end": 17.168, "text": "I gave up on half my list and came straight here instead."}, {"start": 18.649, "end": 19.129, "text": "Sensible."}, {"start": 19.91, "end": 22.172, "text": "Let us make this the easy part of your morning, then."}, {"start": 23.032, "end": 23.553, "text": "Please do."}, {"start": 24.634, "end": 26.595, "text": "So, this is your diabetes review."}, {"start": 27.256, "end": 28.537, "text": "I would like to take it in order."}, {"start": 29.398, "end": 29.778, "text": "First..."}, {"start": 30.214, "end": 31.115, "text": "How have you been feeling?"}, {"start": 32.256, "end": 33.917, "text": "Honestly, stable."}, {"start": 34.738, "end": 36.419, "text": "That is the word I keep coming back to."}, {"start": 37.14, "end": 40.823, "text": "Nothing dramatic, nothing new, just steady along."}, {"start": 42.044, "end": 43.265, "text": "Stable is a good word."}, {"start": 43.966, "end": 46.408, "text": "So, no change in how you feel from day to day?"}, {"start": 47.468, "end": 48.029, "text": "None at all."}, {"start": 48.87, "end": 52.052, "text": "It has been quite an ordinary stretch, which I am grateful for."}, {"start": 53.233, "end": 53.514, "text": "Good."}, {"start": 54.474, "end": 58.758, "text": "Second thing, what about your lifestyle, the things you are working on?"}, {"start": 59.934, "end": 60.695, "text": "I have kept it up."}, {"start": 61.515, "end": 62.216, "text": "I really have."}, {"start": 63.137, "end": 66.48, "text": "It is part of my routine now rather than something I have to think about."}, {"start": 67.66, "end": 69.382, "text": "That is exactly what we hope for."}, {"start": 70.083, "end": 72.164, "text": "Keeping it going is harder than starting."}, {"start": 73.345, "end": 76.268, "text": "It is, and I will not pretend it was easy at first."}, {"start": 76.988, "end": 77.809, "text": "But it has stuck."}, {"start": 79.05, "end": 79.35, "text": "Good."}, {"start": 80.071, "end": 81.532, "text": "Let me check I have understood you."}, {"start": 82.413, "end": 85.335, "text": "You feel stable, and you have maintained your lifestyle."}, {"start": 86.436, "end": 86.716, "text": "Yes."}, {"start": 87.397, "end": 88.498, "text": "That sums it up neatly."}, {"start": 89.686, "end": 92.027, "text": "Then let me tell you what that means for my assessment."}, {"start": 93.228, "end": 93.848, "text": "Yes, please."}, {"start": 94.548, "end": 96.409, "text": "I always like to hear the reasoning behind it."}, {"start": 97.569, "end": 101.771, "text": "My assessment is that your diabetes is stable and that no changes are needed."}, {"start": 103.132, "end": 104.092, "text": "No changes at all."}, {"start": 104.893, "end": 107.054, "text": "That is exactly what I was hoping to hear today."}, {"start": 108.174, "end": 110.995, "text": "When something is working, changing it rarely helps."}, {"start": 111.236, "end": 114.417, "text": "I have heard that before, and it always makes good sense to me."}, {"start": 115.698, "end": 116.598, "text": "Now, the plan."}, {"start": 117.642, "end": 122.665, "text": "You continue your lifestyle exactly as you are, and you continue your current medication."}, {"start": 123.986, "end": 125.848, "text": "Same medication, same routine."}, {"start": 126.448, "end": 129.31, "text": "Nothing new to remember, which suits me perfectly."}, {"start": 130.571, "end": 131.111, "text": "Nothing new."}, {"start": 131.691, "end": 132.492, "text": "Is that clear enough?"}, {"start": 133.773, "end": 134.533, "text": "Perfectly clear."}, {"start": 135.294, "end": 138.236, "text": "It is the simplest plan I have been given in a long while."}, {"start": 139.357, "end": 140.297, "text": "Sometimes it is."}, {"start": 141.418, "end": 142.819, "text": "Any questions before we finish?"}, {"start": 144.12, "end": 144.62, "text": "Not really."}, {"start": 145.18, "end": 147.382, "text": "You have covered everything I came in wondering about."}, {"start": 148.566, "end": 148.846, "text": "Good."}, {"start": 150.007, "end": 150.907, "text": "It is strange though."}, {"start": 151.808, "end": 154.57, "text": "It is getting dark so early now compared with a month ago."}, {"start": 155.85, "end": 157.411, "text": "It creeps up on you every year."}, {"start": 158.612, "end": 158.972, "text": "It does."}, {"start": 159.853, "end": 164.196, "text": "By the time I get home, it is already dim, so the lamps go on far earlier."}, {"start": 165.436, "end": 166.757, "text": "That is the season for you."}, {"start": 167.878, "end": 168.638, "text": "Take care, Mehta."}, {"start": 169.679, "end": 170.459, "text": "Thank you very much."}, {"start": 171.16, "end": 171.52, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.809}}