art": 139.793, "end": 139.913}, {"i": 297, "text": "seen", "start": 139.953, "end": 140.153}, {"i": 298, "text": "that", "start": 140.193, "end": 140.353}, {"i": 299, "text": "series", "start": 140.453, "end": 140.913}, {"i": 300, "text": "everyone", "start": 141.013, "end": 141.413}, {"i": 301, "text": "keeps", "start": 141.473, "end": 141.734}, {"i": 302, "text": "talking", "start": 141.814, "end": 142.174}, {"i": 303, "text": "about?", "start": 142.234, "end": 142.534}, {"i": 304, "text": "Two", "start": 143.783, "end": 143.943}, {"i": 305, "text": "episodes", "start": 144.023, "end": 144.463}, {"i": 306, "text": "so", "start": 144.503, "end": 144.663}, {"i": 307, "text": "far.", "start": 144.723, "end": 144.984}, {"i": 308, "text": "It", "start": 145.424, "end": 145.484}, {"i": 309, "text": "is", "start": 145.584, "end": 145.664}, {"i": 310, "text": "worth", "start": 145.724, "end": 145.944}, {"i": 311, "text": "watching.", "start": 146.004, "end": 146.445}, {"i": 312, "text": "Good", "start": 147.145, "end": 147.366}, {"i": 313, "text": "to", "start": 147.426, "end": 147.526}, {"i": 314, "text": "know.", "start": 147.586, "end": 147.826}, {"i": 315, "text": "I", "start": 148.607, "end": 148.667}, {"i": 316, "text": "need", "start": 148.727, "end": 148.927}, {"i": 317, "text": "something", "start": 148.967, "end": 149.287}, {"i": 318, "text": "for", "start": 149.327, "end": 149.447}, {"i": 319, "text": "the", "start": 149.488, "end": 149.568}, {"i": 320, "text": "evenings,", "start": 149.728, "end": 150.168}, {"i": 321, "text": "now", "start": 150.468, "end": 150.649}, {"i": 322, "text": "that", "start": 150.689, "end": 150.809}, {"i": 323, "text": "they", "start": 150.849, "end": 150.989}, {"i": 324, "text": "are", "start": 151.029, "end": 151.129}, {"i": 325, "text": "longer.", "start": 151.189, "end": 151.589}, {"i": 326, "text": "Then", "start": 152.35, "end": 152.55}, {"i": 327, "text": "that", "start": 152.61, "end": 152.77}, {"i": 328, "text": "will", "start": 152.81, "end": 152.971}, {"i": 329, "text": "do", "start": 152.991, "end": 153.131}, {"i": 330, "text": "it.", "start": 153.211, "end": 153.271}, {"i": 331, "text": "Anything", "start": 153.871, "end": 154.152}, {"i": 332, "text": "else", "start": 154.232, "end": 154.392}, {"i": 333, "text": "about", "start": 154.432, "end": 154.632}, {"i": 334, "text": "your", "start": 154.652, "end": 154.792}, {"i": 335, "text": "eyes?", "start": 154.952, "end": 155.132}, {"i": 336, "text": "No,", "start": 156.133, "end": 156.374}, {"i": 337, "text": "I", "start": 156.794, "end": 156.854}, {"i": 338, "text": "think", "start": 156.914, "end": 157.114}, {"i": 339, "text": "that", "start": 157.154, "end": 157.354}, {"i": 340, "text": "is", "start": 157.414, "end": 157.495}, {"i": 341, "text": "everything.", "start": 157.595, "end": 158.055}, {"i": 342, "text": "Thank", "start": 158.756, "end": 158.996}, {"i": 343, "text": "you.", "start": 159.036, "end": 159.196}, {"i": 344, "text": "You", "start": 160.077, "end": 160.197}, {"i": 345, "text": "are", "start": 160.277, "end": 160.397}, {"i": 346, "text": "welcome,", "start": 160.457, "end": 160.837}, {"i": 347, "text": "Mikkel.", "start": 160.857, "end": 161.298}, {"i": 348, "text": "Take", "start": 161.618, "end": 161.818}, {"i": 349, "text": "care.", "start": 161.858, "end": 162.159}, {"i": 350, "text": "Goodbye.", "start": 163.119, "end": 163.62}], "segments": [{"start": 0.098, "end": 0.719, "text": "Good morning."}, {"start": 1.199, "end": 2.48, "text": "I am Dr. Fabricius."}, {"start": 2.84, "end": 3.741, "text": "Please have a seat."}, {"start": 4.522, "end": 5.002, "text": "Thank you."}, {"start": 5.943, "end": 7.444, "text": "I am Mikkel Bang."}, {"start": 8.265, "end": 9.266, "text": "Good to meet you, Mikkel."}, {"start": 9.666, "end": 10.727, "text": "Warm out there today?"}, {"start": 11.708, "end": 12.448, "text": "Very warm."}, {"start": 13.429, "end": 16.332, "text": "Though the evenings have already started getting darker."}, {"start": 17.373, "end": 18.994, "text": "The seasons turn quickly here."}, {"start": 20.195, "end": 20.996, "text": "They really do."}, {"start": 21.957, "end": 24.539, "text": "It feels like summer packed up overnight."}, {"start": 25.54, "end": 26.04, "text": "It does."}, {"start": 26.6, "end": 28.222, "text": "So what brings you in today?"}, {"start": 29.31, "end": 29.991, "text": "My eyes."}, {"start": 30.791, "end": 33.534, "text": "I was hoping I could get some allergy drops for them."}, {"start": 34.695, "end": 34.995, "text": "Right."}, {"start": 35.475, "end": 36.676, "text": "What made you want them now?"}, {"start": 37.817, "end": 39.138, "text": "The heat, mostly."}, {"start": 40.079, "end": 42.061, "text": "And all this wind we have been having."}, {"start": 43.002, "end": 44.803, "text": "My eyes really do not like it."}, {"start": 45.884, "end": 48.286, "text": "So heat and windy weather set it off."}, {"start": 49.567, "end": 49.847, "text": "Yes."}, {"start": 50.388, "end": 51.689, "text": "That is what I have noticed."}, {"start": 52.81, "end": 53.871, "text": "Let me look at your eyes."}, {"start": 54.431, "end": 55.832, "text": "Look straight ahead for me."}, {"start": 57.194, "end": 57.574, "text": "Okay."}, {"start": 58.858, "end": 59.398, "text": "Thank you."}, {"start": 60.059, "end": 62.139, "text": "The white part of both eyes is red."}, {"start": 63.4, "end": 64.2, "text": "Is that bad?"}, {"start": 65.261, "end": 65.561, "text": "No."}, {"start": 65.981, "end": 68.062, "text": "It is the lining of the eye reacting."}, {"start": 69.303, "end": 69.943, "text": "The lining?"}, {"start": 70.783, "end": 72.524, "text": "What does that mean, exactly?"}, {"start": 73.725, "end": 76.766, "text": "The thin, clear layer covering the white of the eye."}, {"start": 77.326, "end": 79.407, "text": "It is called the conjunctiva."}, {"start": 80.568, "end": 81.548, "text": "Conjunctiva."}, {"start": 82.389, "end": 82.789, "text": "All right."}, {"start": 83.429, "end": 85.47, "text": "So what is actually wrong with them?"}, {"start": 86.738, "end": 89.04, "text": "It is an allergic irritation of the eyes."}, {"start": 90.361, "end": 90.901, "text": "Allergic?"}, {"start": 91.541, "end": 92.562, "text": "So I have an allergy?"}, {"start": 93.623, "end": 96.385, "text": "Yes, an allergy without a named cause."}, {"start": 97.766, "end": 100.288, "text": "So you do not know what I am reacting to?"}, {"start": 101.468, "end": 102.649, "text": "Not from today, no."}, {"start": 103.31, "end": 105.891, "text": "What we can do is treat the irritation."}, {"start": 107.172, "end": 108.473, "text": "That is fine by me."}, {"start": 109.394, "end": 111.475, "text": "I mostly just want them to settle down."}, {"start": 112.856, "end": 115.158, "text": "I will write you a prescription for opatinol."}, {"start": 116.382, "end": 117.703, "text": "I have never heard of that one."}, {"start": 118.303, "end": 118.743, "text": "What is it?"}, {"start": 119.944, "end": 121.344, "text": "An allergy eye drop."}, {"start": 121.825, "end": 124.426, "text": "The strength is one milligram per milliliter."}, {"start": 125.666, "end": 127.307, "text": "And how am I supposed to use it?"}, {"start": 128.628, "end": 131.269, "text": "One drop in each eye, two times a day."}, {"start": 132.549, "end": 134.71, "text": "One drop in each eye, twice a day."}, {"start": 135.531, "end": 136.711, "text": "That I can remember."}, {"start": 136.791, "end": 137.091, "text": "Good."}, {"start": 138.212, "end": 142.534, "text": "Before I go, have you seen that series everyone keeps talking about?"}, {"start": 143.783, "end": 144.984, "text": "Two episodes so far."}, {"start": 145.424, "end": 146.445, "text": "It is worth watching."}, {"start": 147.145, "end": 147.826, "text": "Good to know."}, {"start": 148.607, "end": 151.589, "text": "I need something for the evenings, now that they are longer."}, {"start": 152.35, "end": 153.271, "text": "Then that will do it."}, {"start": 153.871, "end": 155.132, "text": "Anything else about your eyes?"}, {"start": 156.133, "end": 158.055, "text": "No, I think that is everything."}, {"start": 158.756, "end": 159.196, "text": "Thank you."}, {"start": 160.077, "end": 161.298, "text": "You are welcome, Mikkel."}, {"start": 161.618, "end": 162.159, "text": "Take care."}, {"start": 163.119, "end": 163.62, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.693}}