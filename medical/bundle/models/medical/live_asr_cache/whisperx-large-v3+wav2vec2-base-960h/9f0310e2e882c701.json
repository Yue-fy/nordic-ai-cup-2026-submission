ld", "start": 114.617, "end": 114.818}, {"i": 298, "text": "me", "start": 114.838, "end": 114.918}, {"i": 299, "text": "about", "start": 114.958, "end": 115.158}, {"i": 300, "text": "the", "start": 115.198, "end": 115.278}, {"i": 301, "text": "wind.", "start": 115.318, "end": 115.598}, {"i": 302, "text": "I", "start": 116.562, "end": 116.642}, {"i": 303, "text": "also", "start": 116.722, "end": 117.002}, {"i": 304, "text": "note", "start": 117.082, "end": 117.323}, {"i": 305, "text": "you", "start": 117.383, "end": 117.503}, {"i": 306, "text": "are", "start": 117.563, "end": 117.663}, {"i": 307, "text": "slightly", "start": 117.783, "end": 118.283}, {"i": 308, "text": "overweight.", "start": 118.463, "end": 119.064}, {"i": 309, "text": "So", "start": 119.945, "end": 120.065}, {"i": 310, "text": "what", "start": 120.105, "end": 120.185}, {"i": 311, "text": "do", "start": 120.205, "end": 120.245}, {"i": 312, "text": "you", "start": 120.265, "end": 120.365}, {"i": 313, "text": "actually", "start": 120.465, "end": 120.805}, {"i": 314, "text": "think", "start": 120.845, "end": 121.025}, {"i": 315, "text": "it", "start": 121.065, "end": 121.125}, {"i": 316, "text": "is?", "start": 121.225, "end": 121.366}, {"i": 317, "text": "What", "start": 122.066, "end": 122.206}, {"i": 318, "text": "I", "start": 122.286, "end": 122.366}, {"i": 319, "text": "suspect", "start": 122.426, "end": 122.967}, {"i": 320, "text": "is", "start": 123.127, "end": 123.207}, {"i": 321, "text": "an", "start": 123.267, "end": 123.327}, {"i": 322, "text": "irritable", "start": 123.507, "end": 123.967}, {"i": 323, "text": "bowel.", "start": 124.027, "end": 124.448}, {"i": 324, "text": "Suspect,", "start": 125.348, "end": 125.909}, {"i": 325, "text": "not", "start": 126.429, "end": 126.629}, {"i": 326, "text": "know.", "start": 126.729, "end": 127.03}, {"i": 327, "text": "Suspect.", "start": 127.83, "end": 128.411}, {"i": 328, "text": "I", "start": 128.931, "end": 128.991}, {"i": 329, "text": "will", "st