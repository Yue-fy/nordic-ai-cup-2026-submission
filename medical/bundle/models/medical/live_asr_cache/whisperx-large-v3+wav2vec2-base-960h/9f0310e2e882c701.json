"start": 141.0, "end": 141.32}, {"i": 362, "text": "else", "start": 141.5, "end": 141.7}, {"i": 363, "text": "in", "start": 141.74, "end": 141.8}, {"i": 364, "text": "your", "start": 141.82, "end": 141.96}, {"i": 365, "text": "favor.", "start": 142.021, "end": 142.421}, {"i": 366, "text": "Which", "start": 143.442, "end": 143.602}, {"i": 367, "text": "is?", "start": 143.722, "end": 143.822}, {"i": 368, "text": "You", "start": 144.606, "end": 144.706}, {"i": 369, "text": "have", "start": 144.746, "end": 144.866}, {"i": 370, "text": "improved", "start": 144.906, "end": 145.467}, {"i": 371, "text": "since", "start": 145.527, "end": 145.727}, {"i": 372, "text": "the", "start": 145.767, "end": 145.867}, {"i": 373, "text": "antibiotic", "start": 145.967, "end": 146.628}, {"i": 374, "text": "treatment.", "start": 146.688, "end": 147.128}, {"i": 375, "text": "That", "start": 147.609, "end": 147.829}, {"i": 376, "text": "improvement", "start": 147.889, "end": 148.489}, {"i": 377, "text": "is", "start": 148.569, "end": 148.649}, {"i": 378, "text": "meaningful.", "start": 148.73, "end": 149.31}, {"i": 379, "text": "I", "start": 150.211, "end": 150.271}, {"i": 380, "text": "had", "start": 150.291, "end": 150.411}, {"i": 381, "text": "noticed", "start": 150.471, "end": 150.771}, {"i": 382, "text": "that,", "start": 150.811, "end": 150.991}, {"i": 383, "text": "actually.", "start": 151.092, "end": 151.492}, {"i": 384, "text": "It", "start": 152.393, "end": 152.453}, {"i": 385, "text": "has", "start": 152.493, "end": 152.573}, {"i": 386, "text": "been", "start": 152.593, "end": 152.753}, {"i": 387, "text": "better", "start": 152.793, "end": 153.033}, {"i": 388, "text": "since", "start": 153.073, "end": 153.273}, {"i": 389, "text": "I", "start": 153.313, "end": 153.394}, {"i": 390, "text": "started", "start": 153.434, "end": 153.814}, {"i": 391, "text": "it.", "start": 153.854, "end": 153.934}, {"i": 392, "text": "Then", "start": 154.635, "end": 154.775}, {"i": 393, "text": "I", "start": 154.835, "end": 154.895}, {"i": 394, "text": "want", "start": 154.955, "end": 155.135}, {"i": 395, "text": "you", "start": 155.175, "end": 155.275}, {"i": 396, "text": "to", "start": 155.295, "end": 155.335}, {"i": 397, "text": "continue", "start": 155.375, "end": 155.816}, {"i": 398, "text": "the", "start": 155.836, "end": 155.936}, {"i": 399, "text": "pancillin", "start": 156.016, "end": 156.736}, {"i": 400, "text": "for", "start": 156.796, "end": 156.937}, {"i": 401, "text": "a", "start": 156.977, "end": 157.017}, {"i": 402, "text": "further", "start": 157.117, "end": 157.477}, {"i": 403, "text": "five", "start": 157.577, "end": 157.937}, {"i": 404, "text": "days.", "start": 157.977, "end": 158.438}, {"i": 405, "text": "Five", "start": 159.299, "end": 159.559}, {"i": 406, "text": "more", "start": 159.599, "end": 159.759}, {"i": 407, "text": "days.", "start": 159.799, "end": 160.079}, {"i": 408, "text": "And", "start": 160.88, "end": 160.96}, {"i": 409, "text": "after", "start": 161.02, "end": 161.2}, {"i": 410, "text": "that,", "start": 161.24, "end": 161.42}, {"i": 411, "text": "will", "start": 161.46, "end": 161.6}, {"i": 412, "text": "it", "start": 161.641, "end": 161.701}, {"i": 413, "text": "be", "start": 161.721, "end": 161.801}, {"i": 414, "text": "gone?", "start": 161.841, "end": 162.141}, {"i": 415, "text": "I", "start": 162.882, "end": 162.942}, {"i": 416, "text": "am", "start": 163.002, "end": 163.082}, {"i": 417, "text": "not", "start": 163.142, "end": 163.282}, {"i": 418, "text": "going", "start": 163.322, "end": 163.522}, {"i": 419, "text": "to", "start": 163.542, "end": 163.602}, {"i": 420, "text": "promise", "start": 163.662, "end": 163.982}, {"i": 421, "text": "you", "start": 164.023, "end": 164.123}, {"i": 422, "text": "a", "start": 164.183, "end": 164.203}, {"i": 423, "text": "date.", "start": 164.243, "end": 164.603}, {"i": 424, "text": "Finishing", "start": 165.163, "end": 165.564}, {"i": 425, "text": "the", "start": 165.584, "end": 165.664}, {"i": 426, "text": "course", "start": 165.724, "end": 166.024}, {"i": 427, "text": "is", "start": 166.124, "end": 166.204}, {"i": 428, "text": "the", "start": 166.244, "end": 166.344}, {"i": 429, "text": "right", "start": 166.485, "end": 166.745}, {"i": 430, "text": "next", "start": 166.845, "end": 167.065}, {"i": 431, "text": "step,", "start": 167.105, "end": 167.405}, {"i": 432, "text": "and", "start": 167.766, "end": 167.866}, {"i": 433, "text": "we", "start": 167.906, "end": 168.026}, {"i": 434, "text": "go", "start": 168.066, "end": 168.246}, {"i": 435, "text": "from", "start": 168.306, "end": 168.446}, {"i": 436, "text": "there.", "start": 168.486, "end": 168.807}, {"i": 437, "text": "That", "start": 169.727, "end": 169.867}, {"i": 438, "text": "is", "start": 169.928, "end": 169.988}, {"i": 439, "text": "fair.", "start": 170.048, "end": 170.368}, {"i": 440, "text": "Thank", "start": 171.289, "end": 171.469}, {"i": 441, "text": "you", "start": 171.489, "end": 171.589}, {"i": 442, "text": "for", "start": 171.629, "end": 171.729}, {"i": 443, "text": "not", "start": 171.769, "end": 171.909}, {"i": 444, "text": "brushing", "start": 171.949, "end": 172.27}, {"i": 445, "text": "me", "start": 172.29, "end": 172.39}, {"i": 446, "text": "off.", "start": 172.55, "end": 172.71}, {"i": 447, "text": "Work", "start": 173.31, "end": 173.51}, {"i": 448, "text": "has", "start": 173.53, "end": 173.65}, {"i": 449, "text": "been", "start": 173.67, "end": 173.831}, {"i": 450, "text": "relentless,", "start": 173.891, "end": 174.451}, {"i": 451, "text": "so", "start": 174.832, "end": 174.952}, {"i": 452, "text": "this", "start": 174.972, "end": 175.112}, {"i": 453, "text": "was", "start": 175.152, "end": 175.272}, {"i": 454, "text": "one", "start": 175.393, "end": 175.493}, {"i": 455, "text": "more", "start": 175.513, "end": 175.673}, {"i": 456, "text": "thing", "start": 175.733, "end": 175.913}, {"i": 457, "text": "on", "start": 175.953, "end": 176.013}, {"i": 458, "text": "the", "start": 176.053, "end": 176.113}, {"i": 459, "text": "pile.", "start": 176.173, "end": 176.514}, {"i": 460, "text": "I", "start": 177.395, "end": 177.455}, {"i": 461, "text": "can", "start": 177.475, "end": 177.595}, {"i": 462, "text": "imagine.", "start": 177.655, "end": 178.076}, {"i": 463, "text": "I", "start": 178.596, "end": 178.656}, {"i": 464, "text": "hope", "start": 178.696, "end": 178.857}, {"i": 465, "text": "it", "start": 178.917, "end": 178.977}, {"i": 466, "text": "quietens", "start": 179.037, "end": 179.497}, {"i": 467, "text": "down", "start": 179.537, "end": 179.798}, {"i": 468, "text": "for", "start": 179.878, "end": 179.998}, {"i": 469, "text": "you.", "start": 180.038, "end": 180.198}, {"i": 470, "text": "Take", "start": 180.759, "end": 180.979}, {"i": 471, "text": "care,", "start": 181.019, "end": 181.299}, {"i": 472, "text": "Emil.", "start": 181.34, "end": 181.64}], "segments": [{"start": 0.066, "end": 0.406, "text": "Hello?"}, {"start": 1.027, "end": 1.807, "text": "I have an appointment."}, {"start": 2.608, "end": 3.429, "text": "Emile Everson?"}, {"start": 3.969, "end": 4.65, "text": "Come in, Emile."}, {"start": 4.89, "end": 6.011, "text": "I am Dr. Thorson."}, {"start": 6.351, "end": 7.512, "text": "We have not met before."}, {"start": 8.253, "end": 8.453, "text": "No."}, {"start": 9.474, "end": 12.256, "text": "I should say straight away that I am a bit nervous about all this."}, {"start": 12.976, "end": 14.658, "text": "That is completely all right."}, {"start": 15.178, "end": 17.38, "text": "Sit down and tell me what has been going on."}, {"start": 18.241, "end": 19.021, "text": "It is my stomach."}, {"start": 19.862, "end": 21.083, "text": "The pain keeps coming back."}, {"start": 21.984, "end": 25.006, "text": "It goes away and then it returns, over and over."}, {"start": 25.667, "end": 27.888, "text": "Is it in one place or does it move about?"}, {"start": 28.689, "end": 29.67, "text": "Mostly the right side."}, {"start": 30.442, "end": 31.303, "text": "That is where it settles."}, {"start": 32.003, "end": 32.443, "text": "Thank you."}, {"start": 32.523, "end": 33.344, "text": "That is useful."}, {"start": 33.944, "end": 34.965, "text": "What else have you noticed?"}, {"start": 35.746, "end": 36.466, "text": "A lot of wind."}, {"start": 37.227, "end": 38.708, "text": "An embarrassing amount, honestly."}, {"start": 39.448, "end": 41.129, "text": "I keep thinking that must mean something."}, {"start": 41.89, "end": 44.371, "text": "It is worth telling me, so I am glad you did."}, {"start": 45.092, "end": 45.952, "text": "And your appetite?"}, {"start": 46.913, "end": 47.233, "text": "Normal."}, {"start": 47.954, "end": 48.834, "text": "Completely normal."}, {"start": 49.415, "end": 50.776, "text": "Which almost worries me more."}, {"start": 51.636, "end": 53.577, "text": "Should it not have changed if something were wrong?"}, {"start": 54.418, "end": 55.339, "text": "Not necessarily."}, {"start": 55.799, "end": 60.222, "text": "A normal appetite is a reassuring thing to find, not a confusing one."}, {"start": 62.131, "end": 62.531, "text": "All right."}, {"start": 63.411, "end": 67.854, "text": "Let me examine your abdomen now, and then I will tell you exactly what I find."}, {"start": 68.694, "end": 69.215, "text": "Please do."}, {"start": 69.955, "end": 72.417, "text": "And please tell me straight, even if it is not good."}, {"start": 73.197, "end": 73.637, "text": "I will."}, {"start": 74.198, "end": 75.018, "text": "Lie back for me."}, {"start": 76.979, "end": 78.66, "text": "Let your stomach go soft."}, {"start": 79.461, "end": 80.941, "text": "Sorry, I am tensing up."}, {"start": 81.622, "end": 82.662, "text": "That is very common."}, {"start": 83.003, "end": 83.783, "text": "Take your time."}, {"start": 84.624, "end": 85.444, "text": "Is there anything there?"}, {"start": 86.284, "end": 88.586, "text": "Your abdomen is distended with gas."}, {"start": 89.266, "end": 93.068, "text": "I can feel no masses at all, and your bowel sounds are natural."}, {"start": 93.988, "end": 94.608, "text": "No masses."}, {"start": 95.569, "end": 97.99, "text": "That is the thing I was most frightened of, if I am honest."}, {"start": 98.87, "end": 100.271, "text": "I know, and there are none."}, {"start": 101.091, "end": 104.253, "text": "And the bowel sounds being natural, that is a good sign as well?"}, {"start": 105.053, "end": 106.774, "text": "It is a normal finding, yes."}, {"start": 106.934, "end": 108.495, "text": "You also said distended."}, {"start": 109.395, "end": 111.316, "text": "That word sounds like something is wrong."}, {"start": 112.036, "end": 115.598, "text": "It means there is gas in there, which fits what you told me about the wind."}, {"start": 116.562, "end": 119.064, "text": "I also note you are slightly overweight."}, {"start": 119.945, "end": 121.366, "text": "So what do you actually think it is?"}, {"start": 122.066, "end": 124.448, "text": "What I suspect is an irritable bowel."}, {"start": 125.348, "end": 127.03, "text": "Suspect, not know."}, {"start": 127.83, "end": 128.411, "text": "Suspect."}, {"start": 128.931, "end": 130.432, "text": "I will not overstate it."}, {"start": 131.073, "end": 134.435, "text": "But that is what the examination and your history point to."}, {"start": 135.336, "end": 136.897, "text": "And nothing more serious than that?"}, {"start": 137.597, "end": 139.739, "text": "The findings today do not point that way."}, {"start": 140.279, "end": 142.421, "text": "There is also something else in your favor."}, {"start": 143.442, "end": 143.822, "text": "Which is?"}, {"start": 144.606, "end": 147.128, "text": "You have improved since the antibiotic treatment."}, {"start": 147.609, "end": 149.31, "text": "That improvement is meaningful."}, {"start": 150.211, "end": 151.492, "text": "I had noticed that, actually."}, {"start": 152.393, "end": 153.934, "text": "It has been better since I started it."}, {"start": 154.635, "end": 158.438, "text": "Then I want you to continue the pancillin for a further five days."}, {"start": 159.299, "end": 160.079, "text": "Five more days."}, {"start": 160.88, "end": 162.141, "text": "And after that, will it be gone?"}, {"start": 162.882, "end": 164.603, "text": "I am not going to promise you a date."}, {"start": 165.163, "end": 168.807, "text": "Finishing the course is the right next step, and we go from there."}, {"start": 169.727, "end": 170.368, "text": "That is fair."}, {"start": 171.289, "end": 172.71, "text": "Thank you for not brushing me off."}, {"start": 173.31, "end": 176.514, "text": "Work has been relentless, so this was one more thing on the pile."}, {"start": 177.395, "end": 178.076, "text": "I can imagine."}, {"start": 178.596, "end": 180.198, "text": "I hope it quietens down for you."}, {"start": 180.759, "end": 181.64, "text": "Take care, Emil."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 3.095}}