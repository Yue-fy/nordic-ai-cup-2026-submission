text": "queue", "start": 121.652, "end": 121.932}, {"i": 297, "text": "at", "start": 121.972, "end": 122.052}, {"i": 298, "text": "the", "start": 122.072, "end": 122.152}, {"i": 299, "text": "pharmacy", "start": 122.172, "end": 122.632}, {"i": 300, "text": "next", "start": 122.672, "end": 122.872}, {"i": 301, "text": "door", "start": 122.912, "end": 123.213}, {"i": 302, "text": "looked", "start": 123.353, "end": 123.573}, {"i": 303, "text": "enormous", "start": 123.733, "end": 124.333}, {"i": 304, "text": "when", "start": 124.373, "end": 124.493}, {"i": 305, "text": "I", "start": 124.533, "end": 124.573}, {"i": 306, "text": "walked", "start": 124.613, "end": 124.873}, {"i": 307, "text": "past.", "start": 124.933, "end": 125.294}, {"i": 308, "text": "It", "start": 126.194, "end": 126.274}, {"i": 309, "text": "builds", "start": 126.314, "end": 126.594}, {"i": 310, "text": "up", "start": 126.654, "end": 126.754}, {"i": 311, "text": "around", "start": 126.814, "end": 127.054}, {"i": 312, "text": "this", "start": 127.094, "end": 127.254}, {"i": 313, "text": "hour.", "start": 127.294, "end": 127.615}, {"i": 314, "text": "It", "start": 128.355, "end": 128.415}, {"i": 315, "text": "usually", "start": 128.535, "end": 128.855}, {"i": 316, "text": "thins", "start": 128.895, "end": 129.195}, {"i": 317, "text": "out", "start": 129.295, "end": 129.416}, {"i": 318, "text": "later", "start": 129.476, "end": 129.736}, {"i": 319, "text": "on.", "start": 129.936, "end": 130.056}, {"i": 320, "text": "Then", "start": 130.956, "end": 131.096}, {"i": 321, "text": "I", "start": 131.136, "end": 131.176}, {"i": 322, "text": "will", "start": 131.196, "end": 131.336}, {"i": 323, "text": "take", "start": 131.376, "end": 131.517}, {"i": 324, "text": "my", "start": 131.557, "end": 131.657}, {"i": 325, "text": "time", "start": 131.697, "end": 131.877}, {"i": 326, "text": "walking", "start": 131.937, "end": 132.237}, {"i": 327, "text": "over.", "start": 132.317, "end": 132.537}, {"i": 328, "text": "Thank", "start": 133.417, "end": 133.598}, {"i": 329, "text": "you", "start": 133.638, "end": 133.758}, {"i": 330, "text": "for", "start": 133.778, "end": 133.898}, {"i": 331, "text": "everything.", "start": 133.978, "end": 134.398}, {"i": 332, "text": "You", "start": 135.358, "end": 135.559}, {"i": 333, "text": "are", "start": 135.699, "end": 135.799}, {"i": 334, "text": "welcome,", "start": 135.839, "end": 136.259}, {"i": 335, "text": "Sophie.", "start": 136.319, "end": 136.739}, {"i": 336, "text": "Take", "start": 137.499, "end": 137.68}, {"i": 337, "text": "care", "start": 137.72, "end": 137.94}, {"i": 338, "text": "of", "start": 137.98, "end": 138.04}, {"i": 339, "text": "yourself.", "start": 138.08, "end": 138.5}], "segments": [{"start": 0.13, "end": 1.13, "text": "Hello, Dr. Iverson."}, {"start": 1.631, "end": 2.931, "text": "Thank you for squeezing me in today."}, {"start": 3.932, "end": 4.892, "text": "Not at all, Sophie."}, {"start": 5.092, "end": 5.832, "text": "Come and sit down."}, {"start": 6.533, "end": 7.433, "text": "What is troubling you?"}, {"start": 8.473, "end": 9.054, "text": "My throat."}, {"start": 9.714, "end": 11.835, "text": "It is really sore and it hurts when I swallow."}, {"start": 12.875, "end": 15.396, "text": "A sore throat and pain on swallowing."}, {"start": 15.757, "end": 16.217, "text": "Thank you."}, {"start": 17.357, "end": 19.578, "text": "It has been worrying me a bit, if I am honest."}, {"start": 20.559, "end": 23.16, "text": "Let us have a proper look and we can go from there."}, {"start": 24.0, "end": 24.94, "text": "Yes, please do."}, {"start": 25.941, "end": 28.682, "text": "Your tonsils are red and there is coating on them."}, {"start": 29.578, "end": 29.958, "text": "Coating."}, {"start": 30.719, "end": 31.679, "text": "That sounds unpleasant."}, {"start": 32.54, "end": 33.441, "text": "What is it exactly?"}, {"start": 34.681, "end": 37.904, "text": "It is a whitish layer sitting on the surface of the tonsils."}, {"start": 38.864, "end": 39.505, "text": "And the redness?"}, {"start": 40.245, "end": 41.406, "text": "Is that part of the same thing?"}, {"start": 42.407, "end": 42.707, "text": "Yes."}, {"start": 43.147, "end": 46.269, "text": "The redness and the coating on the tonsils go together here."}, {"start": 47.27, "end": 47.51, "text": "Right."}, {"start": 48.231, "end": 49.191, "text": "So what do you think it is?"}, {"start": 50.352, "end": 52.253, "text": "My assessment is tonsillitis."}, {"start": 53.334, "end": 54.075, "text": "Tonsillitis."}, {"start": 54.795, "end": 56.276, "text": "So an infection of the tonsils."}, {"start": 57.277, "end": 58.778, "text": "That is exactly what it means."}, {"start": 60.414, "end": 60.734, "text": "All right."}, {"start": 61.695, "end": 63.595, "text": "I had convinced myself it was something worse."}, {"start": 64.675, "end": 65.456, "text": "I understand."}, {"start": 65.916, "end": 67.696, "text": "The findings fit tonsillitis."}, {"start": 68.657, "end": 68.917, "text": "Good."}, {"start": 69.657, "end": 70.937, "text": "And what happens about treating it?"}, {"start": 71.957, "end": 74.198, "text": "I am starting you on penicillin treatment."}, {"start": 75.178, "end": 75.779, "text": "Penicillin."}, {"start": 76.379, "end": 77.179, "text": "Starting from today?"}, {"start": 78.299, "end": 79.5, "text": "Yes, from today."}, {"start": 80.5, "end": 81.32, "text": "That is reassuring."}, {"start": 82.14, "end": 83.781, "text": "I like knowing that something is being done."}, {"start": 84.761, "end": 86.262, "text": "Did you have to wait long out there?"}, {"start": 87.202, "end": 87.762, "text": "Not too long."}, {"start": 88.726, "end": 91.127, "text": "Although I did get through most of a magazine in the waiting room."}, {"start": 92.287, "end": 94.809, "text": "They are older than any of us would like to admit."}, {"start": 95.889, "end": 97.129, "text": "I did notice the dates on them."}, {"start": 98.05, "end": 99.651, "text": "Still, it passed the time."}, {"start": 100.671, "end": 101.671, "text": "That is their purpose."}, {"start": 102.532, "end": 104.192, "text": "Is there anything else about your throat?"}, {"start": 105.193, "end": 105.833, "text": "Just one thing."}, {"start": 106.813, "end": 109.034, "text": "The coating you saw, is that what the treatment is for?"}, {"start": 109.054, "end": 111.515, "text": "The treatment is directed at the tonsillitis."}, {"start": 112.236, "end": 114.157, "text": "That is what we are addressing today."}, {"start": 115.057, "end": 115.637, "text": "That is fair."}, {"start": 116.437, "end": 117.498, "text": "I did not want to promise."}, {"start": 118.11, "end": 119.291, "text": "Only a clear idea."}, {"start": 120.171, "end": 120.591, "text": "Of course."}, {"start": 121.492, "end": 125.294, "text": "The queue at the pharmacy next door looked enormous when I walked past."}, {"start": 126.194, "end": 127.615, "text": "It builds up around this hour."}, {"start": 128.355, "end": 130.056, "text": "It usually thins out later on."}, {"start": 130.956, "end": 132.537, "text": "Then I will take my time walking over."}, {"start": 133.417, "end": 134.398, "text": "Thank you for everything."}, {"start": 135.358, "end": 136.739, "text": "You are welcome, Sophie."}, {"start": 137.499, "end": 138.5, "text": "Take care of yourself."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.415}}