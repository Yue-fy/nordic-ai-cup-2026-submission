5.053}, {"i": 524, "text": "Now,", "start": 186.193, "end": 186.393}, {"i": 525, "text": "back", "start": 186.853, "end": 187.073}, {"i": 526, "text": "to", "start": 187.113, "end": 187.214}, {"i": 527, "text": "the", "start": 187.254, "end": 187.334}, {"i": 528, "text": "knee.", "start": 187.354, "end": 187.574}, {"i": 529, "text": "Yes,", "start": 188.214, "end": 188.454}, {"i": 530, "text": "of", "start": 188.754, "end": 188.814}, {"i": 531, "text": "course.", "start": 188.874, "end": 189.174}, {"i": 532, "text": "Sorry,", "start": 189.974, "end": 190.314}, {"i": 533, "text": "I", "start": 190.514, "end": 190.574}, {"i": 534, "text": "do", "start": 190.614, "end": 190.755}, {"i": 535, "text": "wander.", "start": 190.795, "end": 191.155}, {"i": 536, "text": "Not", "start": 191.975, "end": 192.175}, {"i": 537, "text": "at", "start": 192.215, "end": 192.255}, {"i": 538, "text": "all.", "start": 192.355, "end": 192.515}, {"i": 539, "text": "I", "start": 193.315, "end": 193.355}, {"i": 540, "text": "will", "start": 193.375, "end": 193.535}, {"i": 541, "text": "send", "start": 193.555, "end": 193.735}, {"i": 542, "text": "the", "start": 193.775, "end": 193.855}, {"i": 543, "text": "referral", "start": 193.895, "end": 194.356}, {"i": 544, "text": "for", "start": 194.416, "end": 194.556}, {"i": 545, "text": "the", "start": 194.576, "end": 194.676}, {"i": 546, "text": "arthroscopy,", "start": 194.736, "end": 195.536}, {"i": 547, "text": "and", "start": 195.996, "end": 196.076}, {"i": 548, "text": "you", "start": 196.096, "end": 196.176}, {"i": 549, "text": "will", "start": 196.216, "end": 196.356}, {"i": 550, "text": "be", "start": 196.376, "end": 196.456}, {"i": 551, "text": "contacted", "start": 196.516, "end": 197.096}, {"i": 552, "text": "about", "start": 197.136, "end": 197.336}, {"i": 553, "text": "an", "start": 197.376, "end": 197.436}, {"i": 554, "text": "appointment.", "start": 197.476, "end": 198.057}, {"i": 555, "text": "Good.", "start": 198.137, "end": 198.377}, {"i": 556, "text": "So", "start": 199.157, "end": 199.397}, {"i": 557, "text": "I", "start": 199.517, "end": 199.577}, {"i": 558, "text": "wait", "start": 199.637, "end": 199.797}, {"i": 559, "text": "to", "start": 199.837, "end": 199.917}, {"i": 560, "text": "hear", "start": 199.937, "end": 200.097}, {"i": 561, "text": "from", "start": 200.137, "end": 200.277}, {"i": 562, "text": "them", "start": 200.317, "end": 200.477}, {"i": 563, "text": "rather", "start": 200.637, "end": 200.877}, {"i": 564, "text": "than", "start": 200.917, "end": 201.017}, {"i": 565, "text": "chasing", "start": 201.057, "end": 201.377}, {"i": 566, "text": "it", "start": 201.397, "end": 201.457}, {"i": 567, "text": "myself?", "start": 201.497, "end": 201.858}, {"i": 568, "text": "That", "start": 202.618, "end": 202.778}, {"i": 569, "text": "is", "start": 202.838, "end": 202.918}, {"i": 570, "text": "right.", "start": 202.978, "end": 203.178}, {"i": 571, "text": "The", "start": 203.734, "end": 203.834}, {"i": 572, "text": "referral", "start": 203.874, "end": 204.294}, {"i": 573, "text": "goes", "start": 204.334, "end": 204.554}, {"i": 574, "text": "from", "start": 204.594, "end": 204.754}, {"i": 575, "text": "here.", "start": 204.814, "end": 205.034}, {"i": 576, "text": "Understood.", "start": 205.975, "end": 206.415}, {"i": 577, "text": "I", "start": 207.315, "end": 207.375}, {"i": 578, "text": "will", "start": 207.415, "end": 207.575}, {"i": 579, "text": "keep", "start": 207.595, "end": 207.755}, {"i": 580, "text": "an", "start": 207.775, "end": 207.835}, {"i": 581, "text": "eye", "start": 207.875, "end": 207.955}, {"i": 582, "text": "out", "start": 207.995, "end": 208.095}, {"i": 583, "text": "for", "start": 208.135, "end": 208.235}, {"i": 584, "text": "the", "start": 208.255, "end": 208.335}, {"i": 585, "text": "letter", "start": 208.375, "end": 208.576}, {"i": 586, "text": "then.", "start": 208.596, "end": 208.796}, {"i": 587, "text": "It", "start": 209.796, "end": 209.856}, {"i": 588, "text": "is", "start": 209.896, "end": 209.976}, {"i": 589, "text": "good", "start": 210.036, "end": 210.196}, {"i": 590, "text": "to", "start": 210.236, "end": 210.276}, {"i": 591, "text": "have", "start": 210.316, "end": 210.456}, {"i": 592, "text": "a", "start": 210.496, "end": 210.516}, {"i": 593, "text": "plan", "start": 210.576, "end": 210.876}, {"i": 594, "text": "after", "start": 210.936, "end": 211.116}, {"i": 595, "text": "all", "start": 211.156, "end": 211.256}, {"i": 596, "text": "this", "start": 211.296, "end": 211.436}, {"i": 597, "text": "wondering.", "start": 211.476, "end": 211.917}, {"i": 598, "text": "I", "start": 212.997, "end": 213.077}, {"i": 599, "text": "think", "start": 213.117, "end": 213.317}, {"i": 600, "text": "so", "start": 213.357, "end": 213.537}, {"i": 601, "text": "too.", "start": 213.597, "end": 213.817}, {"i": 602, "text": "We", "start": 214.898, "end": 214.998}, {"i": 603, "text": "will", "start": 215.018, "end": 215.178}, {"i": 604, "text": "talk", "start": 215.218, "end": 215.438}, {"i": 605, "text": "again", "start": 215.498, "end": 215.758}, {"i": 606, "text": "once", "start": 215.898, "end": 216.038}, {"i": 607, "text": "you", "start": 216.058, "end": 216.158}, {"i": 608, "text": "have", "start": 216.178, "end": 216.278}, {"i": 609, "text": "been", "start": 216.318, "end": 216.498}, {"i": 610, "text": "seen,", "start": 216.558, "end": 216.858}, {"i": 611, "text": "Louise.", "start": 216.898, "end": 217.278}, {"i": 612, "text": "Thank", "start": 218.479, "end": 218.679}, {"i": 613, "text": "you.", "start": 218.699, "end": 218.879}, {"i": 614, "text": "And", "start": 219.639, "end": 219.779}, {"i": 615, "text": "I", "start": 219.879, "end": 219.919}, {"i": 616, "text": "will", "start": 219.959, "end": 220.099}, {"i": 617, "text": "bring", "start": 220.139, "end": 220.299}, {"i": 618, "text": "you", "start": 220.319, "end": 220.439}, {"i": 619, "text": "a", "start": 220.499, "end": 220.519}, {"i": 620, "text": "loaf", "start": 220.559, "end": 220.819}, {"i": 621, "text": "if", "start": 221.0, "end": 221.06}, {"i": 622, "text": "the", "start": 221.1, "end": 221.18}, {"i": 623, "text": "sourdough", "start": 221.22, "end": 221.64}, {"i": 624, "text": "behaves", "start": 221.66, "end": 221.98}, {"i": 625, "text": "itself.", "start": 222.02, "end": 222.34}], "segments": [{"start": 0.126, "end": 1.406, "text": "Louise, come in."}, {"start": 1.927, "end": 2.747, "text": "Good to see you."}, {"start": 3.487, "end": 6.788, "text": "Last time you were telling me about the sourdough you had just started."}, {"start": 7.448, "end": 8.188, "text": "Did it survive?"}, {"start": 8.748, "end": 9.909, "text": "It did survive, actually."}, {"start": 10.529, "end": 12.67, "text": "It lives in the fridge now and I feed it every Sunday."}, {"start": 13.51, "end": 17.451, "text": "The bread is finally getting a proper crust, so I am quite proud of myself."}, {"start": 18.291, "end": 20.132, "text": "That sounds like real progress."}, {"start": 21.272, "end": 22.752, "text": "So, what brings you in today?"}, {"start": 23.353, "end": 24.173, "text": "It is my knee."}, {"start": 24.933, "end": 28.234, "text": "I keep getting pain behind my right kneecap and it keeps coming back."}, {"start": 29.334, "end": 32.676, "text": "It is not there all the time, which is partly why I put off calling you."}, {"start": 33.356, "end": 34.457, "text": "Tell me more about that."}, {"start": 35.237, "end": 38.539, "text": "When you say it comes back, does it settle in between?"}, {"start": 39.179, "end": 40.08, "text": "Yes, exactly."}, {"start": 40.82, "end": 41.621, "text": "It comes and goes."}, {"start": 42.501, "end": 46.003, "text": "Some days I barely notice it, and then it turns up again behind the kneecap."}, {"start": 47.044, "end": 49.645, "text": "That on and off pattern is what made me want it looked at."}, {"start": 50.206, "end": 50.986, "text": "I understand."}, {"start": 51.967, "end": 54.188, "text": "And it is specifically the right knee?"}, {"start": 54.708, "end": 55.589, "text": "The right one, yes."}, {"start": 56.289, "end": 57.97, "text": "The left has never bothered me at all."}, {"start": 58.806, "end": 62.829, "text": "It is always right behind the kneecap, sort of underneath it, if that makes sense."}, {"start": 63.389, "end": 63.81, "text": "It does."}, {"start": 64.59, "end": 66.552, "text": "Thank you for describing it so clearly."}, {"start": 67.152, "end": 69.193, "text": "I keep wondering whether I did something to it."}, {"start": 70.154, "end": 73.096, "text": "Honestly, I cannot point to a single moment where it started."}, {"start": 73.617, "end": 74.557, "text": "It just crept in."}, {"start": 75.018, "end": 77.439, "text": "That happens more often than people expect."}, {"start": 78.1, "end": 78.34, "text": "Right."}, {"start": 79.1, "end": 80.982, "text": "So what do you think is going on in there?"}, {"start": 81.562, "end": 86.886, "text": "From what you describe, I suspect a condition called chondromalacia patelli."}, {"start": 87.83, "end": 92.452, "text": "That is, softening or wear of the cartilage on the underside of the kneecap."}, {"start": 93.012, "end": 94.153, "text": "Chondromalacia."}, {"start": 94.693, "end": 95.693, "text": "That is a mouthful."}, {"start": 96.694, "end": 98.895, "text": "So the cartilage under the kneecap is the problem?"}, {"start": 99.095, "end": 101.436, "text": "That is the area we are talking about, yes."}, {"start": 102.256, "end": 107.238, "text": "I want to be clear that this is a clinical suspicion at this stage, not something confirmed."}, {"start": 107.899, "end": 109.699, "text": "Okay, so you are not certain yet."}, {"start": 110.52, "end": 111.98, "text": "I appreciate you saying that plainly."}, {"start": 112.781, "end": 115.702, "text": "I would rather know where we stand than be told everything is fine."}, {"start": 116.542, "end": 118.103, "text": "I would rather be straight with you too."}, {"start": 118.824, "end": 121.366, "text": "That is why I do not want to leave it at a suspicion."}, {"start": 122.146, "end": 123.507, "text": "So there is a next step?"}, {"start": 124.348, "end": 124.788, "text": "There is."}, {"start": 125.689, "end": 128.27, "text": "I am going to refer you for an arthroscopy."}, {"start": 128.911, "end": 133.394, "text": "That is a keyhole procedure where a small camera is used to look inside the joint."}, {"start": 134.175, "end": 135.556, "text": "A camera inside the knee."}, {"start": 137.217, "end": 140.779, "text": "Well, that sounds more involved than I expected when I walked in here."}, {"start": 141.84, "end": 144.162, "text": "I know it sounds like a lot the first time you hear it."}, {"start": 145.086, "end": 148.929, "text": "It is the step that lets us actually see the surface behind your kneecap."}, {"start": 149.61, "end": 150.491, "text": "That does make sense."}, {"start": 151.251, "end": 153.553, "text": "I suppose guessing about it forever would be worse."}, {"start": 154.414, "end": 156.275, "text": "And I have been guessing for a while now."}, {"start": 157.276, "end": 157.717, "text": "You have."}, {"start": 158.517, "end": 160.319, "text": "Let us get you a proper look instead."}, {"start": 161.079, "end": 163.021, "text": "Can I ask something completely unrelated?"}, {"start": 163.782, "end": 165.623, "text": "Are those plants on the windowsill yours?"}, {"start": 166.504, "end": 168.546, "text": "They look far healthier than anything I own."}, {"start": 170.127, "end": 170.827, "text": "They are mine."}, {"start": 171.228, "end": 173.67, "text": "And the secret is that I mostly leave them alone."}, {"start": 174.55, "end": 175.69, "text": "That is a relief to hear."}, {"start": 176.471, "end": 178.511, "text": "I keep watering mine into an early grave."}, {"start": 179.511, "end": 182.892, "text": "Maybe benign neglect is the answer for my kitchen windowsill as well."}, {"start": 183.693, "end": 185.053, "text": "It has worked in here so far."}, {"start": 186.193, "end": 187.574, "text": "Now, back to the knee."}, {"start": 188.214, "end": 189.174, "text": "Yes, of course."}, {"start": 189.974, "end": 191.155, "text": "Sorry, I do wander."}, {"start": 191.975, "end": 192.515, "text": "Not at all."}, {"start": 193.315, "end": 198.057, "text": "I will send the referral for the arthroscopy, and you will be contacted about an appointment."}, {"start": 198.137, "end": 198.377, "text": "Good."}, {"start": 199.157, "end": 201.858, "text": "So I wait to hear from them rather than chasing it myself?"}, {"start": 202.618, "end": 203.178, "text": "That is right."}, {"start": 203.734, "end": 205.034, "text": "The referral goes from here."}, {"start": 205.975, "end": 206.415, "text": "Understood."}, {"start": 207.315, "end": 208.796, "text": "I will keep an eye out for the letter then."}, {"start": 209.796, "end": 211.917, "text": "It is good to have a plan after all this wondering."}, {"start": 212.997, "end": 213.817, "text": "I think so too."}, {"start": 214.898, "end": 217.278, "text": "We will talk again once you have been seen, Louise."}, {"start": 218.479, "end": 218.879, "text": "Thank you."}, {"start": 219.639, "end": 222.34, "text": "And I will bring you a loaf if the sourdough behaves itself."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 3.763}}