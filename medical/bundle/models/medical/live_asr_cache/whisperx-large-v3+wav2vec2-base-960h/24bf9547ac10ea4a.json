: 71.893}, {"i": 199, "text": "first", "start": 71.933, "end": 72.173}, {"i": 200, "text": "week", "start": 72.213, "end": 72.394}, {"i": 201, "text": "back", "start": 72.454, "end": 72.694}, {"i": 202, "text": "is", "start": 72.754, "end": 72.834}, {"i": 203, "text": "always", "start": 72.934, "end": 73.194}, {"i": 204, "text": "the", "start": 73.234, "end": 73.334}, {"i": 205, "text": "hardest.", "start": 73.354, "end": 73.755}, {"i": 206, "text": "It", "start": 74.856, "end": 74.916}, {"i": 207, "text": "usually", "start": 75.056, "end": 75.476}, {"i": 208, "text": "is.", "start": 75.596, "end": 75.756}, {"i": 209, "text": "Take", "start": 76.617, "end": 76.817}, {"i": 210, "text": "care,", "start": 76.857, "end": 77.057}, {"i": 211, "text": "Morton.", "start": 77.118, "end": 77.438}, {"i": 212, "text": "Thank", "start": 78.399, "end": 78.599}, {"i": 213, "text": "you,", "start": 78.619, "end": 78.759}, {"i": 214, "text": "Dr.", "start": 78.879, "end": 79.159}, {"i": 215, "text": "Lund.", "start": 79.199, "end": 79.439}, {"i": 216, "text": "Goodbye.", "start": 79.76, "end": 80.12}], "segments": [{"start": 0.054, "end": 0.794, "text": "Good afternoon."}, {"start": 1.175, "end": 2.395, "text": "My name is Dr. Lund."}, {"start": 2.775, "end": 4.276, "text": "Am I speaking with the right person?"}, {"start": 5.017, "end": 5.737, "text": "Yes, hello."}, {"start": 6.277, "end": 7.238, "text": "Morton Overgaard."}, {"start": 7.758, "end": 8.899, "text": "Thank you for getting back to me."}, {"start": 9.699, "end": 10.18, "text": "Not at all."}, {"start": 10.46, "end": 12.781, "text": "You sent a photograph through to us, is that right?"}, {"start": 13.641, "end": 13.962, "text": "I did."}, {"start": 14.822, "end": 17.824, "text": "I have got a new mole on my thigh, and it is quite large."}, {"start": 18.804, "end": 19.845, "text": "Thank you for sending it."}, {"start": 20.205, "end": 22.006, "text": "I have looked at the photograph carefully."}, {"start": 22.927, "end": 23.087, "text": "And?"}, {"start": 24.187, "end": 26.268, "text": "I have been a little worried about it, to be honest."}, {"start": 27.029, "end": 29.09, "text": "From the picture, the change looks harmless."}, {"start": 30.002, "end": 30.462, "text": "Harmless."}, {"start": 31.063, "end": 32.744, "text": "So there is nothing dangerous about it."}, {"start": 33.465, "end": 36.647, "text": "On the basis of that photograph, there is nothing that concerns me."}, {"start": 38.128, "end": 38.848, "text": "That is a relief."}, {"start": 39.769, "end": 41.35, "text": "I had been checking it every evening."}, {"start": 42.171, "end": 43.192, "text": "That is very human."}, {"start": 43.852, "end": 45.533, "text": "Is there anything you would like to ask me?"}, {"start": 46.534, "end": 46.794, "text": "Yes."}, {"start": 47.255, "end": 48.055, "text": "What happens now?"}, {"start": 48.696, "end": 50.057, "text": "Do I need to come in for anything?"}, {"start": 50.937, "end": 51.157, "text": "No."}, {"start": 51.498, "end": 53.519, "text": "There is nothing further needed at this point."}, {"start": 54.5, "end": 55.08, "text": "Nothing at all?"}, {"start": 55.801, "end": 57.322, "text": "So I simply leave it be for now."}, {"start": 58.262, "end": 58.822, "text": "That is right."}, {"start": 59.143, "end": 61.264, "text": "No further steps are necessary at the moment."}, {"start": 62.285, "end": 62.766, "text": "Understood."}, {"start": 63.406, "end": 65.008, "text": "Thank you for looking at it so quickly."}, {"start": 65.608, "end": 67.41, "text": "I only came back from holiday this week."}, {"start": 68.47, "end": 69.651, "text": "Oh, was it a good break?"}, {"start": 70.652, "end": 73.755, "text": "Very good, though the first week back is always the hardest."}, {"start": 74.856, "end": 75.756, "text": "It usually is."}, {"start": 76.617, "end": 77.438, "text": "Take care, Morton."}, {"start": 78.399, "end": 79.439, "text": "Thank you, Dr. Lund."}, {"start": 79.76, "end": 80.12, "text": "Goodbye."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.682}}