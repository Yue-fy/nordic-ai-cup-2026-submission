5}, {"i": 199, "text": "bike", "start": 83.325, "end": 83.546}, {"i": 200, "text": "already.", "start": 83.586, "end": 83.926}, {"i": 201, "text": "Sensible.", "start": 84.827, "end": 85.467}, {"i": 202, "text": "Take", "start": 86.068, "end": 86.308}, {"i": 203, "text": "care,", "start": 86.388, "end": 86.648}, {"i": 204, "text": "Anne.", "start": 86.868, "end": 87.069}, {"i": 205, "text": "Thanks.", "start": 87.829, "end": 88.129}, {"i": 206, "text": "See", "start": 88.37, "end": 88.53}, {"i": 207, "text": "you.", "start": 88.55, "end": 88.69}], "segments": [{"start": 0.182, "end": 1.102, "text": "Good morning, Anne."}, {"start": 1.543, "end": 2.763, "text": "Come in and sit down."}, {"start": 3.363, "end": 4.384, "text": "Morning, Dr. Anderson."}, {"start": 5.204, "end": 7.245, "text": "Did you get the bike serviced in the end?"}, {"start": 8.105, "end": 8.725, "text": "I did, yes."}, {"start": 9.066, "end": 9.866, "text": "Last week, I think."}, {"start": 10.686, "end": 10.986, "text": "Good."}, {"start": 11.647, "end": 12.827, "text": "Does it run better now?"}, {"start": 13.707, "end": 14.588, "text": "Maybe a little better."}, {"start": 14.988, "end": 16.068, "text": "It is hard to tell, really."}, {"start": 16.889, "end": 19.95, "text": "Well, let us look at your diabetes today."}, {"start": 20.73, "end": 23.611, "text": "Has anything new come up since we last met?"}, {"start": 24.632, "end": 26.453, "text": "No, I am not sure there is anything."}, {"start": 26.873, "end": 27.653, "text": "No new symptoms."}, {"start": 28.513, "end": 29.774, "text": "That is useful to know."}, {"start": 30.798, "end": 33.039, "text": "I have your blood results in front of me."}, {"start": 33.88, "end": 34.1, "text": "Right."}, {"start": 34.22, "end": 34.86, "text": "Are they all right?"}, {"start": 35.641, "end": 36.161, "text": "They are."}, {"start": 36.901, "end": 42.024, "text": "Your hemoglobin A1c is 41 millimoles per mole."}, {"start": 42.865, "end": 44.585, "text": "I think that is a low number, is it not?"}, {"start": 45.586, "end": 47.147, "text": "It sits in a good range."}, {"start": 47.927, "end": 52.91, "text": "Your kidney function is normal, and your lipid profile is normal as well."}, {"start": 53.87, "end": 55.151, "text": "Okay, that sounds fine then."}, {"start": 56.132, "end": 56.552, "text": "It is."}, {"start": 57.352, "end": 60.114, "text": "My assessment is good diabetes control"}, {"start": 60.586, "end": 62.207, "text": "With no complications."}, {"start": 63.468, "end": 63.709, "text": "Good."}, {"start": 64.73, "end": 70.134, "text": "So the plan is to continue your current treatment and see you again for the yearly check."}, {"start": 70.955, "end": 71.916, "text": "The same as before then."}, {"start": 72.236, "end": 72.836, "text": "That suits me."}, {"start": 73.857, "end": 76.239, "text": "Anything you would like to ask before you go?"}, {"start": 76.259, "end": 78.942, "text": "The mornings are getting cold now."}, {"start": 80.023, "end": 80.943, "text": "No, I think not."}, {"start": 81.484, "end": 83.926, "text": "And yes, I have started wearing gloves on the bike already."}, {"start": 84.827, "end": 85.467, "text": "Sensible."}, {"start": 86.068, "end": 87.069, "text": "Take care, Anne."}, {"start": 87.829, "end": 88.129, "text": "Thanks."}, {"start": 88.37, "end": 88.69, "text": "See you."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.696}}