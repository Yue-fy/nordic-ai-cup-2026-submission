ext": "Exactly.", "start": 109.247, "end": 109.788}, {"i": 297, "text": "We", "start": 110.088, "end": 110.208}, {"i": 298, "text": "treat", "start": 110.288, "end": 110.528}, {"i": 299, "text": "what", "start": 110.548, "end": 110.668}, {"i": 300, "text": "you", "start": 110.708, "end": 110.828}, {"i": 301, "text": "feel", "start": 110.868, "end": 111.189}, {"i": 302, "text": "and", "start": 111.429, "end": 111.509}, {"i": 303, "text": "we", "start": 111.549, "end": 111.689}, {"i": 304, "text": "keep", "start": 111.749, "end": 111.969}, {"i": 305, "text": "you", "start": 112.009, "end": 112.149}, {"i": 306, "text": "drinking", "start": 112.209, "end": 112.59}, {"i": 307, "text": "enough.", "start": 112.63, "end": 112.91}, {"i": 308, "text": "I", "start": 114.182, "end": 114.242}, {"i": 309, "text": "can", "start": 114.282, "end": 114.402}, {"i": 310, "text": "manage", "start": 114.442, "end": 114.702}, {"i": 311, "text": "that.", "start": 114.743, "end": 114.923}, {"i": 312, "text": "At", "start": 115.663, "end": 115.723}, {"i": 313, "text": "least", "start": 115.743, "end": 115.923}, {"i": 314, "text": "I", "start": 115.963, "end": 116.024}, {"i": 315, "text": "have", "start": 116.044, "end": 116.164}, {"i": 316, "text": "something", "start": 116.204, "end": 116.464}, {"i": 317, "text": "to", "start": 116.484, "end": 116.564}, {"i": 318, "text": "watch", "start": 116.604, "end": 116.844}, {"i": 319, "text": "while", "start": 116.884, "end": 117.024}, {"i": 320, "text": "I", "start": 117.084, "end": 117.124}, {"i": 321, "text": "sit", "start": 117.164, "end": 117.345}, {"i": 322, "text": "still.", "start": 117.385, "end": 117.645}, {"i": 323, "text": "Anything", "start": 118.766, "end": 119.086}, {"i": 324, "text": "worth", "start": 119.126, "end": 119.386}, {"i": 325, "text": "recommending?", "start": 119.426, "end": 120.067}, {"i": 326, "text": "A", "start": 121.128, "end": 121.148}, {"i": 327, "text": "Danish", "start": 121.188, "end": 121.528}, {"i": 328, "text": "crime", "start": 121.568, "end": 121.828}, {"i": 329, "text": "series", "start": 121.868, "end": 122.168}, {"i": 330, "text": "I", "start": 122.228, "end": 122.289}, {"i": 331, "text": "started", "start": 122.329, "end": 122.649}, {"i": 332, "text": "this", "start": 122.689, "end": 122.829}, {"i": 333, "text": "week.", "start": 122.869, "end": 123.089}, {"i": 334, "text": "Slow", "start": 123.67, "end": 123.93}, {"i": 335, "text": "to", "start": 123.97, "end": 124.03}, {"i": 336, "text": "begin", "start": 124.07, "end": 124.33}, {"i": 337, "text": "with,", "start": 124.37, "end": 124.57}, {"i": 338, "text": "but", "start": 124.67, "end": 124.79}, {"i": 339, "text": "by", "start": 124.831, "end": 124.971}, {"i": 340, "text": "the", "start": 125.011, "end": 125.111}, {"i": 341, "text": "third", "start": 125.151, "end": 125.431}, {"i": 342, "text": "episode", "start": 125.471, "end": 125.891}, {"i": 343, "text": "I", "start": 125.991, "end": 126.051}, {"i": 344, "text": "was", "start": 126.071, "end": 126.192}, {"i": 345, "text": "completely", "start": 126.252, "end": 126.912}, {"i": 346, "text": "hooked.", "start": 126.972, "end": 127.272}, {"i": 347, "text": "I", "start": 128.213, "end": 128.253}, {"i": 348, "text": "will", "start": 128.293, "end": 128.433}, {"i": 349, "text": "make", "start": 128.473, "end": 128.654}, {"i": 350, "text": "a", "start": 128.674, "end": 128.714}, {"i": 351, "text": "note", "start": 128.774, "end": 128.994}, {"i": 352, "text": "of", "start": 129.034, "end": 129.074}, {"i": 353, "text": "that", "start": 129.114, "end": 129.274}, {"i": 354, "text": "for", "start": 129.314, "end": 129.434}, {"i": 355, "text": "myself.", "start": 129.474, "end": 129.955}, {"i": 356, "text": "Is", "start": 130.875, "end": 130.935}, {"i": 357, "text": "the", "start": 130.975, "end": 131.075}, {"i": 358, "text": "plan", "start": 131.115, "end": 131.436}, {"i": 359, "text": "clear", "start": 131.516, "end": 131.796}, {"i": 360, "text": "to", "start": 131.836, "end": 131.896}, {"i": 361, "text": "you,", "start": 131.936, "end": 132.096}, {"i": 362, "text": "Signa?", "start": 132.156, "end": 132.537}, {"i": 363, "text": "It", "start": 133.477, "end": 133.557}, {"i": 364, "text": "is", "start": 133.617, "end": 133.698}, {"i": 365, "text": "clear.", "start": 133.738, "end": 133.998}, {"i": 366, "text": "Fluids", "start": 134.658, "end": 135.059}, {"i": 367, "text": "and", "start": 135.219, "end": 135.339}, {"i": 368, "text": "symptom", "start": 135.379, "end": 135.719}, {"i": 369, "text": "relief.", "start": 135.739, "end": 135.999}, {"i": 370, "text": "Thank", "start": 136.4, "end": 136.62}, {"i": 371, "text": "you.", "start": 136.64, "end": 136.78}], "segments": [{"start": 0.134, "end": 1.754, "text": "Cigna, come in and sit down."}, {"start": 2.275, "end": 6.156, "text": "Good to see you, though I would rather it were under better circumstances."}, {"start": 6.876, "end": 7.896, "text": "What is going on?"}, {"start": 8.576, "end": 10.077, "text": "I have been unwell since the weekend."}, {"start": 10.537, "end": 12.157, "text": "It looks like a stomach bug, honestly."}, {"start": 12.797, "end": 14.798, "text": "All the usual gastroenteritis symptoms."}, {"start": 15.378, "end": 17.939, "text": "Tell me a little more about what you have been experiencing."}, {"start": 18.559, "end": 19.859, "text": "It is the classic picture, really."}, {"start": 20.459, "end": 22.4, "text": "Everything you would expect from a stomach infection."}, {"start": 23.02, "end": 25.061, "text": "I have not managed my normal routine at all."}, {"start": 25.741, "end": 26.241, "text": "Thank you."}, {"start": 26.921, "end": 29.882, "text": "I would like to examine your abdomen, if that is alright with you."}, {"start": 30.442, "end": 31.242, "text": "Yes, go ahead."}, {"start": 32.023, "end": 33.863, "text": "I am pressing here and here."}, {"start": 34.743, "end": 37.544, "text": "Does anything hurt more in one particular spot?"}, {"start": 38.285, "end": 39.925, "text": "No, it all feels much the same."}, {"start": 40.645, "end": 40.985, "text": "Good."}, {"start": 41.486, "end": 44.947, "text": "Your abdomen is entirely unremarkable on examination."}, {"start": 45.387, "end": 47.428, "text": "There is nothing abnormal to find."}, {"start": 48.068, "end": 49.568, "text": "How much does that actually tell you?"}, {"start": 50.248, "end": 52.549, "text": "It looks like a fairly simple check from where I am lying."}, {"start": 53.249, "end": 54.97, "text": "It is simple but useful."}, {"start": 55.73, "end": 60.773, "text": "It tells me there is nothing in the abdomen pointing away from a straightforward stomach infection."}, {"start": 61.433, "end": 63.214, "text": "Alright, so what is your conclusion?"}, {"start": 63.935, "end": 68.317, "text": "My assessment is that this is most likely a viral gastroenteritis."}, {"start": 69.057, "end": 71.039, "text": "Most likely, so you are not certain?"}, {"start": 71.699, "end": 73.98, "text": "I will not claim more certainty than I have."}, {"start": 74.58, "end": 81.084, "text": "Your symptoms, together with a normal abdominal examination, fit a viral stomach infection best."}, {"start": 81.864, "end": 84.506, "text": "And if it is viral, I assume there is nothing to prescribe?"}, {"start": 85.15, "end": 85.851, "text": "That is right."}, {"start": 86.491, "end": 91.074, "text": "What I want to give you instead is advice on fluid intake and on treating the symptoms."}, {"start": 91.835, "end": 93.276, "text": "Advice rather than treatment."}, {"start": 93.836, "end": 94.937, "text": "Is that really the whole plan?"}, {"start": 95.177, "end": 96.118, "text": "It is the plan."}, {"start": 96.598, "end": 97.999, "text": "And it is the right one here."}, {"start": 99.0, "end": 102.903, "text": "Keeping your fluids up matters more than anything I could write on a prescription."}, {"start": 104.144, "end": 104.584, "text": "Fair enough."}, {"start": 105.385, "end": 108.487, "text": "And symptom treatment means dealing with the discomfort as it comes."}, {"start": 109.247, "end": 109.788, "text": "Exactly."}, {"start": 110.088, "end": 112.91, "text": "We treat what you feel and we keep you drinking enough."}, {"start": 114.182, "end": 114.923, "text": "I can manage that."}, {"start": 115.663, "end": 117.645, "text": "At least I have something to watch while I sit still."}, {"start": 118.766, "end": 120.067, "text": "Anything worth recommending?"}, {"start": 121.128, "end": 123.089, "text": "A Danish crime series I started this week."}, {"start": 123.67, "end": 127.272, "text": "Slow to begin with, but by the third episode I was completely hooked."}, {"start": 128.213, "end": 129.955, "text": "I will make a note of that for myself."}, {"start": 130.875, "end": 132.537, "text": "Is the plan clear to you, Signa?"}, {"start": 133.477, "end": 133.998, "text": "It is clear."}, {"start": 134.658, "end": 135.999, "text": "Fluids and symptom relief."}, {"start": 136.4, "end": 136.78, "text": "Thank you."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.495}}