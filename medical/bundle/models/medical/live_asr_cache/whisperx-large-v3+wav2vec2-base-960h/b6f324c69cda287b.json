 "treatment,", "start": 113.377, "end": 113.797}, {"i": 298, "text": "same", "start": 113.977, "end": 114.198}, {"i": 299, "text": "annual", "start": 114.258, "end": 114.538}, {"i": 300, "text": "visit.", "start": 114.578, "end": 114.878}, {"i": 301, "text": "That", "start": 115.394, "end": 115.594}, {"i": 302, "text": "I", "start": 115.654, "end": 115.694}, {"i": 303, "text": "can", "start": 115.734, "end": 115.854}, {"i": 304, "text": "manage.", "start": 115.894, "end": 116.254}, {"i": 305, "text": "Are", "start": 117.335, "end": 117.415}, {"i": 306, "text": "you", "start": 117.455, "end": 117.555}, {"i": 307, "text": "off", "start": 117.595, "end": 117.735}, {"i": 308, "text": "anywhere", "start": 117.775, "end": 118.055}, {"i": 309, "text": "for", "start": 118.095, "end": 118.195}, {"i": 310, "text": "the", "start": 118.215, "end": 118.295}, {"i": 311, "text": "long", "start": 118.335, "end": 118.495}, {"i": 312, "text": "weekend?", "start": 118.515, "end": 118.895}, {"i": 313, "text": "Nothing", "start": 119.796, "end": 120.096}, {"i": 314, "text": "exciting.", "start": 120.156, "end": 120.636}, {"i": 315, "text": "Some", "start": 121.176, "end": 121.356}, {"i": 316, "text": "walking", "start": 121.416, "end": 121.837}, {"i": 317, "text": "if", "start": 121.897, "end": 121.957}, {"i": 318, "text": "the", "start": 121.997, "end": 122.077}, {"i": 319, "text": "weather", "start": 122.117, "end": 122.357}, {"i": 320, "text": "cooperates.", "start": 122.397, "end": 123.037}, {"i": 321, "text": "And", "start": 123.677, "end": 123.777}, {"i": 322, "text": "you?", "start": 123.817, "end": 124.037}, {"i": 323, "text": "We", "start": 124.978, "end": 125.158}, {"i": 324, "text": "are", "start": 125.238, "end": 125.318}, {"i": 325, "text": "driving", "start": 125.358, "end": 125.658}, {"i": 326, "text": "to", "start": 125.678, "end": 125.778}, {"i": 327, "text": "the", "start": 125.798, "end": 125.878}, {"i": 328, "text": "coast,", "start": 125.898, "end": 126.238}, {"i": 329, "text": "whether", "start": 126.538, "end": 126.859}, {"i": 330, "text": "or", "start": 126.979, "end": 127.059}, {"i": 331, "text": "no", "start": 127.139, "end": 127.259}, {"i": 332, "text": "weather.", "start": 127.279, "end": 127.579}, {"i": 333, "text": "Thank", "start": 128.499, "end": 128.659}, {"i": 334, "text": "you,", "start": 128.679, "end": 128.779}, {"i": 335, "text": "Dr.", "start": 128.799, "end": 129.019}, {"i": 336, "text": "Thorson.", "start": 129.039, "end": 129.5}, {"i": 337, "text": "See", "start": 129.8, "end": 129.9}, {"i": 338, "text": "you", "start": 129.92, "end": 130.0}, {"i": 339, "text": "next", "start": 130.04, "end": 130.22}, {"i": 340, "text": "year.", "start": 130.26, "end": 130.4}], "segments": [{"start": 0.186, "end": 0.887, "text": "Ida, come in."}, {"start": 1.427, "end": 2.008, "text": "Good to see you."}, {"start": 2.628, "end": 3.609, "text": "Thank you, Dr. Thorson."}, {"start": 4.229, "end": 7.172, "text": "And I hardly waited at all today, which must be a first."}, {"start": 7.993, "end": 10.935, "text": "I sat down, opened a magazine, and then you called my name."}, {"start": 11.816, "end": 13.757, "text": "We are having a rare good morning."}, {"start": 14.538, "end": 15.939, "text": "Do not get used to it."}, {"start": 16.6, "end": 18.661, "text": "I will enjoy it while it lasts, believe me."}, {"start": 19.382, "end": 21.344, "text": "So, this is your diabetes check."}, {"start": 22.144, "end": 22.985, "text": "How have you been feeling?"}, {"start": 23.606, "end": 24.646, "text": "Honestly, fine."}, {"start": 25.387, "end": 26.528, "text": "I have no complaints at all."}, {"start": 27.229, "end": 28.85, "text": "I feel well, really well."}, {"start": 29.77, "end": 33.172, "text": "I keep waiting to find something wrong, but there is nothing I can point to."}, {"start": 33.893, "end": 36.034, "text": "That is exactly what I like to hear."}, {"start": 36.775, "end": 39.677, "text": "No complaints, and feeling well in yourself."}, {"start": 40.477, "end": 41.258, "text": "None whatsoever."}, {"start": 41.958, "end": 43.159, "text": "Nothing to report this time."}, {"start": 43.92, "end": 44.16, "text": "Good."}, {"start": 44.98, "end": 49.463, "text": "Let us go through your results, because they have come back, and they read nicely."}, {"start": 50.064, "end": 50.864, "text": "Yes, please."}, {"start": 51.525, "end": 53.166, "text": "I have been curious about them all week."}, {"start": 53.726, "end": 57.929, "text": "Your hemoglobin A1c is 42 millimoles per mole."}, {"start": 58.489, "end": 59.29, "text": "And that is a good one?"}, {"start": 60.138, "end": 63.16, "text": "I remember you telling me the lower values are the ones we are aiming for."}, {"start": 63.84, "end": 65.321, "text": "That is a good level, yes."}, {"start": 66.002, "end": 67.022, "text": "That is lovely to hear."}, {"start": 67.042, "end": 69.664, "text": "I was worried it might have drifted since last time."}, {"start": 70.364, "end": 74.427, "text": "Your LDL cholesterol is 2.2 millimoles per liter."}, {"start": 75.148, "end": 75.368, "text": "Right."}, {"start": 75.988, "end": 76.749, "text": "And the kidney one?"}, {"start": 77.209, "end": 78.31, "text": "The one you always check for me?"}, {"start": 78.89, "end": 80.571, "text": "Your creatinine is normal."}, {"start": 81.251, "end": 83.473, "text": "Well, that is all three of them behaving themselves."}, {"start": 84.213, "end": 85.234, "text": "I will take that gladly."}, {"start": 85.862, "end": 91.845, "text": "So, my assessment is that your diabetes is stable, and there are no signs of complications."}, {"start": 92.606, "end": 93.626, "text": "No complications."}, {"start": 94.367, "end": 96.728, "text": "That is the sentence I came here hoping for, honestly."}, {"start": 96.748, "end": 98.929, "text": "I do think about it sometimes."}, {"start": 99.309, "end": 100.51, "text": "That is understandable."}, {"start": 101.05, "end": 103.091, "text": "But nothing today points in that direction."}, {"start": 104.272, "end": 104.532, "text": "Good."}, {"start": 105.293, "end": 106.393, "text": "So what happens from here?"}, {"start": 107.334, "end": 111.996, "text": "You continue your current treatment, unchanged, and we carry on with the yearly check."}, {"start": 113.097, "end": 114.878, "text": "Same treatment, same annual visit."}, {"start": 115.394, "end": 116.254, "text": "That I can manage."}, {"start": 117.335, "end": 118.895, "text": "Are you off anywhere for the long weekend?"}, {"start": 119.796, "end": 120.636, "text": "Nothing exciting."}, {"start": 121.176, "end": 123.037, "text": "Some walking if the weather cooperates."}, {"start": 123.677, "end": 124.037, "text": "And you?"}, {"start": 124.978, "end": 127.579, "text": "We are driving to the coast, whether or no weather."}, {"start": 128.499, "end": 129.5, "text": "Thank you, Dr. Thorson."}, {"start": 129.8, "end": 130.4, "text": "See you next year."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.347}}