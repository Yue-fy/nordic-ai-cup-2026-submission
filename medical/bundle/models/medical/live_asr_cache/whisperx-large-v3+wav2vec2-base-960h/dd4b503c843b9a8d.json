4.286}, {"i": 394, "text": "the", "start": 144.326, "end": 144.426}, {"i": 395, "text": "anti-inflammatory", "start": 144.527, "end": 145.647}, {"i": 396, "text": "with", "start": 145.727, "end": 145.867}, {"i": 397, "text": "the", "start": 145.907, "end": 145.987}, {"i": 398, "text": "stomach", "start": 146.047, "end": 146.408}, {"i": 399, "text": "protection", "start": 146.448, "end": 146.988}, {"i": 400, "text": "alongside", "start": 147.108, "end": 147.708}, {"i": 401, "text": "it.", "start": 147.768, "end": 147.868}, {"i": 402, "text": "And", "start": 148.769, "end": 148.849}, {"i": 403, "text": "is", "start": 148.889, "end": 148.949}, {"i": 404, "text": "there", "start": 148.969, "end": 149.089}, {"i": 405, "text": "anything", "start": 149.129, "end": 149.369}, {"i": 406, "text": "I", "start": 149.409, "end": 149.449}, {"i": 407, "text": "need", "start": 149.489, "end": 149.629}, {"i": 408, "text": "to", "start": 149.649, "end": 149.689}, {"i": 409, "text": "come", "start": 149.729, "end": 149.849}, {"i": 410, "text": "back", "start": 149.89, "end": 150.05}, {"i": 411, "text": "for?", "start": 150.11, "end": 150.33}, {"i": 412, "text": "An", "start": 151.29, "end": 151.37}, {"i": 413, "text": "annual", "start": 151.49, "end": 151.811}, {"i": 414, "text": "check", "start": 151.851, "end": 152.131}, {"i": 415, "text": "of", "start": 152.211, "end": 152.271}, {"i": 416, "text": "your", "start": 152.311, "end": 152.431}, {"i": 417, "text": "blood", "start": 152.471, "end": 152.711}, {"i": 418, "text": "pressure.", "start": 152.751, "end": 153.131}, {"i": 419, "text": "Does", "start": 153.952, "end": 154.092}, {"i": 420, "text": "that", "start": 154.132, "end": 154.312}, {"i": 421, "text": "plan", "start": 154.372, "end": 154.732}, {"i": 422, "text": "sit", "start": 154.812, "end": 155.012}, {"i": 423, "text": "right", "start": 155.072, "end": 155.252}, {"i": 424, "text": "with", "start": 155.293, "end": 155.433}, {"i": 425, "text": "you?", "start": 155.473, "end": 155.653}, {"i": 426, "text": "It", "start": 156.613, "end": 156.673}, {"i": 427, "text": "does.", "start": 156.713, "end": 156.973}, {"i": 428, "text": "And", "start": 157.694, "end": 157.794}, {"i": 429, "text": "I", "start": 157.834, "end": 157.874}, {"i": 430, "text": "will", "start": 157.914, "end": 158.134}, {"i": 431, "text": "say,", "start": 158.194, "end": 158.454}, {"i": 432, "text": "that", "start": 158.674, "end": 158.814}, {"i": 433, "text": "check-in", "start": 158.855, "end": 159.195}, {"i": 434, "text": "screen", "start": 159.215, "end": 159.435}, {"i": 435, "text": "at", "start": 159.475, "end": 159.535}, {"i": 436, "text": "reception", "start": 159.575, "end": 160.055}, {"i": 437, "text": "nearly", "start": 160.135, "end": 160.455}, {"i": 438, "text": "defeated", "start": 160.495, "end": 160.836}, {"i": 439, "text": "me", "start": 160.896, "end": 160.976}, {"i": 440, "text": "on", "start": 161.016, "end": 161.076}, {"i": 441, "text": "the", "start": 161.116, "end": 161.176}, {"i": 442, "text": "way", "start": 161.216, "end": 161.356}, {"i": 443, "text": "in.", "start": 161.436, "end": 161.536}, {"i": 444, "text": "You", "start": 162.917, "end": 163.057}, {"i": 445, "text": "are", "start": 163.117, "end": 163.217}, {"i": 446, "text": "not", "start": 163.297, "end": 163.497}, {"i": 447, "text": "the", "start": 163.557, "end": 163.657}, {"i": 448, "text": "first", "start": 163.697, "end": 163.957}, {"i": 449, "text": "to", "start": 164.017, "end": 164.077}, {"i": 450, "text": "tell", "start": 164.137, "end": 164.318}, {"i": 451, "text": "me", "start": 164.358, "end": 164.438}, {"i": 452, "text": "that", "start": 164.478, "end": 164.658}, {"i": 453, "text": "today.", "start": 164.718, "end": 165.038}, {"i": 454, "text": "Well,", "start": 165.898, "end": 166.159}, {"i": 455, "text": "I", "start": 166.219, "end": 166.279}, {"i": 456, "text": "got", "start": 166.319, "end": 166.479}, {"i": 457, "text": "there", "start": 166.499, "end": 166.659}, {"i": 458, "text": "in", "start": 166.699, "end": 166.759}, {"i": 459, "text": "the", "start": 166.799, "end": 166.879}, {"i": 460, "text": "end.", "start": 166.959, "end": 167.119}, {"i": 461, "text": "Thank", "start": 167.639, "end": 167.819}, {"i": 462, "text": "you,", "start": 167.84, "end": 167.96}, {"i": 463, "text": "Dr.", "start": 167.98, "end": 168.24}, {"i": 464, "text": "Villidsen.", "start": 168.26, "end": 168.7}], "segments": [{"start": 0.066, "end": 0.406, "text": "Come in."}, {"start": 0.746, "end": 1.907, "text": "I am Dr. Villidsen."}, {"start": 2.387, "end": 3.928, "text": "We have not met before, I think."}, {"start": 4.748, "end": 5.488, "text": "No, we have not."}, {"start": 5.909, "end": 6.529, "text": "Louise Dahl."}, {"start": 6.729, "end": 7.449, "text": "Lovely to meet you."}, {"start": 8.17, "end": 11.731, "text": "I was just saying to the lady outside that the waiting room went far quicker than I expected."}, {"start": 12.291, "end": 13.352, "text": "That is good to hear."}, {"start": 13.932, "end": 14.512, "text": "Take a seat."}, {"start": 15.013, "end": 20.075, "text": "There is a lot on your list today, so I would like to go through it with you rather than at you."}, {"start": 20.095, "end": 21.636, "text": "I appreciate that."}, {"start": 22.036, "end": 22.936, "text": "Where would you like to start?"}, {"start": 23.356, "end": 25.417, "text": "Probably the back, since that is the oldest of it."}, {"start": 26.037, "end": 26.958, "text": "The back, yes."}, {"start": 27.63, "end": 30.632, "text": "This is the chronic pain since your neck operation."}, {"start": 31.272, "end": 34.594, "text": "That is right, the cervical disc prolapse, operated in 2017."}, {"start": 34.614, "end": 38.096, "text": "And honestly, the pain has just carried on regardless."}, {"start": 38.897, "end": 42.319, "text": "Despite taking the ibumetin and the panadil regularly?"}, {"start": 42.999, "end": 45.0, "text": "Despite both, and I do take them properly."}, {"start": 45.401, "end": 46.521, "text": "That is the frustrating part."}, {"start": 47.142, "end": 49.623, "text": "And then the anti-inflammatory gave me reflux on top."}, {"start": 50.263, "end": 52.965, "text": "Which is why you are on pantoprazole for that."}, {"start": 53.665, "end": 54.446, "text": "Exactly, yes."}, {"start": 55.058, "end": 57.339, "text": "So one thing patching up the other, if you see what I mean."}, {"start": 58.159, "end": 58.579, "text": "I do."}, {"start": 59.199, "end": 62.82, "text": "And your asthma is being followed at the pulmonary outpatient clinic."}, {"start": 63.44, "end": 66.021, "text": "It is, and that side of things is genuinely fine."}, {"start": 66.541, "end": 68.642, "text": "They keep an eye on it, and I have no complaints there."}, {"start": 69.382, "end": 69.642, "text": "Good."}, {"start": 70.302, "end": 73.943, "text": "Then the menopausal symptoms, which you are taking Activel for."}, {"start": 74.604, "end": 77.624, "text": "Yes, and my hands have started aching as well, which is newer."}, {"start": 78.185, "end": 79.565, "text": "I did wonder about arthritis."}, {"start": 80.425, "end": 83.286, "text": "Osteoarthritis is what is suspected there, yes."}, {"start": 84.05, "end": 85.291, "text": "Anything else troubling you?"}, {"start": 85.991, "end": 87.412, "text": "Constipation, I am afraid."}, {"start": 88.012, "end": 89.933, "text": "And I should be honest and say I still smoke."}, {"start": 90.073, "end": 91.254, "text": "Thank you for saying so."}, {"start": 92.074, "end": 95.196, "text": "Let me examine you, and then I will tell you what I find."}, {"start": 95.776, "end": 96.277, "text": "Please do."}, {"start": 97.437, "end": 99.418, "text": "You seem generally unaffected."}, {"start": 100.039, "end": 102.06, "text": "Your gait and standing are normal."}, {"start": 102.84, "end": 105.622, "text": "I can feel muscle tension in your neck and shoulders."}, {"start": 106.482, "end": 109.684, "text": "That tension is exactly where it always sits, right across there."}, {"start": 110.725, "end": 113.186, "text": "So, to summarize, chronic pain,"}, {"start": 113.626, "end": 119.288, "text": "stable asthma, chronic reflux, and you are perimenopausal with a need for treatment."}, {"start": 120.189, "end": 123.07, "text": "And the hands, and the constipation, and the smoking."}, {"start": 124.09, "end": 128.712, "text": "Osteoarthritis, constipation, and nicotine, yes, all noted."}, {"start": 129.512, "end": 133.214, "text": "Now, what would you like to do about the neck and shoulder tension?"}, {"start": 134.114, "end": 136.815, "text": "If you are about to say physiotherapy, I would rather not."}, {"start": 137.576, "end": 139.556, "text": "I have thought about it, and it is not for me."}, {"start": 140.457, "end": 141.777, "text": "Then we will not refer you."}, {"start": 142.558, "end": 143.118, "text": "For the pain,"}, {"start": 143.586, "end": 147.868, "text": "You continue the anti-inflammatory with the stomach protection alongside it."}, {"start": 148.769, "end": 150.33, "text": "And is there anything I need to come back for?"}, {"start": 151.29, "end": 153.131, "text": "An annual check of your blood pressure."}, {"start": 153.952, "end": 155.653, "text": "Does that plan sit right with you?"}, {"start": 156.613, "end": 156.973, "text": "It does."}, {"start": 157.694, "end": 161.536, "text": "And I will say, that check-in screen at reception nearly defeated me on the way in."}, {"start": 162.917, "end": 165.038, "text": "You are not the first to tell me that today."}, {"start": 165.898, "end": 167.119, "text": "Well, I got there in the end."}, {"start": 167.639, "end": 168.7, "text": "Thank you, Dr. Villidsen."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 2.982}}