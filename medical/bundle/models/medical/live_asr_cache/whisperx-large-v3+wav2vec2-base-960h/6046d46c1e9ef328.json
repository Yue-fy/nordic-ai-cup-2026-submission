and", "start": 81.784, "end": 81.884}, {"i": 199, "text": "it", "start": 81.924, "end": 81.964}, {"i": 200, "text": "came", "start": 82.004, "end": 82.185}, {"i": 201, "text": "out", "start": 82.245, "end": 82.365}, {"i": 202, "text": "dense", "start": 82.425, "end": 82.665}, {"i": 203, "text": "enough", "start": 82.705, "end": 82.925}, {"i": 204, "text": "to", "start": 82.965, "end": 83.045}, {"i": 205, "text": "prop", "start": 83.085, "end": 83.305}, {"i": 206, "text": "a", "start": 83.345, "end": 83.385}, {"i": 207, "text": "door", "start": 83.405, "end": 83.626}, {"i": 208, "text": "open.", "start": 83.726, "end": 83.906}, {"i": 209, "text": "they", "start": 85.614, "end": 85.794}, {"i": 210, "text": "improve", "start": 85.855, "end": 86.275}, {"i": 211, "text": "with", "start": 86.315, "end": 86.455}, {"i": 212, "text": "practice.", "start": 86.495, "end": 87.075}, {"i": 213, "text": "So", "start": 88.055, "end": 88.216}, {"i": 214, "text": "I", "start": 88.276, "end": 88.336}, {"i": 215, "text": "am", "start": 88.396, "end": 88.476}, {"i": 216, "text": "told.", "start": 88.516, "end": 88.856}, {"i": 217, "text": "The", "start": 89.576, "end": 89.656}, {"i": 218, "text": "colder", "start": 89.696, "end": 89.996}, {"i": 219, "text": "weather", "start": 90.056, "end": 90.296}, {"i": 220, "text": "makes", "start": 90.336, "end": 90.537}, {"i": 221, "text": "me", "start": 90.577, "end": 90.657}, {"i": 222, "text": "want", "start": 90.697, "end": 90.857}, {"i": 223, "text": "to", "start": 90.877, "end": 90.937}, {"i": 224, "text": "bake", "start": 90.997, "end": 91.177}, {"i": 225, "text": "more", "start": 91.217, "end": 91.417}, {"i": 226, "text": "anyway.", "start": 91.497, "end": 91.897}, {"i": 227, "text": "The", "start": 92.878, "end": 92.978}, {"i": 228, "text": "seasons", "start": 93.018, "end": 93.478}, {"i": 229, "text": "do", "start": 93.538, "end": 93.698}, {"i": 230, "text": "that", "start": 93.738, "end": 93.938}, {"i": 231, "text": "to", "start": 93.978, "end": 94.058}, {"i": 232, "text": "people.", "start": 94.098, "end": 94.458}, {"i": 233, "text": "Take", "start": 95.299, "end": 95.499}, {"i": 234, "text": "care,", "start": 95.539, "end": 95.759}, {"i": 235, "text": "Astrid,", "start": 95.859, "end": 96.279}, {"i": 236, "text": "and", "start": 96.779, "end": 96.859}, {"i": 237, "text": "start", "start": 96.919, "end": 97.179}, {"i": 238, "text": "the", "start": 97.199, "end": 97.32}, {"i": 239, "text": "inhalations.", "start": 97.36, "end": 98.06}], "segments": [{"start": 0.098, "end": 1.279, "text": "Morning, Dr. Averson."}, {"start": 1.759, "end": 3.319, "text": "Thanks for seeing me at short notice."}, {"start": 4.18, "end": 5.32, "text": "Of course, Astrid."}, {"start": 5.82, "end": 6.641, "text": "Come and sit down."}, {"start": 7.581, "end": 8.662, "text": "What is going on?"}, {"start": 9.562, "end": 13.524, "text": "I have a cough that will not shift, and I am a little short of breath."}, {"start": 14.544, "end": 15.084, "text": "Thank you."}, {"start": 15.865, "end": 17.545, "text": "Has there been any fever with it?"}, {"start": 18.486, "end": 19.426, "text": "No fever at all."}, {"start": 20.046, "end": 22.468, "text": "I checked because I rather expected there would be."}, {"start": 23.408, "end": 23.948, "text": "Good to know."}, {"start": 24.909, "end": 28.19, "text": "I have examined you, and there are no signs of pneumonia."}, {"start": 29.142, "end": 30.923, "text": "That is the part I wanted to ask about."}, {"start": 31.563, "end": 32.703, "text": "What are you basing that on?"}, {"start": 33.863, "end": 35.584, "text": "On the examination I have just done."}, {"start": 36.344, "end": 38.245, "text": "Nothing in it suggested pneumonia."}, {"start": 39.125, "end": 39.525, "text": "All right."}, {"start": 40.125, "end": 41.786, "text": "So what do you think it is instead?"}, {"start": 42.686, "end": 44.887, "text": "My assessment is acute bronchitis."}, {"start": 45.887, "end": 47.067, "text": "And how certain is that?"}, {"start": 48.168, "end": 52.589, "text": "It fits your cough, the mild breathlessness, and the absence of fever."}, {"start": 53.629, "end": 54.149, "text": "Fair enough."}, {"start": 54.73, "end": 55.79, "text": "So what is the plan?"}, {"start": 56.946, "end": 59.028, "text": "I would like to start inhalation therapy."}, {"start": 59.668, "end": 60.869, "text": "Does that sit well with you?"}, {"start": 61.83, "end": 62.25, "text": "It does."}, {"start": 63.011, "end": 65.112, "text": "Why inhalation rather than something else?"}, {"start": 66.153, "end": 69.836, "text": "It treats the airways directly, and that is where the trouble is."}, {"start": 70.856, "end": 71.837, "text": "That makes sense to me."}, {"start": 72.477, "end": 73.618, "text": "Thank you for explaining it."}, {"start": 74.639, "end": 75.199, "text": "Anytime."}, {"start": 76.02, "end": 77.881, "text": "Have you been baking anything new lately?"}, {"start": 78.762, "end": 79.663, "text": "I have, actually."}, {"start": 80.323, "end": 83.906, "text": "I tried a rye loaf, and it came out dense enough to prop a door open."}, {"start": 85.614, "end": 87.075, "text": "they improve with practice."}, {"start": 88.055, "end": 88.856, "text": "So I am told."}, {"start": 89.576, "end": 91.897, "text": "The colder weather makes me want to bake more anyway."}, {"start": 92.878, "end": 94.458, "text": "The seasons do that to people."}, {"start": 95.299, "end": 98.06, "text": "Take care, Astrid, and start the inhalations."}], "machine": "gpu59.int.triton.aalto.fi", "git_commit": "735eed3a1a4f5d8bc8a3ac1f1c8897e291443b9f", "date": "2026-09-20", "timing_s": {"transcribe_and_align": 1.822}}